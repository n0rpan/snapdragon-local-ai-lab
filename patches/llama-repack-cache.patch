+// Persistent, file-backed cache of repacked CPU weights. See repack-cache.h and docs/repack-cache.md.
+//
+// One file per repacked tensor: <dir>/<model>-<id>/<tensor>.<keyhash>.rpk
+//   [header page: magic, sizes, payload hash, full key text, header hash][payload: repacked bytes]
+// Warm load: validate the header, then mmap the payload MAP_PRIVATE|MAP_FIXED over the tensor's pages,
+// so the weights are clean file-backed pages instead of anonymous memory.
+
+#include "repack-cache.h"
+
+#include "ggml-backend-impl.h"
+#include "ggml-impl.h"
+#include "ggml-cpu.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <cinttypes>
+#include <cctype>
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#if !defined(_WIN32)
+#define GGML_REPACK_CACHE_SUPPORTED 1
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <time.h>
+#include <unistd.h>
+#if defined(__linux__)
+#include <sys/sysmacros.h>
+#endif
+#endif
+
+static constexpr char     RC_MAGIC[8]       = { 'G', 'G', 'M', 'L', 'R', 'P', 'C', '1' };
+static constexpr uint32_t RC_VERSION        = 1;
+static constexpr size_t   RC_HDR_FIXED      = 56;  // bytes before the key text
+static constexpr size_t   RC_MODEL_HEAD     = 8u << 20;  // bytes of the model file hashed into its identity
+static constexpr int      RC_MAX_LOG_ERRORS = 32;
+
+// ---------------------------------------------------------------------------------------------
+// xxh64
+
+static inline uint64_t rc_rotl(uint64_t x, int r) { return (x << r) | (x >> (64 - r)); }
+static inline uint64_t rc_rd64(const uint8_t * p) { uint64_t v; memcpy(&v, p, 8); return v; }
+static inline uint32_t rc_rd32(const uint8_t * p) { uint32_t v; memcpy(&v, p, 4); return v; }
+
+static constexpr uint64_t P1 = 0x9E3779B185EBCA87ULL, P2 = 0xC2B2AE3D27D4EB4FULL, P3 = 0x165667B19E3779F9ULL,
+                          P4 = 0x85EBCA77C2B2AE63ULL, P5 = 0x27D4EB2F165667C5ULL;
+
+static inline uint64_t rc_round(uint64_t acc, uint64_t in) { acc += in * P2; acc = rc_rotl(acc, 31); return acc * P1; }
+static inline uint64_t rc_merge(uint64_t acc, uint64_t v) { acc ^= rc_round(0, v); return acc * P1 + P4; }
+
+static uint64_t rc_xxh64(const void * data, size_t len, uint64_t seed = 0) {
+    const uint8_t * p   = (const uint8_t *) data;
+    const uint8_t * end = p + len;
+    uint64_t h;
+    if (len >= 32) {
+        uint64_t v1 = seed + P1 + P2, v2 = seed + P2, v3 = seed, v4 = seed - P1;
+        const uint8_t * limit = end - 32;
+        do {
+            v1 = rc_round(v1, rc_rd64(p));      v2 = rc_round(v2, rc_rd64(p + 8));
+            v3 = rc_round(v3, rc_rd64(p + 16)); v4 = rc_round(v4, rc_rd64(p + 24));
+            p += 32;
+        } while (p <= limit);
+        h = rc_rotl(v1, 1) + rc_rotl(v2, 7) + rc_rotl(v3, 12) + rc_rotl(v4, 18);
+        h = rc_merge(h, v1); h = rc_merge(h, v2); h = rc_merge(h, v3); h = rc_merge(h, v4);
+    } else {
+        h = seed + P5;
+    }
+    h += (uint64_t) len;
+    while (p + 8 <= end) { h ^= rc_round(0, rc_rd64(p)); h = rc_rotl(h, 27) * P1 + P4; p += 8; }
+    if (p + 4 <= end)    { h ^= (uint64_t) rc_rd32(p) * P1; h = rc_rotl(h, 23) * P2 + P3; p += 4; }
+    while (p < end)      { h ^= (*p) * P5; h = rc_rotl(h, 11) * P1; p++; }
+    h ^= h >> 33; h *= P2; h ^= h >> 29; h *= P3; h ^= h >> 32;
+    return h;
+}
+
+static std::string rc_hex(uint64_t v) {
+    char buf[17];
+    snprintf(buf, sizeof(buf), "%016" PRIx64, v);
+    return buf;
+}
+
+// ---------------------------------------------------------------------------------------------
+// logging: machine-parseable lines on stderr, "ggml-repack-cache: <LEVEL> <event> key=<hash> path=<path> ..."
+
+static std::atomic<int> rc_n_errors{0};
+
+static void rc_line(const char * level, const char * event, const std::string & key, const std::string & path, const char * fmt, ...) {
+    char extra[512] = "";
+    if (fmt) {
+        va_list ap;
+        va_start(ap, fmt);
+        vsnprintf(extra, sizeof(extra), fmt, ap);
+        va_end(ap);
+    }
+    fprintf(stderr, "ggml-repack-cache: %s %s key=%s path=%s%s%s\n", level, event, key.empty() ? "-" : key.c_str(),
+            path.empty() ? "-" : path.c_str(), extra[0] ? " " : "", extra);
+    fflush(stderr);
+}
+
+#define RC_ERROR(event, key, path, ...)                                                          \
+    do {                                                                                         \
+        const int n_ = rc_n_errors.fetch_add(1);                                                 \
+        if (n_ < RC_MAX_LOG_ERRORS) {                                                            \
+            rc_line("ERROR", event, key, path, __VA_ARGS__);                                     \
+        } else if (n_ == RC_MAX_LOG_ERRORS) {                                                    \
+            rc_line("ERROR", "too-many-errors", "", "", "msg=\"further errors suppressed\"");    \
+        }                                                                                        \
+        GGML_LOG_DEBUG("repack-cache: error %s %s\n", event, path.c_str());                     \
+    } while (0)
+
+// ---------------------------------------------------------------------------------------------
+
+static const char * rc_env_dir() {
+    const char * d = getenv("GGML_CPU_REPACK_CACHE");
+    return (d && d[0]) ? d : nullptr;
+}
+
+bool ggml_repack_cache_enabled(void) {
+#ifdef GGML_REPACK_CACHE_SUPPORTED
+    return rc_env_dir() != nullptr;
+#else
+    return false;
+#endif
+}
+
+#ifndef GGML_REPACK_CACHE_SUPPORTED
+
+size_t ggml_repack_cache_alignment(void) { return 64; }
+ggml_backend_buffer_t ggml_repack_cache_alloc_buffer(size_t) { return nullptr; }
+bool ggml_repack_cache_owns(ggml_backend_buffer_t) { return false; }
+int ggml_repack_cache_set_tensor(ggml_backend_buffer_t, struct ggml_tensor * t, const void * data, size_t size,
+                                 const ggml_repack_cache_traits & traits) {
+    return traits.repack(t, data, size);
+}
+
+#else
+
+static size_t rc_page() {
+    static const size_t p = (size_t) sysconf(_SC_PAGESIZE);
+    return p;
+}
+
+static size_t rc_hdr_size() { return std::max<size_t>(4096, rc_page()); }
+
+static size_t rc_round_up(size_t x, size_t a) { return (x + a - 1) / a * a; }
+
+size_t ggml_repack_cache_alignment(void) { return rc_page(); }
+
+struct rc_buffer_info {
+    std::string dir;
+    void *      base;
+    size_t      len;
+    int         n_hit = 0, n_miss = 0, n_write = 0, n_error = 0;
+};
+
+static std::mutex                                        rc_mutex;
+static std::map<ggml_backend_buffer_t, rc_buffer_info>   rc_buffers;     // guarded by rc_mutex
+static std::map<std::string, std::pair<uint64_t, bool>>  rc_head_hashes; // guarded by rc_mutex
+static std::map<std::string, uint64_t>                   rc_layouts;     // guarded by rc_mutex
+static bool                                              rc_writes_disabled = false;  // guarded by rc_mutex
+static std::atomic<bool>                                 rc_logged_hit{false};
+static std::atomic<uint64_t>                             rc_tmp_counter{0};
+
+static void rc_free_buffer(ggml_backend_buffer_t buffer) {
+    rc_buffer_info info;
+    {
+        std::lock_guard<std::mutex> lock(rc_mutex);
+        auto it = rc_buffers.find(buffer);
+        GGML_ASSERT(it != rc_buffers.end());
+        info = it->second;
+        rc_buffers.erase(it);
+    }
+    if (info.n_hit + info.n_miss + info.n_error > 0) {
+        rc_line("INFO", "summary", "", info.dir, "hits=%d misses=%d written=%d errors=%d", info.n_hit, info.n_miss,
+                info.n_write, info.n_error);
+    }
+    munmap(info.base, info.len);
+}
+
+ggml_backend_buffer_t ggml_repack_cache_alloc_buffer(size_t size) {
+    const char * dir = rc_env_dir();
+    if (!dir) {
+        return nullptr;
+    }
+    const size_t len = rc_round_up(std::max<size_t>(size, 1), rc_page());
+    void * base = mmap(nullptr, len, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (base == MAP_FAILED) {
+        RC_ERROR("alloc-failed", std::string(), std::string(dir), "errno=%d size=%zu", errno, size);
+        return nullptr;
+    }
+    ggml_backend_buffer_t buffer = ggml_backend_cpu_buffer_from_ptr(base, size);
+    if (!buffer) {
+        munmap(base, len);
+        return nullptr;
+    }
+    buffer->iface.free_buffer = rc_free_buffer;
+    std::lock_guard<std::mutex> lock(rc_mutex);
+    rc_buffers[buffer] = rc_buffer_info{ dir, base, len };
+    return buffer;
+}
+
+bool ggml_repack_cache_owns(ggml_backend_buffer_t buffer) {
+    return buffer && buffer->iface.free_buffer == rc_free_buffer;
+}
+
+// ---------------------------------------------------------------------------------------------
+// identity
+
+static std::string rc_cpu_features() {
+    std::string s;
+    auto add = [&](const char * n, int v) { if (v) { s += n; s += ','; } };
+    add("neon", ggml_cpu_has_neon());       add("dotprod", ggml_cpu_has_dotprod());
+    add("i8mm", ggml_cpu_has_matmul_int8()); add("sve", ggml_cpu_has_sve());
+    add("sme", ggml_cpu_has_sme());         add("fp16va", ggml_cpu_has_fp16_va());
+    add("avx", ggml_cpu_has_avx());         add("avx2", ggml_cpu_has_avx2());
+    add("avx512", ggml_cpu_has_avx512());   add("avx512_vnni", ggml_cpu_has_avx512_vnni());
+    add("amx_int8", ggml_cpu_has_amx_int8()); add("riscv_v", ggml_cpu_has_riscv_v());
+    add("vxe", ggml_cpu_has_vxe());
+    s += "sve_cnt=" + std::to_string(ggml_cpu_get_sve_cnt());
+    return s;
+}
+
+// hash of the repack output for a fixed synthetic input: changes whenever the repacked layout changes
+static uint64_t rc_layout_hash(ggml_type type, const ggml_repack_cache_traits & traits) {
+    const std::string mkey = traits.id + "/" + ggml_type_name(type);
+    {
+        std::lock_guard<std::mutex> lock(rc_mutex);
+        auto it = rc_layouts.find(mkey);
+        if (it != rc_layouts.end()) {
+            return it->second;
+        }
+    }
+    ggml_tensor t;
+    memset(&t, 0, sizeof(t));
+    t.type  = type;
+    t.ne[0] = 2048; t.ne[1] = 16; t.ne[2] = 1; t.ne[3] = 1;
+    t.nb[0] = ggml_type_size(type);
+    t.nb[1] = ggml_row_size(type, t.ne[0]);
+    t.nb[2] = t.nb[1] * t.ne[1];
+    t.nb[3] = t.nb[2];
+    snprintf(t.name, sizeof(t.name), "repack-cache-probe");
+    const size_t n = ggml_nbytes(&t);
+    std::vector<uint8_t> src(n), dst(n, 0);
+    uint64_t x = 0x243F6A8885A308D3ULL;
+    for (size_t i = 0; i < n; i++) {
+        x ^= x << 13; x ^= x >> 7; x ^= x << 17;
+        src[i] = (uint8_t) x;
+    }
+    t.data = dst.data();
+    const int rc = traits.repack(&t, src.data(), n);
+    const uint64_t h = rc == 0 ? rc_xxh64(dst.data(), n) : (0xBAD0000000000000ULL | (uint32_t) rc);
+    std::lock_guard<std::mutex> lock(rc_mutex);
+    rc_layouts[mkey] = h;
+    return h;
+}
+
+struct rc_source {
+    bool        file = false;
+    std::string path;
+    uint64_t    dev = 0, ino = 0, size = 0, foff = 0, head = 0;
+    int64_t     mtime_ns = 0;
+};
+
+#if defined(__linux__)
+// find the file mapping that backs [p, p+n) (the llama.cpp loader passes pointers into its GGUF mmap)
+static bool rc_find_source(const void * p, size_t n, rc_source & out) {
+    FILE * f = fopen("/proc/self/maps", "re");
+    if (!f) {
+        return false;
+    }
+    const uintptr_t addr = (uintptr_t) p;
+    char * line = nullptr;
+    size_t cap = 0;
+    bool found = false;
+    while (getline(&line, &cap, f) > 0) {
+        unsigned long start, end, off, inode;
+        unsigned maj, min;
+        char perms[8];
+        int pos = 0;
+        if (sscanf(line, "%lx-%lx %7s %lx %x:%x %lu %n", &start, &end, perms, &off, &maj, &min, &inode, &pos) < 7) {
+            continue;
+        }
+        if (addr < start || addr >= end) {
+            continue;
+        }
+        if (inode == 0 || addr + n > end || pos <= 0) {
+            break;
+        }
+        std::string path = line + pos;
+        while (!path.empty() && (path.back() == '\n' || path.back() == ' ')) {
+            path.pop_back();
+        }
+        if (path.empty() || path[0] != '/' || path.find(" (deleted)") != std::string::npos) {
+            break;
+        }
+        struct stat st;
+        if (stat(path.c_str(), &st) != 0 || (uint64_t) st.st_ino != inode || major(st.st_dev) != maj ||
+            minor(st.st_dev) != min) {
+            break;  // the path no longer names the mapped file
+        }
+        out.file     = true;
+        out.path     = path;
+        out.dev      = (uint64_t) st.st_dev;
+        out.ino      = (uint64_t) st.st_ino;
+        out.size     = (uint64_t) st.st_size;
+        out.mtime_ns = (int64_t) st.st_mtim.tv_sec * 1000000000LL + st.st_mtim.tv_nsec;
+        out.foff     = off + (addr - start);
+        found        = true;
+        break;
+    }
+    free(line);
+    fclose(f);
+    return found;
+}
+#else
+static bool rc_find_source(const void *, size_t, rc_source &) { return false; }
+#endif
+
+// hash of the first RC_MODEL_HEAD bytes (GGUF header, KV metadata, tensor infos), once per file version
+static bool rc_model_head(rc_source & s) {
+    const std::string id = s.path + "|" + std::to_string(s.dev) + ":" + std::to_string(s.ino) + "|" +
+                           std::to_string(s.size) + "|" + std::to_string(s.mtime_ns);
+    {
+        std::lock_guard<std::mutex> lock(rc_mutex);
+        auto it = rc_head_hashes.find(id);
+        if (it != rc_head_hashes.end()) {
+            s.head = it->second.first;
+            return it->second.second;
+        }
+    }
+    bool ok = false;
+    int fd = open(s.path.c_str(), O_RDONLY | O_CLOEXEC);
+    if (fd >= 0) {
+        std::vector<uint8_t> buf((size_t) std::min<uint64_t>(s.size, RC_MODEL_HEAD));
+        size_t got = 0;
+        while (got < buf.size()) {
+            ssize_t r = pread(fd, buf.data() + got, buf.size() - got, (off_t) got);
+            if (r < 0 && errno == EINTR) {
+                continue;
+            }
+            if (r <= 0) {
+                break;
+            }
+            got += (size_t) r;
+        }
+        close(fd);
+        if (got == buf.size()) {
+            s.head = rc_xxh64(buf.data(), buf.size());
+            ok     = true;
+        }
+    }
+    std::lock_guard<std::mutex> lock(rc_mutex);
+    rc_head_hashes[id] = { s.head, ok };
+    return ok;
+}
+
+// cheap fingerprint of the source tensor bytes: 8 x 1 KiB samples (touches a few pages of the GGUF)
+static uint64_t rc_sample_hash(const void * data, size_t n) {
+    const uint8_t * p = (const uint8_t *) data;
+    if (n <= 64 * 1024) {
+        return rc_xxh64(p, n);
+    }
+    uint64_t h = n;
+    for (int i = 0; i < 8; i++) {
+        const size_t off = (size_t) ((uint64_t) (n - 1024) * i / 7);
+        h = rc_xxh64(p + off, 1024, h);
+    }
+    return h;
+}
+
+static std::string rc_sanitize(const std::string & s, size_t max_len) {
+    std::string r;
+    for (char c : s) {
+        if (r.size() >= max_len) {
+            break;
+        }
+        r += (isalnum((unsigned char) c) || c == '.' || c == '-' || c == '_') ? c : '_';
+    }
+    return r.empty() ? std::string("x") : r;
+}
+
+static bool rc_mkdirs(const std::string & path) {
+    std::string cur;
+    size_t i = 0;
+    while (i <= path.size()) {
+        size_t j = path.find('/', i);
+        if (j == std::string::npos) {
+            j = path.size();
+        }
+        cur = path.substr(0, j);
+        if (!cur.empty() && mkdir(cur.c_str(), 0755) != 0 && errno != EEXIST) {
+            return false;
+        }
+        i = j + 1;
+    }
+    struct stat st;
+    return stat(path.c_str(), &st) == 0 && S_ISDIR(st.st_mode);
+}
+
+// ---------------------------------------------------------------------------------------------
+// file I/O
+
+static bool rc_pread_all(int fd, void * dst, size_t n, off_t off) {
+    uint8_t * p = (uint8_t *) dst;
+    while (n > 0) {
+        ssize_t r = pread(fd, p, std::min<size_t>(n, 1u << 30), off);
+        if (r < 0 && errno == EINTR) {
+            continue;
+        }
+        if (r <= 0) {
+            return false;
+        }
+        p += r; n -= (size_t) r; off += r;
+    }
+    return true;
+}
+
+static bool rc_write_all(int fd, const void * src, size_t n) {
+    const uint8_t * p = (const uint8_t *) src;
+    while (n > 0) {
+        ssize_t r = write(fd, p, std::min<size_t>(n, 1u << 30));
+        if (r < 0 && errno == EINTR) {
+            continue;
+        }
+        if (r <= 0) {
+            if (r == 0) {
+                errno = EIO;
+            }
+            return false;
+        }
+        p += r; n -= (size_t) r;
+    }
+    return true;
+}
+
+static std::vector<uint8_t> rc_make_header(const std::string & key, uint64_t payload_size, uint64_t payload_hash) {
+    const size_t hs = rc_hdr_size();
+    std::vector<uint8_t> h(hs, 0);
+    uint32_t u32; uint64_t u64;
+    memcpy(h.data(), RC_MAGIC, 8);
+    u32 = RC_VERSION;           memcpy(h.data() + 8, &u32, 4);
+    u32 = (uint32_t) hs;        memcpy(h.data() + 12, &u32, 4);
+    u64 = payload_size;         memcpy(h.data() + 16, &u64, 8);
+    u64 = payload_hash;         memcpy(h.data() + 24, &u64, 8);
+    u64 = rc_xxh64(key.data(), key.size()); memcpy(h.data() + 32, &u64, 8);
+    struct timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    u64 = (uint64_t) ts.tv_sec * 1000000000ULL + (uint64_t) ts.tv_nsec; memcpy(h.data() + 40, &u64, 8);
+    u32 = (uint32_t) key.size(); memcpy(h.data() + 48, &u32, 4);
+    memcpy(h.data() + RC_HDR_FIXED, key.data(), key.size());
+    u64 = rc_xxh64(h.data(), hs - 8); memcpy(h.data() + hs - 8, &u64, 8);
+    return h;
+}
+
+// returns nullptr when the header is valid for (key, payload_size), else the reason
+static const char * rc_check_header(const std::vector<uint8_t> & h, const std::string & key, uint64_t payload_size,
+                                    uint64_t & payload_hash) {
+    const size_t hs = h.size();
+    uint32_t version, hsize, klen;
+    uint64_t psize, khash, hhash;
+    if (memcmp(h.data(), RC_MAGIC, 8) != 0)                     { return "bad-magic"; }
+    memcpy(&version, h.data() + 8, 4);
+    memcpy(&hsize, h.data() + 12, 4);
+    if (version != RC_VERSION || hsize != hs)                   { return "bad-version"; }
+    memcpy(&hhash, h.data() + hs - 8, 8);
+    if (hhash != rc_xxh64(h.data(), hs - 8))                    { return "corrupt-header"; }
+    memcpy(&psize, h.data() + 16, 8);
+    memcpy(&payload_hash, h.data() + 24, 8);
+    memcpy(&khash, h.data() + 32, 8);
+    memcpy(&klen, h.data() + 48, 4);
+    if (psize != payload_size)                                  { return "size-mismatch"; }
+    if (klen != key.size() || RC_HDR_FIXED + klen > hs - 8 ||
+        memcmp(h.data() + RC_HDR_FIXED, key.data(), klen) != 0) { return "key-mismatch"; }
+    return nullptr;
+}
+
+// replace [addr, addr+len) with a fresh private anonymous mapping
+static void rc_remap_anon(void * addr, size_t len) {
+    void * r = mmap(addr, len, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0);
+    if (r == MAP_FAILED) {
+        GGML_ABORT("repack-cache: failed to restore anonymous memory (errno %d)", errno);
+    }
+}
+
+enum rc_map_result { RC_MAPPED, RC_NOT_ELIGIBLE, RC_MAP_FAILED };
+
+// map the payload of fd over the tensor pages (needs a page-aligned tensor inside a cache buffer).
+// RC_NOT_ELIGIBLE leaves the data untouched; RC_MAP_FAILED leaves zeroed anonymous pages
+static rc_map_result rc_map_over(const rc_buffer_info & bi, ggml_tensor * t, int fd, size_t nbytes) {
+    const uintptr_t a = (uintptr_t) t->data;
+    const size_t    len = rc_round_up(nbytes, rc_page());
+    if (a % rc_page() != 0 || a < (uintptr_t) bi.base || a + len > (uintptr_t) bi.base + bi.len) {
+        return RC_NOT_ELIGIBLE;
+    }
+    void * r = mmap(t->data, len, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_FIXED, fd, (off_t) rc_hdr_size());
+    if (r == MAP_FAILED) {
+        // a failed MAP_FIXED may already have dropped the old pages
+        rc_remap_anon(t->data, len);
+        return RC_MAP_FAILED;
+    }
+    return RC_MAPPED;
+}
+
+static bool rc_env_verify() {
+    const char * v = getenv("GGML_CPU_REPACK_CACHE_VERIFY");
+    return !(v && strcmp(v, "0") == 0);
+}
+
+int ggml_repack_cache_set_tensor(ggml_backend_buffer_t buffer, struct ggml_tensor * t, const void * data, size_t size,
+                                 const ggml_repack_cache_traits & traits) {
+    rc_buffer_info bi;
+    {
+        std::lock_guard<std::mutex> lock(rc_mutex);
+        auto it = rc_buffers.find(buffer);
+        if (it == rc_buffers.end()) {
+            return traits.repack(t, data, size);
+        }
+        bi = it->second;
+    }
+    auto count = [&](int rc_buffer_info::*field) {
+        std::lock_guard<std::mutex> lock(rc_mutex);
+        auto it = rc_buffers.find(buffer);
+        if (it != rc_buffers.end()) {
+            (it->second.*field)++;
+        }
+    };
+    auto do_repack = [&]() {
+        GGML_LOG_DEBUG("repack-cache: repack %s\n", t->name);
+        return traits.repack(t, data, size);
+    };
+
+    const size_t nbytes = ggml_nbytes(t);
+
+    // ---- key
+    rc_source src;
+    const bool have_file = rc_find_source(data, size, src) && rc_model_head(src);
+    std::string key;
+    key += "format=1\n";
+    key += std::string("build=") + ggml_version() + "/" + ggml_commit() + "\n";
+    key += "patch=" GGML_CPU_REPACK_CACHE_PATCH_ID "\n";
+    key += "cpu=" + rc_cpu_features() + "\n";
+    key += "repack=" + traits.id + "\n";
+    key += "layout=" + rc_hex(rc_layout_hash(t->type, traits)) + "\n";
+    key += std::string("tensor=") + t->name + "\n";
+    key += std::string("type=") + ggml_type_name(t->type) + "\n";
+    char buf[256];
+    snprintf(buf, sizeof(buf), "ne=%" PRId64 ",%" PRId64 ",%" PRId64 ",%" PRId64 "\nnb=%zu,%zu,%zu,%zu\nnbytes=%zu\n",
+             t->ne[0], t->ne[1], t->ne[2], t->ne[3], t->nb[0], t->nb[1], t->nb[2], t->nb[3], nbytes);
+    key += buf;
+    std::string model_dir;
+    if (have_file) {
+        snprintf(buf, sizeof(buf),
+                 "src=file\nmodel_dev=%" PRIu64 "\nmodel_ino=%" PRIu64 "\nmodel_size=%" PRIu64 "\nmodel_mtime_ns=%" PRId64
+                 "\nmodel_head=%s\ntensor_offset=%" PRIu64 "\nsrc_sample=%s\n",
+                 src.dev, src.ino, src.size, src.mtime_ns, rc_hex(src.head).c_str(), src.foff,
+                 rc_hex(rc_sample_hash(data, size)).c_str());
+        key += "model=" + src.path + "\n";
+        key += buf;
+        std::string base = src.path.substr(src.path.find_last_of('/') + 1);
+        const std::string ident = src.path + "|" + std::to_string(src.dev) + "|" + std::to_string(src.ino) + "|" +
+                                  std::to_string(src.size) + "|" + std::to_string(src.mtime_ns) + "|" + rc_hex(src.head);
+        model_dir = rc_sanitize(base, 96) + "-" + rc_hex(rc_xxh64(ident.data(), ident.size())).substr(0, 12);
+    } else {
+        // no file identity (e.g. --no-mmap): the key is a hash of the full source bytes, already in memory
+        key += "src=content\nsrc_hash=" + rc_hex(rc_xxh64(data, size)) + "\n";
+        model_dir = "content";
+    }
+
+    const std::string khash = rc_hex(rc_xxh64(key.data(), key.size()));
+    const std::string dir   = bi.dir + "/" + model_dir;
+    const std::string fname = rc_sanitize(t->name, 120) + "." + khash + ".rpk";
+    const std::string path  = dir + "/" + fname;
+
+    if (RC_HDR_FIXED + key.size() + 8 > rc_hdr_size()) {
+        RC_ERROR("key-too-long", khash, path, "len=%zu", key.size());
+        count(&rc_buffer_info::n_error);
+        return do_repack();
+    }
+
+    // ---- warm path
+    int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+    if (fd < 0 && errno != ENOENT) {
+        RC_ERROR("open-failed", khash, path, "errno=%d", errno);
+        count(&rc_buffer_info::n_error);
+    }
+    if (fd >= 0) {
+        const char * reason = nullptr;
+        struct stat st;
+        std::vector<uint8_t> hdr(rc_hdr_size());
+        uint64_t payload_hash = 0;
+        if (fstat(fd, &st) != 0) {
+            reason = "stat-failed";
+        } else if ((uint64_t) st.st_size != rc_hdr_size() + nbytes) {
+            reason = "truncated";
+        } else if (!rc_pread_all(fd, hdr.data(), hdr.size(), 0)) {
+            reason = "read-failed";
+        } else {
+            reason = rc_check_header(hdr, key, nbytes, payload_hash);
+        }
+        bool mapped = false;
+        if (!reason) {
+            const rc_map_result mr = rc_map_over(bi, t, fd, nbytes);
+            mapped = mr == RC_MAPPED;
+            if (mr == RC_MAP_FAILED) {
+                RC_ERROR("mmap-failed", khash, path, "errno=%d tensor=%s", errno, t->name);
+                count(&rc_buffer_info::n_error);
+            }
+            if (!mapped && !rc_pread_all(fd, t->data, nbytes, (off_t) rc_hdr_size())) {
+                reason = "read-failed";
+            }
+        }
+        if (!reason && rc_env_verify() && rc_xxh64(t->data, nbytes) != payload_hash) {
+            reason = "corrupt-payload";
+            if (mapped) {
+                rc_remap_anon(t->data, rc_round_up(nbytes, rc_page()));
+            }
+        }
+        if (!reason) {
+            futimens(fd, nullptr);  // last use, for tools/repack_cache.py
+            close(fd);
+            count(&rc_buffer_info::n_hit);
+            if (!rc_logged_hit.exchange(true)) {
+                rc_line("INFO", "hit", khash, path, "msg=\"serving repacked weights from cache\"");
+            }
+            GGML_LOG_DEBUG("repack-cache: hit %s %s\n", t->name, mapped ? "mmap" : "read");
+            return 0;
+        }
+        close(fd);
+        RC_ERROR(reason, khash, path, "tensor=%s", t->name);
+        count(&rc_buffer_info::n_error);
+        // fall through: repack and rewrite (atomic rename replaces the bad file)
+    } else {
+        rc_line("INFO", "miss", khash, path, "tensor=%s", t->name);
+        GGML_LOG_DEBUG("repack-cache: miss %s\n", t->name);
+    }
+    count(&rc_buffer_info::n_miss);
+
+    // ---- cold path: repack in memory, then store
+    const int rc = do_repack();
+    if (rc != 0) {
+        return rc;
+    }
+    {
+        std::lock_guard<std::mutex> lock(rc_mutex);
+        if (rc_writes_disabled) {
+            return 0;
+        }
+    }
+    if (!rc_mkdirs(dir)) {
+        RC_ERROR("mkdir-failed", khash, dir, "errno=%d", errno);
+        count(&rc_buffer_info::n_error);
+        return 0;
+    }
+    const std::string tmp = dir + "/." + fname + ".tmp." + std::to_string((long) getpid()) + "." +
+                            std::to_string(rc_tmp_counter.fetch_add(1));
+    int wfd = open(tmp.c_str(), O_RDWR | O_CREAT | O_EXCL | O_CLOEXEC, 0644);
+    if (wfd < 0) {
+        RC_ERROR("create-failed", khash, tmp, "errno=%d", errno);
+        count(&rc_buffer_info::n_error);
+        return 0;
+    }
+    const std::vector<uint8_t> hdr = rc_make_header(key, nbytes, rc_xxh64(t->data, nbytes));
+    const bool ok = rc_write_all(wfd, hdr.data(), hdr.size()) && rc_write_all(wfd, t->data, nbytes) && fsync(wfd) == 0;
+    if (!ok) {
+        const int err = errno;
+        close(wfd);
+        unlink(tmp.c_str());
+        RC_ERROR(err == ENOSPC ? "disk-full" : "write-failed", khash, path, "errno=%d", err);
+        count(&rc_buffer_info::n_error);
+        if (err == ENOSPC || err == EDQUOT) {
+            std::lock_guard<std::mutex> lock(rc_mutex);
+            rc_writes_disabled = true;  // stop writing for this process; loading continues in memory
+        }
+        return 0;
+    }
+    if (rename(tmp.c_str(), path.c_str()) != 0) {
+        const int err = errno;
+        close(wfd);
+        unlink(tmp.c_str());
+        RC_ERROR("rename-failed", khash, path, "errno=%d", err);
+        count(&rc_buffer_info::n_error);
+        return 0;
+    }
+    int dfd = open(dir.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (dfd >= 0) {
+        fsync(dfd);
+        close(dfd);
+    }
+    // the bytes just written are now in the page cache: swap the anonymous copy for a file mapping of
+    // our own inode (independent of any concurrent writer replacing the name)
+    if (rc_map_over(bi, t, wfd, nbytes) == RC_MAP_FAILED) {
+        RC_ERROR("mmap-failed", khash, path, "errno=%d tensor=%s", errno, t->name);
+        count(&rc_buffer_info::n_error);
+        if (!rc_pread_all(wfd, t->data, nbytes, (off_t) rc_hdr_size())) {
+            close(wfd);
+            return do_repack();
+        }
+    }
+    close(wfd);
+    count(&rc_buffer_info::n_write);
+    GGML_LOG_DEBUG("repack-cache: write %s\n", t->name);
+    return 0;
+}
+
+#endif // GGML_REPACK_CACHE_SUPPORTED
