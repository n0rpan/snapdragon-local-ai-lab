diff --git a/tests/test-repack-cache.cpp b/tests/test-repack-cache.cpp
new file mode 100644
index 0000000..2c79bfa
--- /dev/null
+++ b/tests/test-repack-cache.cpp
@@ -0,0 +1,395 @@
+// Tests for the persistent repack cache (GGML_CPU_REPACK_CACHE), see docs/repack-cache.md.
+// Single-threaded, synthetic tensors, a few seconds.
+
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <random>
+#include <string>
+#include <vector>
+
+#if defined(_WIN32)
+int main() { printf("repack cache not supported on Windows, skipping\n"); return 0; }
+#else
+
+#include <dirent.h>
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+static std::mutex               g_log_mutex;
+static std::vector<std::string> g_log;
+
+static void log_cb(ggml_log_level level, const char * text, void *) {
+    std::lock_guard<std::mutex> lock(g_log_mutex);
+    if (strncmp(text, "repack-cache:", 13) == 0) {
+        g_log.emplace_back(text);
+    }
+    (void) level;
+}
+
+static int count_log(const char * prefix) {
+    std::lock_guard<std::mutex> lock(g_log_mutex);
+    int n = 0;
+    for (const auto & s : g_log) {
+        if (s.rfind(prefix, 0) == 0) {
+            n++;
+        }
+    }
+    return n;
+}
+
+static void clear_log() {
+    std::lock_guard<std::mutex> lock(g_log_mutex);
+    g_log.clear();
+}
+
+static int g_failures = 0;
+#define CHECK(cond, ...)                                     \
+    do {                                                     \
+        if (!(cond)) {                                       \
+            fprintf(stderr, "FAIL %s:%d: ", __FILE__, __LINE__); \
+            fprintf(stderr, __VA_ARGS__);                    \
+            fprintf(stderr, "\n");                           \
+            g_failures++;                                    \
+        }                                                    \
+    } while (0)
+
+static ggml_backend_buffer_type_t g_repack_buft = nullptr;
+static ggml_backend_t             g_cpu         = nullptr;
+
+static const int64_t K = 512, N = 32, NE2 = 2, M = 5;
+
+struct load_result {
+    bool                 repacked = false;  // the type has a repack on this CPU
+    std::vector<uint8_t> bytes;             // repacked weight bytes
+    std::vector<float>   out;               // mul_mat output
+    bool                 file_backed = false;
+    bool                 page_aligned = false;
+};
+
+static bool addr_is_mapped_from(const void * p, const char * suffix) {
+    FILE * f = fopen("/proc/self/maps", "r");
+    if (!f) {
+        return false;
+    }
+    char line[4096];
+    bool ok = false;
+    while (fgets(line, sizeof(line), f)) {
+        unsigned long s, e;
+        if (sscanf(line, "%lx-%lx", &s, &e) == 2 && (uintptr_t) p >= s && (uintptr_t) p < e) {
+            ok = strstr(line, suffix) != nullptr;
+            break;
+        }
+    }
+    fclose(f);
+    return ok;
+}
+
+// load one weight [K, N, NE2] of `type` from `src` into the repack buffer type and run a mul_mat_id-free
+// 2-D mul_mat on expert 0 view plus a full byte dump. cache_dir == nullptr -> cache disabled
+static load_result load(ggml_type type, const char * name, const void * src, const char * cache_dir) {
+    if (cache_dir) {
+        setenv("GGML_CPU_REPACK_CACHE", cache_dir, 1);
+    } else {
+        unsetenv("GGML_CPU_REPACK_CACHE");
+    }
+    load_result r;
+    ggml_init_params ip = { 4 * ggml_tensor_overhead(), nullptr, true };
+    ggml_context * wctx = ggml_init(ip);
+    ggml_tensor * w = ggml_new_tensor_2d(wctx, type, K, N * NE2);
+    ggml_set_name(w, name);
+    ggml_backend_buffer_t wbuf = ggml_backend_alloc_ctx_tensors_from_buft(wctx, g_repack_buft);
+    if (!wbuf || w->extra == nullptr) {
+        if (wbuf) ggml_backend_buffer_free(wbuf);
+        ggml_free(wctx);
+        return r;
+    }
+    r.repacked = true;
+    r.page_aligned = ((uintptr_t) w->data % (uintptr_t) sysconf(_SC_PAGESIZE)) == 0;
+    ggml_backend_tensor_set(w, src, 0, ggml_nbytes(w));
+    r.bytes.assign((const uint8_t *) w->data, (const uint8_t *) w->data + ggml_nbytes(w));
+    r.file_backed = addr_is_mapped_from(w->data, ".rpk");
+
+    // y = w * x
+    ggml_context * cctx = ggml_init({ 16 * ggml_tensor_overhead() + ggml_graph_overhead(), nullptr, true });
+    ggml_tensor * x = ggml_new_tensor_2d(cctx, GGML_TYPE_F32, K, M);
+    ggml_tensor * y = ggml_mul_mat(cctx, w, x);
+    ggml_cgraph * gf = ggml_new_graph(cctx);
+    ggml_build_forward_expand(gf, y);
+    ggml_backend_buffer_t cbuf = ggml_backend_alloc_ctx_tensors(cctx, g_cpu);
+    std::vector<float> xs(K * M);
+    std::mt19937 rng(7);
+    std::uniform_real_distribution<float> d(-1.f, 1.f);
+    for (auto & v : xs) v = d(rng);
+    ggml_backend_tensor_set(x, xs.data(), 0, ggml_nbytes(x));
+    ggml_backend_graph_compute(g_cpu, gf);
+    r.out.resize(ggml_nelements(y));
+    ggml_backend_tensor_get(y, r.out.data(), 0, ggml_nbytes(y));
+
+    ggml_backend_buffer_free(cbuf);
+    ggml_free(cctx);
+    ggml_backend_buffer_free(wbuf);
+    ggml_free(wctx);
+    return r;
+}
+
+static std::vector<uint8_t> make_source(ggml_type type, uint32_t seed) {
+    std::vector<float> f(K * N * NE2);
+    std::mt19937 rng(seed);
+    std::normal_distribution<float> d(0.f, 1.f);
+    for (auto & v : f) v = d(rng);
+    std::vector<uint8_t> q(ggml_row_size(type, K) * N * NE2);
+    ggml_quantize_chunk(type, f.data(), q.data(), 0, N * NE2, K, nullptr);
+    return q;
+}
+
+// write bytes to a file and mmap it read-only, like the llama.cpp GGUF loader does
+struct mapped_file {
+    std::string path;
+    void *      addr = nullptr;
+    size_t      size = 0;
+    size_t      offs = 4096;  // pretend there is a header in front of the tensor data
+    mapped_file(const std::string & p, const std::vector<uint8_t> & data) : path(p) {
+        size = offs + data.size();
+        std::vector<uint8_t> all(size, 0x5a);
+        memcpy(all.data() + offs, data.data(), data.size());
+        FILE * f = fopen(p.c_str(), "wb");
+        fwrite(all.data(), 1, all.size(), f);
+        fclose(f);
+        remap();
+    }
+    void remap() {
+        if (addr) munmap(addr, size);
+        int fd = open(path.c_str(), O_RDONLY);
+        addr = mmap(nullptr, size, PROT_READ, MAP_SHARED, fd, 0);
+        close(fd);
+    }
+    const void * data() const { return (const uint8_t *) addr + offs; }
+    ~mapped_file() { if (addr) munmap(addr, size); }
+};
+
+static std::vector<std::string> list_files(const std::string & dir, const char * suffix) {
+    std::vector<std::string> out;
+    DIR * d = opendir(dir.c_str());
+    if (!d) return out;
+    while (dirent * e = readdir(d)) {
+        std::string n = e->d_name;
+        if (n == "." || n == "..") continue;
+        std::string full = dir + "/" + n;
+        struct stat st;
+        if (stat(full.c_str(), &st) == 0 && S_ISDIR(st.st_mode)) {
+            for (auto & s : list_files(full, suffix)) out.push_back(s);
+        } else if (suffix == nullptr || (n.size() >= strlen(suffix) && n.compare(n.size() - strlen(suffix), std::string::npos, suffix) == 0) ||
+                   strstr(n.c_str(), suffix)) {
+            out.push_back(full);
+        }
+    }
+    closedir(d);
+    return out;
+}
+
+static void flip_byte(const std::string & path, long off) {
+    FILE * f = fopen(path.c_str(), "r+b");
+    fseek(f, off, off < 0 ? SEEK_END : SEEK_SET);
+    int c = fgetc(f);
+    fseek(f, -1, SEEK_CUR);
+    fputc(c ^ 0x01, f);
+    fclose(f);
+}
+
+static long file_size(const std::string & path) {
+    struct stat st;
+    return stat(path.c_str(), &st) == 0 ? (long) st.st_size : -1;
+}
+
+static bool same(const load_result & a, const load_result & b) {
+    return a.bytes == b.bytes && a.out.size() == b.out.size() &&
+           memcmp(a.out.data(), b.out.data(), a.out.size() * sizeof(float)) == 0;
+}
+
+int main(int argc, char ** argv) {
+    std::string root = argc > 1 ? argv[1] : (std::string("/tmp/test-repack-cache-") + std::to_string(getpid()));
+    mkdir(root.c_str(), 0755);
+    ggml_log_set(log_cb, nullptr);
+
+    g_cpu = ggml_backend_cpu_init();
+    ggml_backend_cpu_set_n_threads(g_cpu, 1);
+    ggml_backend_dev_t dev = ggml_backend_get_device(g_cpu);
+    auto get_extra = (ggml_backend_dev_get_extra_bufts_t) ggml_backend_reg_get_proc_address(
+        ggml_backend_dev_backend_reg(dev), "ggml_backend_dev_get_extra_bufts");
+    for (ggml_backend_buffer_type_t * b = get_extra ? get_extra(dev) : nullptr; b && *b; b++) {
+        if (strcmp(ggml_backend_buft_name(*b), "CPU_REPACK") == 0) g_repack_buft = *b;
+    }
+    if (!g_repack_buft) {
+        printf("no CPU_REPACK buffer type, skipping\n");
+        return 0;
+    }
+
+    const ggml_type types[] = { GGML_TYPE_Q4_0, GGML_TYPE_Q4_K, GGML_TYPE_Q5_K, GGML_TYPE_Q6_K, GGML_TYPE_Q3_K,
+                                GGML_TYPE_Q2_K, GGML_TYPE_IQ4_NL, GGML_TYPE_MXFP4, GGML_TYPE_Q8_0, GGML_TYPE_Q1_0 };
+    int n_tested = 0;
+    for (ggml_type type : types) {
+        const std::string tn = ggml_type_name(type);
+        const std::string dir = root + "/" + tn;
+        const std::vector<uint8_t> src = make_source(type, 1);
+        mapped_file mf(root + "/model-" + tn + ".gguf", src);
+
+        const load_result ref = load(type, "blk.0.ffn_down_exps.weight", mf.data(), nullptr);
+        if (!ref.repacked) {
+            printf("%-7s not repacked on this CPU, skipped\n", tn.c_str());
+            continue;
+        }
+        n_tested++;
+
+        // cold: repack + write, result identical, tensor ends up file-backed
+        clear_log();
+        load_result cold = load(type, "blk.0.ffn_down_exps.weight", mf.data(), dir.c_str());
+        CHECK(same(ref, cold), "%s: cold differs from no-cache", tn.c_str());
+        CHECK(cold.page_aligned, "%s: cache buffer tensor not page aligned", tn.c_str());
+        CHECK(count_log("repack-cache: miss") == 1 && count_log("repack-cache: repack") == 1 &&
+              count_log("repack-cache: write") == 1, "%s: cold path counters", tn.c_str());
+        CHECK(cold.file_backed, "%s: cold tensor not file-backed after write", tn.c_str());
+        auto files = list_files(dir, ".rpk");
+        CHECK(files.size() == 1, "%s: expected 1 cache file, got %zu", tn.c_str(), files.size());
+        if (files.size() != 1) continue;
+        const std::string cf = files[0];
+        CHECK(list_files(dir, ".tmp.").empty(), "%s: temp file left", tn.c_str());
+
+        // warm: no repack, identical, file-backed
+        clear_log();
+        load_result warm = load(type, "blk.0.ffn_down_exps.weight", mf.data(), dir.c_str());
+        CHECK(same(ref, warm), "%s: warm differs from no-cache", tn.c_str());
+        CHECK(count_log("repack-cache: hit") == 1 && count_log("repack-cache: repack") == 0,
+              "%s: warm load did not skip the repack", tn.c_str());
+        CHECK(warm.file_backed, "%s: warm tensor not file-backed", tn.c_str());
+
+        // corrupt payload byte -> detected by the payload hash, repack fallback, file rewritten
+        flip_byte(cf, -100);
+        clear_log();
+        load_result bad = load(type, "blk.0.ffn_down_exps.weight", mf.data(), dir.c_str());
+        CHECK(same(ref, bad), "%s: corrupt-payload fallback differs", tn.c_str());
+        CHECK(count_log("repack-cache: error corrupt-payload") == 1 && count_log("repack-cache: repack") == 1,
+              "%s: corrupt payload not detected", tn.c_str());
+        clear_log();
+        load_result again = load(type, "blk.0.ffn_down_exps.weight", mf.data(), dir.c_str());
+        CHECK(same(ref, again) && count_log("repack-cache: hit") == 1, "%s: not rewritten after corruption", tn.c_str());
+
+        // corrupt header byte (inside the key text)
+        flip_byte(cf, 100);
+        clear_log();
+        bad = load(type, "blk.0.ffn_down_exps.weight", mf.data(), dir.c_str());
+        CHECK(same(ref, bad) && count_log("repack-cache: error corrupt-header") == 1, "%s: corrupt header not detected", tn.c_str());
+
+        // truncated file
+        CHECK(truncate(cf.c_str(), file_size(cf) - 1) == 0, "truncate");
+        clear_log();
+        bad = load(type, "blk.0.ffn_down_exps.weight", mf.data(), dir.c_str());
+        CHECK(same(ref, bad) && count_log("repack-cache: error truncated") == 1, "%s: truncation not detected", tn.c_str());
+    }
+    CHECK(n_tested > 0, "no repacked type on this CPU");
+
+    // the remaining checks use the first repacked type
+    ggml_type type = GGML_TYPE_COUNT;
+    for (ggml_type t : types) {
+        std::vector<uint8_t> s = make_source(t, 1);
+        if (load(t, "probe", s.data(), nullptr).repacked) { type = t; break; }
+    }
+    if (type != GGML_TYPE_COUNT) {
+        const std::string tn = ggml_type_name(type);
+        const std::string dir = root + "/misc";
+        const std::vector<uint8_t> src_a = make_source(type, 11), src_b = make_source(type, 12);
+
+        // model file changes (new content + mtime) -> new key, never the stale entry
+        {
+            mapped_file mf(root + "/model-misc.gguf", src_a);
+            load(type, "blk.1.ffn_up.weight", mf.data(), dir.c_str());
+            mapped_file mf2(root + "/model-misc.gguf", src_b);  // rewrite the same path
+            struct timespec ts[2] = { { 0, UTIME_NOW }, { 1000, 0 } };
+            utimensat(AT_FDCWD, mf2.path.c_str(), ts, 0);
+            mf2.remap();
+            clear_log();
+            load_result r = load(type, "blk.1.ffn_up.weight", mf2.data(), dir.c_str());
+            const load_result ref_b = load(type, "blk.1.ffn_up.weight", src_b.data(), nullptr);
+            CHECK(same(ref_b, r) && count_log("repack-cache: miss") == 1, "model change must miss");
+        }
+
+        // key mismatch: a valid file with another key placed under this key's name
+        {
+            const std::string kdir = root + "/keymismatch";
+            load(type, "blk.2.a.weight", src_a.data(), kdir.c_str());  // content-keyed (heap source)
+            auto fa = list_files(kdir, ".rpk");
+            load(type, "blk.2.b.weight", src_b.data(), kdir.c_str());
+            auto fb = list_files(kdir, ".rpk");
+            std::string pa = fa.size() == 1 ? fa[0] : "", pb;
+            for (auto & f : fb) if (f != pa) pb = f;
+            CHECK(!pa.empty() && !pb.empty(), "keymismatch setup");
+            if (!pa.empty() && !pb.empty()) {
+                CHECK(rename(pa.c_str(), pb.c_str()) == 0, "rename");
+                clear_log();
+                load_result r = load(type, "blk.2.b.weight", src_b.data(), kdir.c_str());
+                const load_result ref_b = load(type, "blk.2.b.weight", src_b.data(), nullptr);
+                CHECK(same(ref_b, r) && count_log("repack-cache: error key-mismatch") == 1, "key mismatch not detected");
+            }
+        }
+
+        // concurrent cold writers: 4 processes race on an empty dir; all correct, no temp files left
+        {
+            const std::string cdir = root + "/concurrent";
+            mapped_file mf(root + "/model-conc.gguf", src_a);
+            const load_result ref = load(type, "blk.3.ffn_gate.weight", mf.data(), nullptr);
+            int pfd[2];
+            CHECK(pipe(pfd) == 0, "pipe");
+            std::vector<pid_t> kids;
+            for (int i = 0; i < 4; i++) {
+                pid_t pid = fork();
+                if (pid == 0) {
+                    close(pfd[1]);
+                    char c;
+                    (void) !read(pfd[0], &c, 1);  // start together
+                    load_result r = load(type, "blk.3.ffn_gate.weight", mf.data(), cdir.c_str());
+                    _exit(same(ref, r) ? 0 : 1);
+                }
+                kids.push_back(pid);
+            }
+            close(pfd[0]);
+            close(pfd[1]);  // EOF releases all children at once
+            for (pid_t pid : kids) {
+                int st = 0;
+                waitpid(pid, &st, 0);
+                CHECK(WIFEXITED(st) && WEXITSTATUS(st) == 0, "concurrent writer %d failed", (int) pid);
+            }
+            CHECK(list_files(cdir, ".rpk").size() == 1, "concurrent: expected one cache file");
+            CHECK(list_files(cdir, ".tmp.").empty(), "concurrent: temp files left");
+            clear_log();
+            load_result r = load(type, "blk.3.ffn_gate.weight", mf.data(), cdir.c_str());
+            CHECK(same(ref, r) && count_log("repack-cache: hit") == 1, "concurrent: warm load after race");
+        }
+
+        // unwritable cache dir -> error line, load still correct
+        {
+            const std::string ro = root + "/readonly";
+            mkdir(ro.c_str(), 0555);
+            clear_log();
+            load_result r = load(type, "blk.4.w.weight", src_a.data(), ro.c_str());
+            const load_result ref = load(type, "blk.4.w.weight", src_a.data(), nullptr);
+            CHECK(same(ref, r), "readonly dir: wrong data");
+            if (geteuid() != 0) {
+                CHECK(count_log("repack-cache: error") >= 1, "readonly dir: no error reported");
+            }
+        }
+    }
+
+    ggml_backend_free(g_cpu);
+    printf("%d repacked types tested, %s\n", n_tested, g_failures ? "FAILED" : "OK");
+    return g_failures ? 1 : 0;
+}
+#endif
diff --git a/tools/repack_cache.py b/tools/repack_cache.py
new file mode 100644
index 0000000..09a0de2
--- /dev/null
+++ b/tools/repack_cache.py
@@ -0,0 +1,281 @@
+#!/usr/bin/env python3
+"""Inspect and prune the ggml-cpu persistent repack cache (GGML_CPU_REPACK_CACHE).
+
+  repack_cache.py list  [--dir D] [--json]
+  repack_cache.py prune [--dir D] [--older-than DAYS] [--build B] [--patch P] [--keep-latest] [--dry-run]
+  repack_cache.py clear [--dir D] [--yes]
+
+Each cache file (<dir>/<model>-<id>/<tensor>.<keyhash>.rpk) starts with a header page holding the full
+cache key as text (model path/identity, build, patch, cpu features, repack layout, tensor shape).
+"last use" is the file mtime, which ggml touches on every warm hit. See docs/repack-cache.md.
+"""
+
+import argparse
+import json
+import os
+import struct
+import sys
+import time
+
+MAGIC = b"GGMLRPC1"
+HDR_FIXED = 56
+TMP_MAX_AGE = 3600  # seconds before a leftover temp file counts as abandoned
+
+M64 = (1 << 64) - 1
+P1, P2, P3, P4, P5 = (0x9E3779B185EBCA87, 0xC2B2AE3D27D4EB4F, 0x165667B19E3779F9,
+                      0x85EBCA77C2B2AE63, 0x27D4EB2F165667C5)
+
+
+def _rotl(x, r):
+    return ((x << r) | (x >> (64 - r))) & M64
+
+
+def _round(acc, v):
+    acc = (acc + v * P2) & M64
+    return (_rotl(acc, 31) * P1) & M64
+
+
+def _merge(acc, v):
+    acc ^= _round(0, v)
+    return (acc * P1 + P4) & M64
+
+
+def xxh64(data, seed=0):
+    n = len(data)
+    p = 0
+    if n >= 32:
+        v1, v2, v3, v4 = (seed + P1 + P2) & M64, (seed + P2) & M64, seed, (seed - P1) & M64
+        while p + 32 <= n:
+            a, b, c, d = struct.unpack_from("<4Q", data, p)
+            v1, v2, v3, v4 = _round(v1, a), _round(v2, b), _round(v3, c), _round(v4, d)
+            p += 32
+        h = (_rotl(v1, 1) + _rotl(v2, 7) + _rotl(v3, 12) + _rotl(v4, 18)) & M64
+        for v in (v1, v2, v3, v4):
+            h = _merge(h, v)
+    else:
+        h = (seed + P5) & M64
+    h = (h + n) & M64
+    while p + 8 <= n:
+        h ^= _round(0, struct.unpack_from("<Q", data, p)[0])
+        h = (_rotl(h, 27) * P1 + P4) & M64
+        p += 8
+    if p + 4 <= n:
+        h ^= (struct.unpack_from("<I", data, p)[0] * P1) & M64
+        h = (_rotl(h, 23) * P2 + P3) & M64
+        p += 4
+    while p < n:
+        h ^= (data[p] * P5) & M64
+        h = (_rotl(h, 11) * P1) & M64
+        p += 1
+    h ^= h >> 33
+    h = (h * P2) & M64
+    h ^= h >> 29
+    h = (h * P3) & M64
+    h ^= h >> 32
+    return h
+
+
+def read_entry(path):
+    e = {"path": path, "status": "ok", "key": {}}
+    try:
+        st = os.stat(path)
+        e["file_size"] = st.st_size
+        e["last_use"] = st.st_mtime
+        with open(path, "rb") as f:
+            head = f.read(HDR_FIXED)
+            if len(head) < HDR_FIXED or head[:8] != MAGIC:
+                e["status"] = "corrupt"
+                return e
+            version, hsize, psize, _phash, _khash, created, klen = struct.unpack_from("<IIQQQQI", head, 8)
+            f.seek(0)
+            hdr = f.read(hsize)
+        if version != 1 or len(hdr) != hsize or HDR_FIXED + klen > hsize - 8:
+            e["status"] = "corrupt"
+            return e
+        if struct.unpack_from("<Q", hdr, hsize - 8)[0] != xxh64(hdr[:hsize - 8]):
+            e["status"] = "corrupt"
+            return e
+        if st.st_size != hsize + psize:
+            e["status"] = "truncated"
+        e["payload_size"] = psize
+        e["created"] = created / 1e9
+        for line in hdr[HDR_FIXED:HDR_FIXED + klen].decode("utf-8", "replace").splitlines():
+            k, _, v = line.partition("=")
+            e["key"][k] = v
+    except OSError as ex:
+        e["status"] = f"io-error: {ex}"
+        return e
+    if e["status"] == "ok":
+        e["status"] = model_status(e["key"])
+    return e
+
+
+def model_status(key):
+    if key.get("src") != "file":
+        return "ok"
+    model = key.get("model", "")
+    try:
+        st = os.stat(model)
+    except OSError:
+        return "stale-model-missing"
+    mtime_ns = st.st_mtime_ns
+    if (str(st.st_size) != key.get("model_size") or str(mtime_ns) != key.get("model_mtime_ns")
+            or str(st.st_ino) != key.get("model_ino")):
+        return "stale-model-changed"
+    return "ok"
+
+
+def scan(root):
+    entries, tmps = [], []
+    for dirpath, _dirs, files in os.walk(root):
+        for n in files:
+            p = os.path.join(dirpath, n)
+            if n.endswith(".rpk"):
+                entries.append(read_entry(p))
+            elif ".rpk.tmp." in n:
+                tmps.append(p)
+    return entries, tmps
+
+
+def human(n):
+    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
+        if n < 1024 or unit == "TiB":
+            return f"{n:.1f} {unit}" if unit != "B" else f"{n} B"
+        n /= 1024
+
+
+def fmt_time(t):
+    return time.strftime("%Y-%m-%d %H:%M", time.localtime(t)) if t else "-"
+
+
+def cmd_list(args):
+    entries, tmps = scan(args.dir)
+    if args.json:
+        json.dump({"entries": entries, "temp_files": tmps}, sys.stdout, indent=1, default=str)
+        print()
+        return 0
+    groups = {}
+    for e in entries:
+        k = e["key"]
+        g = (k.get("model", "(content-keyed)"), k.get("build", "?"), k.get("patch", "?"))
+        groups.setdefault(g, []).append(e)
+    total = 0
+    for (model, build, patch), es in sorted(groups.items()):
+        size = sum(e.get("file_size", 0) for e in es)
+        total += size
+        status = {}
+        for e in es:
+            status[e["status"]] = status.get(e["status"], 0) + 1
+        print(f"model: {model}")
+        print(f"  build: {build}  patch: {patch}")
+        print(f"  tensors: {len(es)}  size: {human(size)}  last use: {fmt_time(max(e.get('last_use', 0) for e in es))}"
+              f"  status: {', '.join(f'{k}={v}' for k, v in sorted(status.items()))}")
+        if args.verbose:
+            for e in sorted(es, key=lambda e: e["key"].get("tensor", "")):
+                k = e["key"]
+                print(f"    {k.get('tensor', '?'):48s} {k.get('type', '?'):7s} {k.get('repack', '?'):22s} "
+                      f"{human(e.get('file_size', 0)):>10s}  {fmt_time(e.get('last_use'))}  {e['status']}")
+    print(f"total: {len(entries)} entries, {human(total)}, {len(tmps)} temp files, dir {args.dir}")
+    return 0
+
+
+def remove(path, dry, why):
+    print(f"{'would remove' if dry else 'remove'} {path} ({why})")
+    if not dry:
+        try:
+            os.unlink(path)
+        except OSError as ex:
+            print(f"  failed: {ex}", file=sys.stderr)
+
+
+def remove_empty_dirs(root, dry):
+    if dry:
+        return
+    for dirpath, _dirs, _files in os.walk(root, topdown=False):
+        if dirpath != root:
+            try:
+                os.rmdir(dirpath)
+            except OSError:
+                pass
+
+
+def cmd_prune(args):
+    entries, tmps = scan(args.dir)
+    now = time.time()
+    doomed = {}
+    for e in entries:
+        k = e["key"]
+        if e["status"] != "ok":
+            doomed[e["path"]] = e["status"]
+        elif args.build and k.get("build") != args.build:
+            doomed[e["path"]] = "other-build"
+        elif args.patch and k.get("patch") != args.patch:
+            doomed[e["path"]] = "other-patch"
+        elif args.older_than is not None and now - e.get("last_use", now) > args.older_than * 86400:
+            doomed[e["path"]] = "unused"
+    if args.keep_latest:
+        latest = {}
+        for e in entries:
+            if e["path"] in doomed:
+                continue
+            g = (os.path.dirname(e["path"]), e["key"].get("tensor"))
+            if g not in latest or e.get("last_use", 0) > latest[g].get("last_use", 0):
+                latest[g] = e
+        keep = {e["path"] for e in latest.values()}
+        for e in entries:
+            if e["path"] not in doomed and e["path"] not in keep:
+                doomed[e["path"]] = "superseded"
+    freed = 0
+    for e in entries:
+        if e["path"] in doomed:
+            freed += e.get("file_size", 0)
+            remove(e["path"], args.dry_run, doomed[e["path"]])
+    for t in tmps:
+        try:
+            if now - os.stat(t).st_mtime > TMP_MAX_AGE:
+                freed += os.stat(t).st_size
+                remove(t, args.dry_run, "abandoned-temp")
+        except OSError:
+            pass
+    remove_empty_dirs(args.dir, args.dry_run)
+    print(f"{'would free' if args.dry_run else 'freed'} {human(freed)}")
+    return 0
+
+
+def cmd_clear(args):
+    if not args.yes:
+        print(f"refusing to clear {args.dir} without --yes", file=sys.stderr)
+        return 1
+    entries, tmps = scan(args.dir)
+    for p in [e["path"] for e in entries] + tmps:
+        remove(p, False, "clear")
+    remove_empty_dirs(args.dir, False)
+    return 0
+
+
+def main():
+    default_dir = os.environ.get("GGML_CPU_REPACK_CACHE") or os.path.expanduser("~/.cache/local-ai/repack")
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    p = sub.add_parser("list")
+    p.add_argument("--json", action="store_true")
+    p.add_argument("-v", "--verbose", action="store_true", help="one line per tensor")
+    p = sub.add_parser("prune")
+    p.add_argument("--older-than", type=float, metavar="DAYS", help="remove entries not used for DAYS")
+    p.add_argument("--build", help="remove entries whose build differs (e.g. '0.29.0/954de24')")
+    p.add_argument("--patch", help="remove entries whose patch identity differs")
+    p.add_argument("--keep-latest", action="store_true", help="per model and tensor keep only the most recently used entry")
+    p.add_argument("--dry-run", action="store_true")
+    p = sub.add_parser("clear")
+    p.add_argument("--yes", action="store_true")
+    for sp in sub.choices.values():
+        sp.add_argument("--dir", default=default_dir)
+    args = ap.parse_args()
+    if not os.path.isdir(args.dir):
+        print(f"no cache directory {args.dir}", file=sys.stderr)
+        return 0 if args.cmd != "clear" else 1
+    return {"list": cmd_list, "prune": cmd_prune, "clear": cmd_clear}[args.cmd](args)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
-- 
