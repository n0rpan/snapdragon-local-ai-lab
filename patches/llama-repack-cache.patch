+// ---------------------------------------------------------------------------------------------
+// GGML_CPU_REPACK_DROP_SOURCE: release the source pages of a repacked tensor
+
+bool ggml_repack_drop_source_enabled(void) {
+    const char * v = getenv("GGML_CPU_REPACK_DROP_SOURCE");
+    return v && strcmp(v, "1") == 0;
+}
+
+void ggml_repack_drop_source(const char * name, const void * data, size_t size) {
+#if defined(__linux__)
+    // inward page alignment: partial pages at both ends may hold neighbouring tensors (or the GGUF header)
+    const uintptr_t start = rc_round_up((uintptr_t) data, rc_page());
+    const uintptr_t end   = ((uintptr_t) data + size) / rc_page() * rc_page();
+    if (start >= end) {
+        return;
+    }
+    rc_source src;
+    if (!rc_find_source(data, size, src)) {
+        GGML_LOG_DEBUG("repack-cache: drop-source skipped %s (not file-backed)\n", name);
+        return;
+    }
+    const size_t len = end - start;
+    // clean file pages: unmapping them only costs a re-read; never touch a writable private mapping
+    if (!src.writable || src.shared) {
+        madvise((void *) start, len, MADV_DONTNEED);
+    }
+    int fd = open(src.path.c_str(), O_RDONLY | O_CLOEXEC);
+    if (fd >= 0) {
+        posix_fadvise(fd, (off_t) (src.foff + (start - (uintptr_t) data)), (off_t) len, POSIX_FADV_DONTNEED);
+        close(fd);
+    }
+    GGML_LOG_DEBUG("repack-cache: drop-source %s %zu\n", name, len);
+#else
+    GGML_UNUSED(name); GGML_UNUSED(data); GGML_UNUSED(size);
+#endif
+}
