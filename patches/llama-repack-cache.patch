+#pragma once
+
+// Persistent, file-backed cache of repacked CPU weights (opt-in).
+//
+// GGML_CPU_REPACK_CACHE=<dir> enables it. Unset (or empty) keeps the exact
+// behaviour of the plain CPU_REPACK buffer type. See docs/repack-cache.md.
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <string>
+
+#ifndef GGML_CPU_REPACK_CACHE_PATCH_ID
+// bump when the repacked byte layout or the cache format changes in a way the
+// layout probe (see repack-cache.cpp) could not detect
+#define GGML_CPU_REPACK_CACHE_PATCH_ID "q3k-repack-1c148ab+mmid-gemm-0a3a679+repack-cache-v1"
+#endif
+
+using ggml_repack_cache_fn = std::function<int(struct ggml_tensor *, const void *, size_t)>;
+
+struct ggml_repack_cache_traits {
+    std::string          id;     // repack layout id, e.g. "blk110:i8:c8:q8_K"
+    ggml_repack_cache_fn repack; // the in-memory repack (writes t->data)
+};
+
+// true when GGML_CPU_REPACK_CACHE names a directory (read on every call)
+bool   ggml_repack_cache_enabled(void);
+// tensor alignment the repack buffer type uses while the cache is enabled (page size)
+size_t ggml_repack_cache_alignment(void);
+// page-aligned anonymous mmap buffer whose tensors can be replaced by file mappings; nullptr on failure
+ggml_backend_buffer_t ggml_repack_cache_alloc_buffer(size_t size);
+// true when the buffer was created by ggml_repack_cache_alloc_buffer
+bool   ggml_repack_cache_owns(ggml_backend_buffer_t buffer);
+// fill tensor from the cache, or repack and store; always leaves correctly repacked data in the tensor.
+// returns the repack status (0 = ok), like tensor_traits_base::repack
+int    ggml_repack_cache_set_tensor(ggml_backend_buffer_t buffer, struct ggml_tensor * tensor,
+                                    const void * data, size_t size, const ggml_repack_cache_traits & traits);
