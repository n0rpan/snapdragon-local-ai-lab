From ee6b9a1caf38138cafcfa3d6104f93d8a32db19a Mon Sep 17 00:00:00 2001
From: Oscar Nordstrom <13300531+n0rpan@users.noreply.github.com>
Date: Mon, 9 Nov 2026 18:47:40 +0100
Subject: [PATCH 2/2] ggml-cpu: make the Q4_K/Q5_K MUL_MAT_ID gemm bitwise
 identical to gemv

With GGML_CPU_MOE_GEMM=1, MoE experts in Q4_K/Q5_K 8x8 used the MUL_MAT
i8mm gemm (ggml_gemm_q{4,5}_K_8x8_q8_K). That kernel sums each 256-value
super-block in int32 and rounds once, while the dotprod gemv (used for
the 1-3 row remainder, for decode, and by GGML_CPU_MOE_GEMM=0) does one
fused multiply-add per 32-value sub-block. The results differ by ~1e-7
relative per output. On Ornith-1.5-35B-A3B APEX Compact (10 Q4_K expert
layers) this rounding was the only difference between GGML_CPU_MOE_GEMM
=exact (KLD 0) and =1 (mean KLD 0.0217, 92.7% top-1 vs the gemv
reference over 4096 tokens). The activation interleave, bsums layout, routed-row gather,
column chunking and threading were checked and are correct: at the op
level, with real Ornith Q4_K expert weights, 61/256 tokens and 1/4/8/10
threads, gemm=1 matched the vec_dot reference to <= 3.2e-6 of the row
max, the same as gemm=0.

Add ggml_gemm_q{4,5}_K_8x8_q8_K_gemv_order (AArch64 NEON with i8mm and
dotprod): the same vmmlaq integer work as the MUL_MAT gemm, but the
float accumulation follows the gemv exactly (per super-block d*d8 and
dmin*d8; per sub-block pair fma(lo) then fma(hi); the mins are
subtracted once per super-block for Q4_K and once per sub-block pair for
Q5_K). Integer sums are exact, so each of the 4 rows is bitwise equal to
the gemv on that row. forward_mul_mat_id uses them through gemm_mmid;
MUL_MAT is unchanged. Q4_K 8x8 and Q5_K 8x8 join the "exact" list.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cpu/arch/arm/repack.cpp | 205 ++++++++++++++++++++++++++
 ggml/src/ggml-cpu/repack.cpp          |  36 ++++-
 ggml/src/ggml-cpu/repack.h            |   3 +
 3 files changed, 240 insertions(+), 4 deletions(-)

diff --git a/ggml/src/ggml-cpu/arch/arm/repack.cpp b/ggml/src/ggml-cpu/arch/arm/repack.cpp
index 6b5b024..561f1db 100644
--- a/ggml/src/ggml-cpu/arch/arm/repack.cpp
+++ b/ggml/src/ggml-cpu/arch/arm/repack.cpp
@@ -4919,6 +4919,211 @@ void ggml_gemm_q5_K_8x8_q8_K(int                        n,
     ggml_gemm_q5_K_8x8_q8_K_generic(n, s, bs, vx, vy, nr, nc);
 }
 
+// MUL_MAT_ID gemm for Q4_K / Q5_K 8x8 (used by forward_mul_mat_id in repack.cpp, never by MUL_MAT).
+//
+// Same i8mm integer work as ggml_gemm_q{4,5}_K_8x8_q8_K, but the float accumulation is done in exactly the order of
+// ggml_gemv_q{4,5}_K_8x8_q8_K: per super-block sb_scale = d * d8 and sb_min = dmin * d8 (one rounding each); per
+// 64-value sub-block pair fma(sb_scale, float(scale_lo * sum_lo)) then fma(sb_scale, float(scale_hi * sum_hi)); the
+// min correction is subtracted once per super-block (Q4_K) or once per sub-block pair (Q5_K). The integer sums are
+// exact in both kernels, so every row of the result is bitwise identical to running the gemv on that row alone.
+// (ggml_gemm_q{4,5}_K_8x8_q8_K accumulate the whole super-block in int32 and round once, which differs from the gemv
+// by ~1e-7 relative.)
+#if defined(__aarch64__) && defined(__ARM_NEON) && defined(__ARM_FEATURE_MATMUL_INT8) && defined(__ARM_FEATURE_DOTPROD)
+template <typename BLOCK, bool IS_Q5>
+static void ggml_gemm_qK_8x8_q8_K_gemv_order(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx,
+                                            const void * GGML_RESTRICT vy, int nr, int nc) {
+    const int        nb   = n / QK_K;
+    const uint8x16_t m4b  = vdupq_n_u8(0x0f);
+    const uint8x16_t mone = vdupq_n_u8(1);
+    const uint8x16_t mtwo = vdupq_n_u8(2);
+
+    for (int y = 0; y < nr / 4; y++) {
+        const block_q8_Kx4 * GGML_RESTRICT q8_ptr = (const block_q8_Kx4 *) vy + (y * nb);
+
+        for (int x = 0; x < nc / 8; x++) {
+            const BLOCK * GGML_RESTRICT q_ptr = (const BLOCK *) vx + (x * nb);
+
+            float32x4_t acc_f32[4][2];  // [row][cols 0..3, 4..7]
+            for (int r = 0; r < 4; r++) {
+                acc_f32[r][0] = vdupq_n_f32(0);
+                acc_f32[r][1] = vdupq_n_f32(0);
+            }
+
+            for (int b = 0; b < nb; b++) {
+                const float32x4_t q_d[2]    = { vcvt_f32_f16(vld1_f16((const __fp16 *) q_ptr[b].d)),
+                                                vcvt_f32_f16(vld1_f16((const __fp16 *) q_ptr[b].d + 4)) };
+                const float32x4_t q_dmin[2] = { vcvt_f32_f16(vld1_f16((const __fp16 *) q_ptr[b].dmin)),
+                                                vcvt_f32_f16(vld1_f16((const __fp16 *) q_ptr[b].dmin + 4)) };
+                float32x4_t sb_scale[4][2];
+                float32x4_t sb_min[4][2];
+                for (int r = 0; r < 4; r++) {
+                    const float32x4_t q8_d = vdupq_n_f32(q8_ptr[b].d[r]);
+                    for (int j = 0; j < 2; j++) {
+                        sb_scale[r][j] = vmulq_f32(q_d[j], q8_d);
+                        sb_min[r][j]   = vmulq_f32(q_dmin[j], q8_d);
+                    }
+                }
+
+                // bsums_arr[sb][2 * r + {0,1}]: sums of the low / high 32 values of sub-block pair sb of row r
+                int16_t bsums_arr[4][8];
+                for (int sb = 0; sb < 4; sb++) {
+                    vst1q_s16(bsums_arr[sb], vpaddq_s16(vld1q_s16(q8_ptr[b].bsums + 16 * sb),
+                                                        vld1q_s16(q8_ptr[b].bsums + 16 * sb + 8)));
+                }
+
+                int32x4_t bias_acc[4][2];  // Q4_K: per super-block, [row][cols 0..3, 4..7]
+                for (int r = 0; r < 4; r++) {
+                    bias_acc[r][0] = vdupq_n_s32(0);
+                    bias_acc[r][1] = vdupq_n_s32(0);
+                }
+
+                uint8x16_t qh[4][4];
+                if constexpr (IS_Q5) {
+                    for (int cp = 0; cp < 4; cp++) {
+                        for (int k = 0; k < 4; k++) {
+                            qh[cp][k] = vld1q_u8(q_ptr[b].qh + 16 * cp + 64 * k);
+                        }
+                    }
+                }
+
+                for (int sb = 0; sb < QK_K / 64; sb++) {
+                    int8_t    sb_scales[2][8];
+                    int16x8_t sb_mins[2];
+                    for (int i = 0; i < 2; i++) {
+                        decode_q_Kx8_6bit_scales(&q_ptr[b].scales[sb * 24 + i * 12], &sb_mins[i], sb_scales[i]);
+                    }
+
+                    // q8 rows interleaved 8 bytes at a time: [r0 r1] in the first 16 bytes, [r2 r3] in the next 16
+                    const int8_t * q8_base = q8_ptr[b].qs + sb * 256;
+                    int8x16_t      q8s[2][8];
+                    for (int i = 0; i < 8; i++) {
+                        q8s[0][i] = vld1q_s8(q8_base + i * 32);
+                        q8s[1][i] = vld1q_s8(q8_base + i * 32 + 16);
+                    }
+
+                    // scaled integer sums, layout [c0r0 c0r1 c1r0 c1r1] for cols (2cp, 2cp+1), rows (2rp, 2rp+1)
+                    int32x4_t lo[2][4];
+                    int32x4_t hi[2][4];
+                    for (int cp = 0; cp < 4; cp++) {
+                        int8x16_t q_lo[4];
+                        int8x16_t q_hi[4];
+                        for (int k = 0; k < 4; k++) {
+                            const uint8x16_t qs = vld1q_u8(q_ptr[b].qs + sb * QK_K + 16 * cp + 64 * k);
+                            if constexpr (IS_Q5) {
+                                const uint8x16_t hbit_lo = vandq_u8(qh[cp][k], mone);
+                                const uint8x16_t hbit_hi = vshlq_n_u8(vandq_u8(qh[cp][k], mtwo), 3);
+                                qh[cp][k]                = vshrq_n_u8(qh[cp][k], 2);
+                                q_lo[k] = vreinterpretq_s8_u8(vsliq_n_u8(vandq_u8(qs, m4b), hbit_lo, 4));
+                                q_hi[k] = vreinterpretq_s8_u8(vorrq_u8(vshrq_n_u8(qs, 4), hbit_hi));
+                            } else {
+                                q_lo[k] = vreinterpretq_s8_u8(vandq_u8(qs, m4b));
+                                q_hi[k] = vreinterpretq_s8_u8(vshrq_n_u8(qs, 4));
+                            }
+                        }
+                        const int32x4_t scale_lo = vcombine_s32(vdup_n_s32(sb_scales[0][2 * cp]), vdup_n_s32(sb_scales[0][2 * cp + 1]));
+                        const int32x4_t scale_hi = vcombine_s32(vdup_n_s32(sb_scales[1][2 * cp]), vdup_n_s32(sb_scales[1][2 * cp + 1]));
+                        for (int rp = 0; rp < 2; rp++) {
+                            int32x4_t sum_lo = vdupq_n_s32(0);
+                            int32x4_t sum_hi = vdupq_n_s32(0);
+                            for (int k = 0; k < 4; k++) {
+                                sum_lo = vmmlaq_s32(sum_lo, q_lo[k], q8s[rp][k]);
+                                sum_hi = vmmlaq_s32(sum_hi, q_hi[k], q8s[rp][4 + k]);
+                            }
+                            lo[rp][cp] = vmulq_s32(sum_lo, scale_lo);
+                            hi[rp][cp] = vmulq_s32(sum_hi, scale_hi);
+                        }
+                    }
+
+                    // float accumulation in gemv order: per (row, 4 columns) fma(lo) then fma(hi)
+                    for (int rp = 0; rp < 2; rp++) {
+                        for (int j = 0; j < 2; j++) {
+                            const int32x4_t lo_r0 = vuzp1q_s32(lo[rp][2 * j], lo[rp][2 * j + 1]);
+                            const int32x4_t lo_r1 = vuzp2q_s32(lo[rp][2 * j], lo[rp][2 * j + 1]);
+                            const int32x4_t hi_r0 = vuzp1q_s32(hi[rp][2 * j], hi[rp][2 * j + 1]);
+                            const int32x4_t hi_r1 = vuzp2q_s32(hi[rp][2 * j], hi[rp][2 * j + 1]);
+                            const int       r0    = 2 * rp;
+                            const int       r1    = 2 * rp + 1;
+                            acc_f32[r0][j] = vfmaq_f32(acc_f32[r0][j], sb_scale[r0][j], vcvtq_f32_s32(lo_r0));
+                            acc_f32[r0][j] = vfmaq_f32(acc_f32[r0][j], sb_scale[r0][j], vcvtq_f32_s32(hi_r0));
+                            acc_f32[r1][j] = vfmaq_f32(acc_f32[r1][j], sb_scale[r1][j], vcvtq_f32_s32(lo_r1));
+                            acc_f32[r1][j] = vfmaq_f32(acc_f32[r1][j], sb_scale[r1][j], vcvtq_f32_s32(hi_r1));
+                        }
+                    }
+
+                    // min correction (bsums * mins)
+                    for (int r = 0; r < 4; r++) {
+                        const int16x4_t bsums_lo = vdup_n_s16(bsums_arr[sb][2 * r + 0]);
+                        const int16x4_t bsums_hi = vdup_n_s16(bsums_arr[sb][2 * r + 1]);
+                        if constexpr (IS_Q5) {
+                            for (int j = 0; j < 2; j++) {
+                                const int16x4_t mins_lo = j == 0 ? vget_low_s16(sb_mins[0]) : vget_high_s16(sb_mins[0]);
+                                const int16x4_t mins_hi = j == 0 ? vget_low_s16(sb_mins[1]) : vget_high_s16(sb_mins[1]);
+                                int32x4_t       bias    = vmull_s16(bsums_lo, mins_lo);
+                                bias                    = vmlal_s16(bias, bsums_hi, mins_hi);
+                                acc_f32[r][j]           = vmlsq_f32(acc_f32[r][j], sb_min[r][j], vcvtq_f32_s32(bias));
+                            }
+                        } else {
+                            bias_acc[r][0] = vmlal_s16(bias_acc[r][0], bsums_lo, vget_low_s16(sb_mins[0]));
+                            bias_acc[r][0] = vmlal_s16(bias_acc[r][0], bsums_hi, vget_low_s16(sb_mins[1]));
+                            bias_acc[r][1] = vmlal_s16(bias_acc[r][1], bsums_lo, vget_high_s16(sb_mins[0]));
+                            bias_acc[r][1] = vmlal_s16(bias_acc[r][1], bsums_hi, vget_high_s16(sb_mins[1]));
+                        }
+                    }
+                }  // for sb
+
+                if constexpr (!IS_Q5) {
+                    for (int r = 0; r < 4; r++) {
+                        for (int j = 0; j < 2; j++) {
+                            acc_f32[r][j] = vmlsq_f32(acc_f32[r][j], vcvtq_f32_s32(bias_acc[r][j]), sb_min[r][j]);
+                        }
+                    }
+                }
+            }  // for b
+
+            for (int r = 0; r < 4; r++) {
+                for (int j = 0; j < 2; j++) {
+                    vst1q_f32(s + (y * 4 + r) * bs + x * 8 + j * 4, acc_f32[r][j]);
+                }
+            }
+        }  // for x
+    }  // for y
+}
