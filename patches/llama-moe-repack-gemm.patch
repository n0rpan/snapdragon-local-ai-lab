From 0a3a67929be9a15b7bd7b1815358f11ed050a817 Mon Sep 17 00:00:00 2001
From: Oscar Nordstrom <13300531+n0rpan@users.noreply.github.com>
Date: Mon, 9 Nov 2026 17:57:49 +0100
Subject: [PATCH 1/2] ggml-cpu: use repack gemm for MUL_MAT_ID experts with >=
 4 routed rows

forward_mul_mat_id only called gemv, one routed row at a time, so MoE
prefill on repacked experts never reached the gemm (i8mm) kernels. When
an expert has >= 4 routed rows, gather the already-quantized q8_0/q8_K
rows 4 at a time into the interleaved block_q8_0x4/block_q8_Kx4 layout
(the generic ggml_quantize_mat_q8_*_4xN layout), run gemm on the tile in
column chunks of 256, and scatter the 4 output rows. The 1-3 row
remainder still uses gemv. gemm and gemv therefore read exactly the same
quantized activations.

Applies to every repack trait with a 4- or 8-wide q8_0/q8_K activation
interleave, on AArch64 only (other architectures override the 4xN
quantizers with their own layouts). The per-thread tile lives in the
op work buffer.

GGML_CPU_MOE_GEMM: unset/1 = all traits, 0 = off (upstream behaviour),
exact = only traits whose AArch64 gemm is bitwise identical to their
gemv (Q3_K 8x8, Q4_0 4x8, Q6_K 8x8, IQ4_NL 4x4, MXFP4 4x4, Q8_0 4x8,
Q1_0 4x8). Q4_K/Q5_K 8x8 gemm differs from gemv by ~3e-7 relative, as it
already does in MUL_MAT.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cpu/repack.cpp | 164 ++++++++++++++++++++++++++++++++++-
 1 file changed, 162 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-cpu/repack.cpp b/ggml/src/ggml-cpu/repack.cpp
index 93d7daa..48674dc 100644
--- a/ggml/src/ggml-cpu/repack.cpp
+++ b/ggml/src/ggml-cpu/repack.cpp
@@ -16,6 +16,7 @@
 #include <cassert>
 #include <cstdio>  // for GGML_ASSERT
 #include <cstdlib> // for getenv
+#include <type_traits>
 
 #include "repack.h"
 
@@ -4461,6 +4462,106 @@ static int repack_mxfp4_to_mxfp4_8_bl(struct ggml_tensor * t, int interleave_blo
     GGML_UNUSED(data_size);
 }
 
+// MUL_MAT_ID gemm path (prefill on repacked experts)
+//
+// forward_mul_mat_id quantizes every src1 row with from_float (one block_q8_0 / block_q8_K row each). When an
+// expert has >= 4 routed rows, the rows are gathered 4 at a time into the interleaved block_q8_0x4 /
+// block_q8_Kx4 layout the gemm kernels consume (same layout as the generic ggml_quantize_mat_q8_*_4xN), so gemm
+// and gemv read exactly the same quantized activations.
+//
+// GGML_CPU_MOE_GEMM: unset or "1" = all supported traits, "0" = off (gemv only, upstream behaviour),
+// "exact" = only traits whose gemm kernel was verified bitwise identical to their gemv kernel on AArch64
+// NEON (Q3_K 8x8, Q4_0 4x8, Q6_K 8x8, IQ4_NL 4x4, MXFP4 4x4, Q8_0 4x8, Q1_0 4x8). The Q4_K/Q5_K 8x8 gemm kernels
+// round differently from their gemv kernels (~3e-7 relative), exactly as they already do in MUL_MAT.
+//
+// Only enabled on AArch64, where the interleaved layout produced by ggml_quantize_mat_* is the generic one
+// (other architectures override the 4xN quantizers with their own layouts).
+#if defined(__aarch64__)
+#define GGML_REPACK_MMID_GEMM_ARCH 1
+#else
+#define GGML_REPACK_MMID_GEMM_ARCH 0
+#endif
+
+static bool ggml_repack_env_enabled(const char * name);
+
+enum ggml_repack_moe_gemm_mode { GGML_REPACK_MOE_GEMM_OFF = 0, GGML_REPACK_MOE_GEMM_ALL = 1, GGML_REPACK_MOE_GEMM_EXACT = 2 };
+
+static ggml_repack_moe_gemm_mode ggml_repack_moe_gemm_get_mode() {
+    static const ggml_repack_moe_gemm_mode mode = [] {
+        const char * v = getenv("GGML_CPU_MOE_GEMM");
+        if (v != nullptr && strcmp(v, "exact") == 0) {
+            return GGML_REPACK_MOE_GEMM_EXACT;
+        }
+        return ggml_repack_env_enabled("GGML_CPU_MOE_GEMM") ? GGML_REPACK_MOE_GEMM_ALL : GGML_REPACK_MOE_GEMM_OFF;
+    }();
+    return mode;
+}
+
+template <int64_t INTER_SIZE, ggml_type PARAM_TYPE> static constexpr bool ggml_repack_mmid_gemm_supported() {
+    return GGML_REPACK_MMID_GEMM_ARCH && (INTER_SIZE == 4 || INTER_SIZE == 8) &&
+           (PARAM_TYPE == GGML_TYPE_Q8_0 || PARAM_TYPE == GGML_TYPE_Q8_K);
+}
+
+// traits whose AArch64 gemm is bitwise identical to their gemv (test_ggml_repack_moe.cpp)
+template <typename BLOC_TYPE, int64_t INTER_SIZE, int64_t NB_COLS> static constexpr bool ggml_repack_mmid_gemm_exact() {
+    return (std::is_same_v<BLOC_TYPE, block_q3_K>   && INTER_SIZE == 8 && NB_COLS == 8) ||
+           (std::is_same_v<BLOC_TYPE, block_q4_0>   && INTER_SIZE == 8 && NB_COLS == 4) ||
+           (std::is_same_v<BLOC_TYPE, block_q6_K>   && INTER_SIZE == 8 && NB_COLS == 8) ||
+           (std::is_same_v<BLOC_TYPE, block_iq4_nl> && INTER_SIZE == 4 && NB_COLS == 4) ||
+           (std::is_same_v<BLOC_TYPE, block_mxfp4>  && INTER_SIZE == 4 && NB_COLS == 4) ||
+           (std::is_same_v<BLOC_TYPE, block_q8_0>   && INTER_SIZE == 8 && NB_COLS == 4) ||
+           (std::is_same_v<BLOC_TYPE, block_q1_0>   && INTER_SIZE == 8 && NB_COLS == 4);
+}
+
+template <typename BLOC_TYPE, int64_t INTER_SIZE, int64_t NB_COLS, ggml_type PARAM_TYPE>
+static bool ggml_repack_mmid_gemm_enabled() {
+    if constexpr (!ggml_repack_mmid_gemm_supported<INTER_SIZE, PARAM_TYPE>()) {
+        return false;
+    } else {
+        switch (ggml_repack_moe_gemm_get_mode()) {
+            case GGML_REPACK_MOE_GEMM_ALL:   return true;
+            case GGML_REPACK_MOE_GEMM_EXACT: return ggml_repack_mmid_gemm_exact<BLOC_TYPE, INTER_SIZE, NB_COLS>();
+            default:                         return false;
+        }
+    }
+}
+
+// Interleave 4 quantized rows (n_per_row values each) into the 4xBL activation layout.
+template <int64_t BL, ggml_type PARAM_TYPE>
+static void ggml_repack_interleave_q8_rows_x4(const void * const rows_v[4], void * GGML_RESTRICT out_v, int64_t n_per_row) {
+    static_assert(BL == 4 || BL == 8, "unsupported interleave");
+    if constexpr (PARAM_TYPE == GGML_TYPE_Q8_0) {
+        const int64_t nb = n_per_row / QK8_0;
+        const block_q8_0 * const * rows = (const block_q8_0 * const *) rows_v;
+        block_q8_0x4 * GGML_RESTRICT out = (block_q8_0x4 *) out_v;
+        for (int64_t b = 0; b < nb; b++) {
+            for (int r = 0; r < 4; r++) {
+                out[b].d[r] = rows[r][b].d;
+                for (int ch = 0; ch < QK8_0 / BL; ch++) {
+                    memcpy(out[b].qs + ch * 4 * BL + r * BL, rows[r][b].qs + ch * BL, BL);
+                }
+            }
+        }
+    } else {
+        static_assert(PARAM_TYPE == GGML_TYPE_Q8_K, "unsupported activation type");
+        const int64_t nb = n_per_row / QK_K;
+        const block_q8_K * const * rows = (const block_q8_K * const *) rows_v;
+        block_q8_Kx4 * GGML_RESTRICT out = (block_q8_Kx4 *) out_v;
+        for (int64_t b = 0; b < nb; b++) {
+            for (int r = 0; r < 4; r++) {
+                out[b].d[r] = rows[r][b].d;
+                for (int ch = 0; ch < QK_K / BL; ch++) {
+                    memcpy(out[b].qs + ch * 4 * BL + r * BL, rows[r][b].qs + ch * BL, BL);
+                }
+                // bsums: groups of 4 sub-block sums per row, rows interleaved (see ggml_quantize_mat_q8_K_4x8)
+                for (int g = 0; g < QK_K / 16; g++) {
+                    out[b].bsums[(g / 4) * 16 + r * 4 + (g % 4)] = rows[r][b].bsums[g];
+                }
+            }
+        }
+    }
+}
+
 namespace ggml::cpu::repack {
 // repack
 template <typename BLOC_TYPE, int64_t INTER_SIZE, int64_t NB_COLS>
@@ -4795,7 +4896,8 @@ class tensor_traits_base : public ggml::cpu::tensor_traits {
 
 template <typename BLOC_TYPE, int64_t INTER_SIZE, int64_t NB_COLS, ggml_type PARAM_TYPE> class tensor_traits : public tensor_traits_base {
 
-    bool work_size(int /* n_threads */, const struct ggml_tensor * op, size_t & size) override {
+    bool work_size(int n_threads, const struct ggml_tensor * op, size_t & size) override {
+        GGML_UNUSED(n_threads);
         // not realy a GGML_TYPE_Q8_0 but same size.
         switch (op->op) {
             case GGML_OP_MUL_MAT:
@@ -4815,6 +4917,14 @@ template <typename BLOC_TYPE, int64_t INTER_SIZE, int64_t NB_COLS, ggml_type PAR
 
                     size += sizeof_mmid_row_mapping*ne02*(ne12 + 1);
 
+                    if constexpr (ggml_repack_mmid_gemm_supported<INTER_SIZE, PARAM_TYPE>()) {
+                        if (ggml_repack_mmid_gemm_enabled<BLOC_TYPE, INTER_SIZE, NB_COLS, PARAM_TYPE>()) {
+                            // per-thread 4-row activation tile for the gemm path (+ alignment slack)
+                            const size_t tile = GGML_PAD(4 * ggml_row_size(PARAM_TYPE, op->src[1]->ne[0]), 64);
+                            size += 64 + tile * n_threads;
+                        }
+                    }
+
                     return true;
                 }
             default:
@@ -5111,6 +5221,23 @@ template <typename BLOC_TYPE, int64_t INTER_SIZE, int64_t NB_COLS, ggml_type PAR
 
         ggml_barrier(params->threadpool);
 
+        // per-thread activation tile for the gemm path (see ggml_repack_mmid_gemm_supported)
+        bool   use_gemm = false;
+        char * tile     = nullptr;
+        if constexpr (ggml_repack_mmid_gemm_supported<INTER_SIZE, PARAM_TYPE>()) {
+            if (ggml_repack_mmid_gemm_enabled<BLOC_TYPE, INTER_SIZE, NB_COLS, PARAM_TYPE>()) {
+                const size_t tile_stride = GGML_PAD(4 * nbw1, 64);
+                const uintptr_t base = GGML_PAD((uintptr_t) (matrix_rows + n_as * ne12), 64);
+                const uintptr_t wend = (uintptr_t) wdata + params->wsize;
+                if (base + (size_t) nth * tile_stride <= wend) {
+                    tile     = (char *) base + ith * tile_stride;
+                    use_gemm = true;
+                }
+            }
+        }
+        GGML_UNUSED(use_gemm);
+        GGML_UNUSED(tile);
+
         // compute each matrix multiplication in sequence
         for (int cur_a = 0; cur_a < n_as; ++cur_a) {
             const int64_t cne1 = matrix_row_counts[cur_a];
@@ -5138,7 +5265,40 @@ template <typename BLOC_TYPE, int64_t INTER_SIZE, int64_t NB_COLS, ggml_type PAR
                 return;
             }
 
-            for (int ir1 = 0; ir1 < nr1; ir1++) {
+            int64_t ir1 = 0;
+
+            // >= 4 routed rows: 4-row tiles through gemm, remainder through gemv
+            if constexpr (ggml_repack_mmid_gemm_supported<INTER_SIZE, PARAM_TYPE>()) {
+                if (use_gemm && nr1 >= 4) {
+                    constexpr int64_t chunk_cols = 256;  // bounds the stack buffer; a multiple of NB_COLS
+                    static_assert(chunk_cols % NB_COLS == 0, "chunk_cols must be a multiple of NB_COLS");
+                    float tmp[4 * chunk_cols];
+
+                    const int64_t ncols = src0_cur_end - src0_cur_start;
+
+                    for (; ir1 + 4 <= nr1; ir1 += 4) {
+                        const void * rows[4];
+                        float *      dst_rows[4];
+                        for (int j = 0; j < 4; j++) {
+                            const struct mmid_row_mapping rm = MMID_MATRIX_ROW(cur_a, ir1 + j);
+                            rows[j]     = wdata + ((rm.i1 % ne11) * nbw1 + rm.i2 * nbw2);
+                            dst_rows[j] = (float *) ((char *) dst->data + (rm.i1 * nb1 + rm.i2 * nb2)) + src0_cur_start;
+                        }
+                        ggml_repack_interleave_q8_rows_x4<INTER_SIZE, PARAM_TYPE>(rows, tile, ne10);
+
+                        for (int64_t c0 = 0; c0 < ncols; c0 += chunk_cols) {
+                            const int64_t nc = MIN(chunk_cols, ncols - c0);
+                            gemm<BLOC_TYPE, INTER_SIZE, NB_COLS, PARAM_TYPE>(
+                                ne00, tmp, nc, src0_cur + (src0_cur_start + c0) * nb01, tile, 4, nc);
+                            for (int j = 0; j < 4; j++) {
+                                memcpy(dst_rows[j] + c0, tmp + j * nc, nc * sizeof(float));
+                            }
+                        }
+                    }
+                }
+            }
+
+            for (; ir1 < nr1; ir1++) {
                 struct mmid_row_mapping row_mapping = MMID_MATRIX_ROW(cur_a, ir1);
 
                 const int id = row_mapping.i1;  // selected expert index
-- 
