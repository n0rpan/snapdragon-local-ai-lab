+// Q3_K -> block_q3_Kx8
+//
+// Eight block_q3_K (8 consecutive weight rows, same 256-wide k range) become one block_q3_Kx8 of exactly the
+// same total size (880 bytes), so the repack can happen in place. It is a lossless re-encoding:
+//
+//   d[8]       fp16 super-block scales, rows 0..7 (values unchanged)
+//   scales[96] the 128 raw 6-bit sub-block scales (16 per row), index i = g*8 + c (g = sub-block, c = row):
+//              scales[i]      (i < 64) = (raw[i] & 15) | (raw[i + 64] & 15) << 4
+//              scales[64 + i] (i < 32) = sum_{q = 0..3} (raw[i + 32q] >> 4) << 2q
+//   qs[768]    the 2048 signed 3-bit weights v = q2 - (hbit ? 0 : 4) in [-4, 3], as 16 triples.
+//              Triple (t, cp) (t = k / 64, cp = column pair) is at qs + (t*4 + cp)*48 and is three 16-byte
+//              vectors X, Y, Z. Lane L belongs to row c = 2cp + L/8 and k offset kk = L%8. With
+//              f_i = v(c, 64t + 8i + kk) & 7:
+//                X = f0<<5 | f1<<2 | (f6 & 3)
+//                Y = f2<<5 | f3<<2 | (f6>>2 & 1) | (f7 & 1)<<1
+//                Z = f4<<5 | f5<<2 | (f7>>1 & 3)
+//              15 NEON shift ops turn a triple into eight sign-extended int8x16 operands, each of which is
+//              rows (2cp, 2cp+1) x 8 consecutive k: the SDOT 8x8 and SMMLA 2x8 operand shape.
+
+// Raw 6-bit scales (0..63) of a block_q3_K, in sub-block order (same unpack as dequantize_row_q3_K).
+static void q3k_raw_scales(const block_q3_K * b, uint8_t raw[16]) {
+    const uint32_t kmask1 = 0x03030303;
+    const uint32_t kmask2 = 0x0f0f0f0f;
+    uint32_t aux[4];
+    memcpy(aux, b->scales, 12);
+    const uint32_t tmp = aux[2];
+    aux[2] = ((aux[0] >> 4) & kmask2) | (((tmp >> 4) & kmask1) << 4);
+    aux[3] = ((aux[1] >> 4) & kmask2) | (((tmp >> 6) & kmask1) << 4);
+    aux[0] = (aux[0] & kmask2) | (((tmp >> 0) & kmask1) << 4);
+    aux[1] = (aux[1] & kmask2) | (((tmp >> 2) & kmask1) << 4);
+    memcpy(raw, aux, 16);
+}
+
+// All 256 weights of a block_q3_K as 3-bit two's complement fields (v & 7), in k order.
+static void q3k_fields(const block_q3_K * b, uint8_t f[QK_K]) {
+    const uint8_t * q3 = b->qs;
+    uint8_t * a = f;
+    uint8_t m = 1;
+    for (int n = 0; n < QK_K; n += 128) {
+        for (int shift = 0; shift < 8; shift += 2) {
+            for (int l = 0; l < 32; ++l) {
+                a[l] = (uint8_t) ((((q3[l] >> shift) & 3) - ((b->hmask[l] & m) ? 0 : 4)) & 7);
+            }
+            a += 32;
+            m <<= 1;
+        }
+        q3 += 32;
+    }
+}
+
+static block_q3_Kx8 make_block_q3_Kx8(block_q3_K * in, unsigned int blck_size_interleave) {
+    GGML_ASSERT(blck_size_interleave == 8);
+    block_q3_Kx8 out;
+    uint8_t raw[128];
+    uint8_t fv[8][QK_K];
+
+    for (int c = 0; c < 8; c++) {
+        q3k_fields(&in[c], fv[c]);
+        out.d[c] = in[c].d;
+        uint8_t r[16];
+        q3k_raw_scales(&in[c], r);
+        for (int g = 0; g < 16; g++) {
+            raw[g * 8 + c] = r[g];
+        }
+    }
+    for (int i = 0; i < 64; i++) {
+        out.scales[i] = (uint8_t) ((raw[i] & 15) | ((raw[i + 64] & 15) << 4));
+    }
+    for (int i = 0; i < 32; i++) {
+        out.scales[64 + i] = (uint8_t) ((raw[i] >> 4) | ((raw[i + 32] >> 4) << 2) | ((raw[i + 64] >> 4) << 4) |
+                                        ((raw[i + 96] >> 4) << 6));
+    }
+    for (int t = 0; t < 4; t++) {
+        for (int cp = 0; cp < 4; cp++) {
+            uint8_t * X = out.qs + ((t * 4 + cp) * 3) * 16;
+            uint8_t * Y = X + 16;
+            uint8_t * Z = X + 32;
+            // F[i][L]: lanes 0..7 = row 2cp, lanes 8..15 = row 2cp+1, k = 64t + 8i + L%8 (contiguous per row)
+            uint8_t F[8][16];
+            for (int i = 0; i < 8; i++) {
+                memcpy(F[i],     &fv[2 * cp][64 * t + 8 * i], 8);
+                memcpy(F[i] + 8, &fv[2 * cp + 1][64 * t + 8 * i], 8);
+            }
+            for (int L = 0; L < 16; L++) {
+                X[L] = (uint8_t) (F[0][L] << 5 | F[1][L] << 2 | (F[6][L] & 3));
+                Y[L] = (uint8_t) (F[2][L] << 5 | F[3][L] << 2 | ((F[6][L] >> 2) & 1) | (F[7][L] & 1) << 1);
+                Z[L] = (uint8_t) (F[4][L] << 5 | F[5][L] << 2 | ((F[7][L] >> 1) & 3));
+            }
+        }
+    }
+
