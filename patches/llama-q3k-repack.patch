+// Q3_K 8x8 (block_q3_Kx8) scalar accessors, shared by the generic kernels.
+// Raw 6-bit scale (0..63) of sub-block g (0..15) of row c (0..7).
+static inline int ggml_q3x8_raw_scale(const block_q3_Kx8 * b, int c, int g) {
+    const int i  = g * 8 + c;
+    const int lo = (i < 64) ? (b->scales[i] & 15) : (b->scales[i - 64] >> 4);
+    const int hi = (b->scales[64 + (i % 32)] >> (2 * (i / 32))) & 3;
+    return lo | hi << 4;
+}
+
+// Signed 3-bit weight (-4..3) of row c (0..7), element k (0..255).
+static inline int ggml_q3x8_value(const block_q3_Kx8 * b, int c, int k) {
+    const int       t = k / 64, i = (k % 64) / 8, kk = k % 8, cp = c / 2;
+    const int       L = (c % 2) * 8 + kk;
+    const uint8_t * p = b->qs + ((t * 4 + cp) * 3) * 16;
+    const int       X = p[L], Y = p[16 + L], Z = p[32 + L];
+    int             f;
+    switch (i) {
+        case 0:  f = X >> 5;                            break;
+        case 1:  f = (X >> 2) & 7;                      break;
+        case 2:  f = Y >> 5;                            break;
+        case 3:  f = (Y >> 2) & 7;                      break;
+        case 4:  f = Z >> 5;                            break;
+        case 5:  f = (Z >> 2) & 7;                      break;
+        case 6:  f = (X & 3) | (Y & 1) << 2;            break;
+        default: f = ((Y >> 1) & 1) | (Z & 3) << 1;     break;
+    }
+    return f - ((f & 4) << 1);
+}
