def oxi_cond_put_args(spec, handover, cache_dir=None):
    return [str(OXI_BIN), 'cond-put', '--handoff', str(handover), '--gguf', str(KLEIN_FILES['q8']),
            '--width', str(spec['width']), '--height', str(spec['height']), '--steps', str(EDIT_STEPS),
            '--sigmas', 'computed', '--cache', str(OXI_COND_CACHE if cache_dir is None else cache_dir)]


def handover_stop():
    """Stop predicate for the probe sd-cli: the first SDPROBE line after `dump.pe call=0`.

    The probe prints a tag's line and then writes its file on the same thread; the next probe op
    starts only after that, so by the following line the four hand-over files are complete."""
    seen = {'pe': False}

    def stop(line):
        if not line.startswith('SDPROBE '):
            return False
        if seen['pe']:
            return True
        if line.startswith('SDPROBE dump.pe call=0 '):
            seen['pe'] = True
        return False
    return stop


def prune_cond_cache(keep=OXI_COND_KEEP, cache_dir=None):
    cache_dir = OXI_COND_CACHE if cache_dir is None else Path(cache_dir)
    try:
        entries = sorted((d for d in cache_dir.iterdir() if d.is_dir()), key=lambda d: d.stat().st_mtime)
    except OSError:
        return
    for old in entries[:max(0, len(entries) - keep)]:
        shutil.rmtree(old, ignore_errors=True)


def make_conditioning(job, prompt, spec, cache_dir=None):
    """Encode a new prompt once: probe sd-cli up to model call 0, then `oxi cond-put`."""
    work = OXI_WORK / uuid.uuid4().hex
    dump, handover = work / 'dump', work / 'handover'
    try:
        dump.mkdir(parents=True, mode=0o700)
        handover.mkdir(mode=0o700)
        job['state'] = 'encoding prompt'
        job['engine_binary'] = 'sd-cli (probe)'
        environment = dict(oxi_cache_environment(cache_dir) or os.environ, SD_PROBE='1',
                           SD_PROBE_DUMP_DIR=str(dump), SD_PROBE_DUMP_CALL='0')
        args = build_klein_t2i_args(SD_PROBE_CLI, KLEIN_FILES['q8'], spec['width'], spec['height'],
                                    work / 'unused.png', spec['threads'], spec['fa'], seed=spec['seeds'][0])
        run_engine(args, job, environment, prompt, stop=handover_stop())
        for tag in HANDOVER_TAGS:
            found = list(dump.glob(f'{tag}.call0.*.bin'))
            if len(found) != 1:
                raise OxiFailure('the prompt hand-over from sd-cli is incomplete')
            shutil.copyfile(found[0], handover / found[0].name)
        job['engine_binary'] = 'oxi'
        rc = run_engine(oxi_cond_put_args(spec, handover, cache_dir), job, oxi_cache_environment(cache_dir), prompt)
        if rc != 0:
            raise OxiFailure(f'oxi cond-put exited {rc}')
        prune_cond_cache(cache_dir=cache_dir)
    finally:
        shutil.rmtree(work, ignore_errors=True)


def oxi_generate_all(job, prompt, spec, cache_dir=None):
    for index, (seed, out) in enumerate(zip(spec['seeds'], spec['outputs'])):
        if len(spec['outputs']) > 1:
            job['step'] = f'image {index + 1} of {len(spec["outputs"])}'
        args = oxi_generate_args(spec, seed, out, cache_dir)
        job['engine_binary'] = 'oxi'
        job['oxi_forwards'] = 0
        rc = run_engine(args, job, oxi_cache_environment(cache_dir), prompt, prompt_flag='--cond-prompt-file')
        if rc == OXI_NO_CONDITIONING and index == 0:
            make_conditioning(job, prompt, spec, cache_dir)
            job['engine_binary'] = 'oxi'
            job['oxi_forwards'] = 0
            job['state'] = 'starting'
            rc = run_engine(args, job, oxi_cache_environment(cache_dir), prompt, prompt_flag='--cond-prompt-file')
        if rc != 0:
            if job.get('npu_requested'):
                if rc in (69, 71):
                    raise OxiNpuFallback('NPU package refused or latched; finished on CPU')
                raise OxiNpuRecovery('NPU worker cleanup requires recovery; CPU generation was not started')
            raise OxiFailure(f'oxi exited {rc}')
        if png_size(out) != (spec['width'], spec['height']):
            raise OxiFailure('oxi did not write a %d × %d image' % (spec['width'], spec['height']))
    job.pop('step', None)


def run_oxi_t2i(job, prompt, spec):
    """The oxi step of a klein 512 px request; returns an exit code like run_engine.

    "auto": any oxi failure removes oxi's images and runs the whole request on sd-cli instead
    (same seeds, so the same pictures within the image gate). "oxi": the failure is the job's error.
    """
    job['engine'] = 'oxi'
    try:
        def generate(cache_dir=None):
            try:
                oxi_generate_all(job, prompt, spec, cache_dir)
            except OxiNpuFallback as error:
                for out in spec['outputs']:
                    Path(out).unlink(missing_ok=True)
                job['npu_requested'] = False
                job['engine_note'] = str(error)
                oxi_generate_all(job, prompt, spec, cache_dir)
        if oxi_prompt_cache_enabled():
            generate()
        else:
            with tempfile.TemporaryDirectory(prefix='oxi-cond-') as cache_dir:
                generate(Path(cache_dir))
        if id(job) in IMAGE_LEASES:
            backend = 'oxi-npu' if job.get('npu_requested') else 'oxi-cpu'
            job['engine'] = backend
            job['device'] = 'npu' if job.get('npu_requested') else 'cpu'
            for record in spec['results']:
                record['backend'] = backend
        return 0
    except OxiNpuRecovery:
        raise  # Never overlap a CPU retry with a possibly surviving native child.
    except Exception as error:  # noqa: BLE001 - every oxi failure is a fallback reason
        reason = str(error) or type(error).__name__
    for out in spec['outputs']:
        Path(out).unlink(missing_ok=True)
    if spec['setting'] == 'oxi':
        raise OxiFailure(f'oxi failed: {reason} (engine setting "oxi" has no sd.cpp fallback)')
    job['engine'] = 'sd.cpp'
    job['engine_note'] = f'oxi failed ({reason}); finished on sd.cpp'
    job['engine_binary'] = 'sd-cli'
    job.pop('step', None)
    job['phase'] = None
    job['state'] = 'starting sd.cpp'
    for record in spec['results']:
        record['backend'] = 'sd.cpp'
        record['fallback'] = reason
    return run_engine(spec['sd_args'], job, None, prompt)


def read_mask_at(mask, width, height):
    """Mask as a flat gray buffer at the photo's native size (resized when the sizes differ)."""
    mw, mh, gray = read_png(mask, gray=True)
    if (mw, mh) != (width, height):
        gray = resize_pixels(gray, mw, mh, width, height, 1)
    return gray


def plan_edit(body):
    """Validate an instruction-edit request and build its engine step(s).

    With a mask (default) only the masked area is edited: the native photo is cropped around
    the mask, the crop is edited at its own working size, and the result is pasted back at the
    photo's full resolution through the feathered native mask. "crop": false keeps the older
    whole-image working copy, which is also what an unmasked edit uses.
    """
    instruction = (body.get('instruction') or '').strip() if isinstance(body.get('instruction'), str) else ''
    if not instruction:
        raise StudioError('Type what to change first', 200)
    if len(instruction) > MAX_INSTRUCTION:
        raise StudioError(f'Instruction is longer than {MAX_INSTRUCTION} characters')
    crop = body.get('crop', True)
    if type(crop) is not bool:
        raise StudioError('crop must be true or false')
    use_crop = crop and bool(body.get('mask'))
    size = body.get('size', DEFAULT_EDIT_SIZE)
    if type(size) is not int or size not in EDIT_SIZES:
        raise StudioError('Edit size must be ' + ' or '.join(map(str, EDIT_SIZES)))
    model = body.get('model', 'q8')
    if model not in KLEIN_FILES:
        raise StudioError('Choose Q8 or Q4')
    steps = body.get('steps', EDIT_STEPS)
    if type(steps) is not int or not 1 <= steps <= 8:
        raise StudioError('Edit steps must be 1-8 (the distilled model is made for 4)')
    seed = body.get('seed')
    if seed is not None:
        try:
            if isinstance(seed, bool) or int(seed) != float(seed):
                raise ValueError()
            seed = int(seed)
            if not 0 <= seed <= 2**62:
                raise ValueError()
        except (TypeError, ValueError, OverflowError):
            raise StudioError('Seed must be a whole number of 0 or more') from None
    missing = edit_missing_files(model)
    if missing:
        raise StudioError('Missing edit model files: ' + ', '.join(missing) + ' (see docs/STUDIO-EDIT.md)', 200)
    source = Path(body['init']) if isinstance(body.get('init'), str) and body.get('init') else None
    if source is None or not source.is_file() or not source.resolve().is_relative_to(UPLOADS.resolve()):
        raise StudioError('Upload the photo to edit first')
    dims = image_size(source)
    if dims is None:
        raise StudioError('The photo must be a PNG or JPEG')
    if min(dims) < 64:
        raise StudioError('The photo is too small to edit')
    mask = None
    if body.get('mask'):
        mask = Path(body['mask']) if isinstance(body['mask'], str) else None
        if mask is None or not mask.is_file() or not mask.resolve().is_relative_to(UPLOADS.resolve()):
            raise StudioError('Upload the mask again')
        if png_size(source) is None or png_size(mask) is None:
            raise StudioError('A mask needs the photo and the mask as PNG files (convert JPEG to PNG first)')
        if dims[0] * dims[1] > MAX_MASK_PIXELS or png_size(mask)[0] * png_size(mask)[1] > MAX_MASK_PIXELS:
            raise StudioError('Masked edits take images up to about 4 megapixels; downscale it first')
    tuning = runtime_tuning('klein')
    threads = int(tuning.get('threads', 6))
    fa = tuning.get('flash_attention', 'off')
    base_seed = SDCPP_DEFAULT_SEED if seed is None else seed
    stem = f"{time.strftime('%Y%m%d-%H%M%S')}-{uuid.uuid4().hex[:6]}-edit"
    final = OUT / f"{stem}.png"
    work = OUT / '_work'
    ref, raw = work / f"{stem}-ref.png", work / f"{stem}-raw.png"
    scratch = []
    state = {}
    crop_info = None
    if mask is None or not use_crop:
        width, height = edit_work_size(dims[0], dims[1], size)
        step = {'label': 'editing', 'prompt': True, 'expect_size': (width, height)}
        if mask is None:
            step['args'] = build_edit_args(SDCLI, KLEIN_FILES[model], source, final, width, height, steps, threads, fa, seed=base_seed)
            step['outputs'] = [final]
        else:
            scratch += [str(ref), str(raw)]

            def pre():
                work.mkdir(parents=True, exist_ok=True)
                state['ref'], state['mask'] = prepare_edit_inputs(source, mask, (width, height), ref)

            def post():
                composite_files(state['ref'], state['mask'], raw, final, (width, height))

            step.update(args=build_edit_args(SDCLI, KLEIN_FILES[model], ref, raw, width, height, steps, threads, fa, seed=base_seed),
                        outputs=[raw], pre=pre, post=post)
        out_width, out_height = width, height
    else:
        # Crop-edit-paste at native resolution (docs/STUDIO-EDIT.md, "Masked edits").
        try:
            mask_gray = read_mask_at(mask, dims[0], dims[1])
            bbox = mask_bounding_box(mask_gray, dims[0], dims[1])
            if bbox is None:
                raise StudioError('The mask has no white area; paint the part to change in white')
            x0, y0, x1, y1, width, height = crop_box_for_mask(bbox, dims[0], dims[1], size)
        except (ValueError, OSError) as error:
            raise StudioError(str(error)) from None
        cw, ch = x1 - x0, y1 - y0
        scale = max(width, height) / max(cw, ch)
        scratch += [str(ref), str(raw)]

        def pre():
            work.mkdir(parents=True, exist_ok=True)
            _, _, rgb = read_png(source)
            crop_rgb = crop_pixels(rgb, dims[0], x0, y0, cw, ch, 3)
            if (width, height) != (cw, ch):
                crop_rgb = resize_pixels(crop_rgb, cw, ch, width, height, 3)
            write_png(ref, width, height, crop_rgb)
            state['rgb'] = rgb

        def post():
            composite_crop(state['rgb'], dims[0], dims[1], (x0, y0, cw, ch), mask_gray, raw, (width, height), final)

        step = {'label': 'editing', 'prompt': True, 'expect_size': (width, height), 'outputs': [raw],
                'pre': pre, 'post': post,
                'args': build_edit_args(SDCLI, KLEIN_FILES[model], ref, raw, width, height, steps, threads, fa, seed=base_seed)}
        out_width, out_height = dims
        crop_info = {'box': [x0, y0, x1, y1], 'work': [width, height], 'scale': round(scale, 4)}
    result = {'path': str(final), 'prompt': instruction, 'seed': base_seed, 'model': 'klein-' + model,
              'width': out_width, 'height': out_height, 'steps': steps, 'kind': 'edit', 'engine': 'klein'}
    if crop_info is not None:
        result['crop'] = crop_info
    return {'steps': [step], 'environment': None, 'prompt': instruction, 'results': [result],
            'model': 'klein-' + model, 'device': 'cpu', 'scratch': scratch,
            'estimate': edit_estimate_seconds(width, height, masked=mask is not None)}


def start_job(plan):
    """Claim the generation lease and run the plan in the background; (job_id, error)."""
    job_id = uuid.uuid4().hex
    with LOCK:
        if any(j["state"] not in ("done", "error") for j in JOBS.values()):
            return None, "A generation is already running"
        npu_enabled, npu_profile = oxi_npu_settings()
        use_broker = npu_enabled and plan.get('engine', {}).get('engine') == 'oxi'
        if use_broker:
            try:
                generation_lock = image_slot.connect(
                    Path(os.environ.get('LOCAL_AI_IMAGE_SOCKET', str(HOME / '.local/state/local-ai/image-slot/permit.sock'))),
                    'klein-q8-512-npu')
            except (OSError, ValueError, image_slot.SlotUnavailable):
                return None, 'Image permit unavailable; resident chat was kept loaded. Try again when chat is idle.'
        else:
            generation_lock = GENERATION_LOCK.open('a')
            if not claim_generation_slot(generation_lock):
                generation_lock.close()
                return None, "Another image or chat job is running; please try again shortly"
        JOBS[job_id] = {"state": "queued", "model": plan['model'], "device": plan['device']}
        if use_broker:
            job = JOBS[job_id]
            IMAGE_LEASES[id(job)] = generation_lock
            job['npu_requested'] = generation_lock.metadata.get('backend') == 'npu' and npu_profile is not None
            job['npu_profile'] = npu_profile
            job['engine_note'] = generation_lock.metadata.get('reason', '')
        if plan.get('engine'):
            JOBS[job_id]['engine'] = 'oxi' if plan['engine']['engine'] == 'oxi' else 'sd.cpp'
            JOBS[job_id]['engine_reason'] = plan['engine']['reason']
        SCRATCH[job_id] = list(plan.get('scratch', []))
    threading.Thread(target=run_pipeline,
                     args=(job_id, plan['steps'], generation_lock, plan['environment'], plan['prompt'], plan['results']),
                     daemon=True).start()
    return job_id, None

