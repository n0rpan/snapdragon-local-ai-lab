    if(j.state==='error'){$('status').textContent='failed: '+j.error; setBusy(false); return;}
    $('status').textContent=`${j.step?j.step+' · ':''}${j.state}… ${((Date.now()-t0)/1000).toFixed(0)}s`;
    await new Promise(r=>setTimeout(r,900));
  }
}
