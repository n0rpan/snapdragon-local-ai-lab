def update_job_progress(line, job):
    """Keep only fixed lifecycle labels and numerical progress, never output text."""
    lower = line.lower()
    if 'sampling completed' in lower:
        job['phase'] = 'decoding'
        job['state'] = 'preparing decoder'
    elif 'decoding' in lower or 'decode_first_stage' in lower:
        job['phase'] = 'decoding'
        job['state'] = 'decoding'
    elif 'generating image:' in lower:
        job['phase'] = 'sampling'
        job['state'] = 'starting sampling'
    elif lower.startswith('forward: total'):
        # oxi (IMG-SHIP): one line per DiT forward = one sampling step; the VAE decode follows the last
        job['oxi_forwards'] = job.get('oxi_forwards', 0) + 1
        done = job['oxi_forwards']
        job['phase'] = 'decoding' if done >= EDIT_STEPS else 'sampling'
        job['state'] = 'decoding' if done >= EDIT_STEPS else f'generating {done + 1}/{EDIT_STEPS}'
    elif 'get_learned_condition completed' in lower:
        job['state'] = 'prompt encoded'
    elif 'loading tensors completed' in lower:
        job['state'] = ('decoding' if job.get('phase') == 'decoding' else
                        'starting sampling' if job.get('phase') == 'sampling' else
                        'preparing generation')
    elif 'loading tensors' in lower:
        job['state'] = 'decoding' if job.get('phase') == 'decoding' else 'loading model'
    else:
        m = re.search(r"(\d+)/(\d+) - [\d.]+s/it", line)
        if m:
            stage = 'decoding' if job.get('phase') == 'decoding' else 'generating'
            job['state'] = f'{stage} {m.group(1)}/{m.group(2)}'


def vas_counter_thread(proc, job, stop=None, ready=None):
    """Recognize progress even when sd-cli prefixes CR and omits a newline.

    `stop(line)` returning True terminates the process (the oxi hand-over stops sd-cli once the
    first model call's inputs are on disk); the output is still read to the end."""
    line = ''
    while char := proc.stdout.read(1):
        if char in '\r\n':
            update_job_progress(line, job)
            if ready is not None and (line.startswith('forward:') or 'loading tensors completed' in line.lower()):
                ready()
            if stop is not None and line and stop(line) and proc.poll() is None:
                proc.terminate()
            line = ''
        else:
            line = (line + char)[-2048:]
            # The current progress record may have no trailing separator until
            # the next (potentially minutes-long) sampling step completes.
            if char == 't' and line.endswith('s/it'):
                update_job_progress(line, job)
    if line:
        update_job_progress(line, job)


def run_engine(args, job, environment=None, prompt=None, prompt_flag='--prompt-file', stop=None):
    """Run one sd-cli (or oxi) invocation, streaming progress into `job`; returns the exit code.

    This is the single engine boundary: tests replace it with a stub. The prompt goes in through an
    anonymous memory file named by `prompt_flag` (oxi generate reads it as --cond-prompt-file).
    """
    prompt_fd = None
    proc = None
    npu_worker = False
    guard = None
    try:
        command = list(args)
        if prompt is not None:
            # Anonymous memory only: no prompt in argv, named files, or logs.
            prompt_fd = os.memfd_create('prompt-studio', os.MFD_CLOEXEC)
            content = prompt.encode('utf-8')
            offset = 0
            while offset < len(content):
                written = os.write(prompt_fd, content[offset:])
                if written <= 0: raise OSError('Prompt memory write failed')
                offset += written
            os.lseek(prompt_fd, 0, os.SEEK_SET)
            command += [prompt_flag, f'/proc/self/fd/{prompt_fd}']
        permit = IMAGE_LEASES.get(id(job))
        inherited = (() if permit is None else permit.pass_fds()) + (() if prompt_fd is None else (prompt_fd,))
        if job.get('npu_requested') and command[:2] == [str(OXI_BIN), 'generate']:
            # Arithmetic is pinned by the checked worker, not by inherited CLI knobs.
            native = []
            skip = {'--backend', '--chunk1', '--chunk2', '--attn-prec', '--threads', '--vae-conv'}
            i = 1
            while i < len(command):
                if command[i] in skip:
                    i += 2
                else:
                    native.append(command[i]); i += 1
            if permit is None:
                raise OxiNpuRecovery('NPU generation has no controller permit')
            worker = Path(__file__).with_name('image_npu_worker.py')
            npu_worker = True
            command = [sys.executable, '-B', str(worker), '--profile', job['npu_profile'],
                       '--lease-fd', str(permit.fileno()), '--slot-fd', str(permit.connection.fileno()),
                       *([] if prompt_fd is None else ['--prompt-fd', str(prompt_fd)]), '--', *native]
            environment = image_npu.clean_environment(environment or os.environ)
            environment.pop('PYTHONPATH', None)
            environment.pop('PYTHONHOME', None)
        elif permit is not None:
            # A retained chat also needs protection while CPU conditioning or
            # fallback runs. These native commands exec in place (no timeout
            # process group), so the existing PID guard owns the whole worker.
            guard = memory_policy.MemoryGuard(host_guard_version=memory_policy.GUARD_2_VERSION,
                loading_timeout_seconds=120, follow_process_cgroup=True)
            command = memory_policy.scope_command(command, 28 * 1024**3)
        # Text mode recognizes both CR progress updates and newline log records.
        proc = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, encoding="utf-8", errors="replace", bufsize=1,
                                env=environment, pass_fds=inherited)
        if guard is not None:
            guard.start(proc)
        vas_counter_thread(proc, job, stop, None if guard is None else guard.mark_ready)
        if guard is not None and guard.failure():
            raise OxiNpuRecovery('Image memory guard stopped compute: ' + guard.failure())
        return proc.wait()
    except BaseException:
        if proc is not None and proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()
        if npu_worker:
            raise OxiNpuRecovery('NPU worker interrupted; refusing a CPU retry until native cleanup is confirmed')
        raise
    finally:
        if guard is not None:
            guard.stop()
        if proc is not None and proc.stdout is not None:
            proc.stdout.close()
        if prompt_fd is not None:
            os.close(prompt_fd)


def run_pipeline(job_id, steps, generation_lock, environment=None, prompt=None, results=None):
    """Run engine steps in order under one generation lease.

    Each step: {'args', 'outputs': [Path], 'label', 'prompt': bool,
    'environment' (optional), 'expect_size': (w, h) or None}. sd-cli exits 0
    even when ESRGAN fails (it then saves the unscaled input), so the PNG size
    is checked. Optional 'pre'/'post' callables run before/after the engine
    (edit mode: prepare the working image, composite the mask). `results` lists finished-image records to register on success.
    """
    job = JOBS[job_id]
    try:
        for index, step in enumerate(steps, 1):
            job['step'] = f"{step.get('label', 'working')} ({index}/{len(steps)})" if len(steps) > 1 else ''
            job['state'] = 'starting'
            if step.get('pre'):
                step['pre']()
            if step.get('run'):
                # IMG-SHIP: a step that drives its own engine calls (oxi, with the sd-cli fallback)
                rc = step['run'](job, prompt if step.get('prompt', True) else None)
            else:
                rc = run_engine(step['args'], job, step.get('environment', environment),
                                prompt if step.get('prompt', True) else None)
            missing = [p for p in step['outputs'] if not Path(p).exists()]
            if rc != 0 or missing:
                job['state'] = 'error'
                job['error'] = f"{job.get('engine_binary', 'sd-cli')} exited {rc}" + (' without writing its image' if rc == 0 else '')
                return
            expected = step.get('expect_size')
            if expected is not None:
                for p in step['outputs']:
                    actual = png_size(p)
                    if actual != tuple(expected):
                        job['state'] = 'error'
                        job['error'] = (f"{step.get('label', 'step')} produced "
                                        f"{'an unreadable image' if actual is None else '%d×%d' % actual}, "
                                        f"expected {expected[0]}×{expected[1]}")
                        return
            if step.get('post'):
                job['state'] = 'compositing'
                step['post']()
        images = []
        for record in results or []:
            image_id = register_image(record)
            entry = {'id': image_id, 'path': record['path'], 'seed': record['seed'],
                     'width': record['width'], 'height': record['height'],
                     'kind': record['kind'], 'actions': action_estimates(record)}
            if 'crop' in record:
                entry['crop'] = record['crop']
            if 'backend' in record:
                entry['backend'] = record['backend']
            images.append(entry)
        job['images'] = images
        if images:
            job['path'] = images[0]['path']
        elif steps:
            job['path'] = str(steps[-1]['outputs'][-1])
        job.pop('step', None)
        job['state'] = 'done'
    except Exception as e:
        job["state"] = "error"
        job["error"] = str(e)
    finally:
        for scratch in SCRATCH.pop(job_id, []):
            try:
                Path(scratch).unlink()
            except OSError:
                pass
        IMAGE_LEASES.pop(id(job), None)
        generation_lock.close()


def run_job(job_id, args, out_path, generation_lock, environment=None, prompt=None):
    """Single-command job (kept for callers of the original interface)."""
    run_pipeline(job_id, [{'args': args, 'outputs': [out_path], 'label': 'generating'}],
                 generation_lock, environment, prompt)


class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    # F80: same protections as the controller. Loopback Host with this port only (DNS rebinding),
    # no cross-site state changes, and bounded request bodies.
    MAX_UPLOAD = 25 * 1024 * 1024
    MAX_JSON = 1024 * 1024

    def _host_ok(self):
        hosts = self.headers.get_all("Host", [])
        port = self.server.server_address[1]
        return len(hosts) == 1 and hosts[0].strip().lower() in {
            f"127.0.0.1:{port}", f"localhost:{port}", f"[::1]:{port}"}

    def _post_ok(self):
        port = self.server.server_address[1]
        origins = self.headers.get_all("Origin", [])
        sites = self.headers.get_all("Sec-Fetch-Site", [])
        if len(origins) > 1 or len(sites) > 1:
            return False
        if sites and sites[0] not in ("same-origin", "none"):
            return False
        allowed = {f"http://127.0.0.1:{port}", f"http://localhost:{port}", f"http://[::1]:{port}"}
        return not origins or origins[0] in allowed

    def _refuse(self, why):
        self.close_connection = True
        return self._send(403, json.dumps({"error": why}).encode())

    def _send(self, code, body, ctype="application/json"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if not self._host_ok():
            return self._refuse("Host not allowed")
        u = urlparse(self.path)
        q = parse_qs(u.query)
        if u.path == '/activity':
            # The tray needs only lifecycle metadata, never job logs, paths,
            # prompts, uploads or generated image contents.
            with LOCK:
                active = [job for job in JOBS.values() if job.get('state') not in ('done', 'error')]
                job = active[0] if active else {}
                model = job.get('model') if job.get('model') in ('q4', 'q8') else None
                device = job.get('device') if job.get('device') in ('cpu', 'gpu') else None
                activity = dict(state='generating' if active else 'idle', active_jobs=len(active),
                                model=model, device=device)
            return self._send(200, json.dumps(activity).encode())
        if u.path == "/models":
            models = {key: {"ready": path.is_file(),
                            "download_mb": round(path.with_suffix(path.suffix + ".part").stat().st_size / 1048576) if path.with_suffix(path.suffix + ".part").exists() else 0}
                      for key, path in MODEL_FILES.items()}
            models['presets'] = image_presets()
            models['quality_ready'] = False
            try:
                cpu_profile = json.loads((PROJECT / 'cpu-profile.json').read_text())
                models['quality_ready'] = cpu_profile.get('validated') is True and [1024, 1024] in cpu_profile.get('dimensions', [])
            except (OSError, ValueError, AttributeError):
                pass
            try:
                runs = json.loads((PROJECT / 'benchmarks/results.json').read_text())
                models['quality_ready'] = models['quality_ready'] or any(r.get('status') == 'ok' and r.get('size', 0) >= 1024 and r.get('steps', 0) >= 8 for r in runs)
            except (OSError, ValueError):
                pass
            models['gpu'] = {'optimized': False}
            try:
                gpu = json.loads((PROJECT / 'gpu-profile.json').read_text())
                if gpu.get('enabled') and gpu.get('validated'):
                    models['gpu'] = {'optimized': True, 'models': gpu.get('models', {})}
            except (OSError, ValueError, AttributeError):
                pass
            status_file = PROJECT / 'q8-status.json'
            try:
                setup = json.loads(status_file.read_text())
                models['q8']['setup_state'] = setup.get('state', '')
            except (OSError, ValueError):
                models['q8']['setup_state'] = 'not downloaded'
            try:
                models['benchmarks'] = 'Benchmarks: ' + json.loads((PROJECT / 'overnight-status.json').read_text()).get('state', '')
            except (OSError, ValueError):
                models['benchmarks'] = ''
            models['edit_presets'] = EDIT_PRESETS
            models['default_edit_preset'] = DEFAULT_EDIT_PRESET
            settings = upscale_settings()
            models['upscale'] = {'esrgan': settings['esrgan_path'] is not None,
                                 'esrgan_x2': settings['esrgan_x2_path'] is not None,
                                 'esrgan_scale': settings['esrgan_scale'],
                                 'refine_targets': settings['refine_targets'],
                                 'refine_target': settings['refine_target'],
                                 'refine_strength': settings['refine_strength'],
                                 'estimates_calibrated': settings['estimate']['calibrated'],
                                 'max_variations': MAX_VARIATIONS}
            models['edit'] = edit_info()
            models['klein'] = klein_info()
            models['engine'] = engine_info()
            return self._send(200, json.dumps(models).encode())
        if u.path == '/engine':
            return self._send(200, json.dumps(engine_info()).encode())
        if u.path == "/estimate":
            # Generation estimate for the current form; numbers only, no prompt.
            if q.get('model', [''])[0] in KLEIN_MODELS:
                try:
                    width, height = int(q.get('width', ['512'])[0]), int(q.get('height', ['512'])[0])
                    count = int(q.get('variations', ['1'])[0])
                    if not (all(KLEIN_T2I_SIZE_MIN <= v <= KLEIN_T2I_SIZE_MAX and v % 16 == 0 for v in (width, height))
                            and 1 <= count <= MAX_VARIATIONS):
                        raise ValueError()
                except (ValueError, IndexError):
                    return self._send(400, json.dumps({'error': 'bad estimate request'}).encode())
                engine, reason = choose_t2i_engine(engine_setting(), q.get('model', [''])[0], width, height, oxi_missing())
                if engine == 'oxi':
                    return self._send(200, json.dumps({'seconds': oxi_estimate_seconds(count), 'optimized': True,
                                                       'calibrated': OXI_ESTIMATE['calibrated'],
                                                       'engine': 'oxi', 'engine_reason': reason}).encode())
                seconds = edit_estimate_seconds(width, height, t2i=True, count=count)
                return self._send(200, json.dumps({'seconds': seconds, 'optimized': False,
                                                   'calibrated': edit_estimate_settings()['calibrated'],
                                                   'engine': 'sd.cpp', 'engine_reason': reason}).encode())
            try:
                model = q.get('model', ['q8'])[0]
                width, height = int(q.get('width', ['256'])[0]), int(q.get('height', ['256'])[0])
                steps, count = int(q.get('steps', ['8'])[0]), int(q.get('variations', ['1'])[0])
                if model not in MODEL_FILES or not (256 <= width <= 1536 and 256 <= height <= 1536 and 1 <= steps <= 50 and 1 <= count <= MAX_VARIATIONS):
                    raise ValueError()
                edit = q.get('edit', ['0'])[0] == '1'
                strength = float(q['strength'][0]) if edit and 'strength' in q else (EDIT_PRESETS[DEFAULT_EDIT_PRESET] if edit else None)
                try:
                    optimized = optimized_cpu_profile(model, width, height, steps, edit) is not None
                except ValueError:
                    optimized = False
                seconds = estimate_seconds(upscale_settings(), 'img2img' if edit else 'txt2img', model, width, height,
                                           steps, strength, count=count, optimized=optimized)
            except (ValueError, KeyError, IndexError):
                return self._send(400, json.dumps({'error': 'bad estimate request'}).encode())
            return self._send(200, json.dumps({'seconds': seconds, 'optimized': optimized,
                                               'calibrated': upscale_settings()['estimate']['calibrated']}).encode())
        if u.path == "/":
            return self._send(200, PAGE.encode(), "text/html; charset=utf-8")
        if u.path == "/file":
            p = Path(q.get("path", [""])[0])
            allowed = (OUT, UPLOADS)
            if not p.exists() or not any(p.resolve().is_relative_to(a.resolve()) for a in allowed):
                return self._send(404, b"not found")
            return self._send(200, p.read_bytes(), "image/png" if p.suffix.lower() == ".png" else "image/jpeg")
        if u.path == "/job":
            j = JOBS.get(q.get("id", [""])[0])
            if not j:
                return self._send(404, json.dumps({"state": "error", "error": "no such job"}).encode())
            return self._send(200, json.dumps(j).encode())
        return self._send(404, b"not found")

    def do_POST(self):
        if not self._host_ok():
            return self._refuse("Host not allowed")
        if not self._post_ok():
            return self._refuse("Cross-origin request refused")
        try:
            length = int(self.headers.get("Content-Length", 0))
        except ValueError:
            return self._send(400, json.dumps({"error": "bad length"}).encode())
        u = urlparse(self.path)
        if length < 0 or length > (self.MAX_UPLOAD if u.path == "/upload" else self.MAX_JSON):
            self.close_connection = True
            return self._send(413, json.dumps({"error": "request too large"}).encode())
        if u.path == "/upload":
            data = self.rfile.read(length)
            ctype = self.headers.get("Content-Type", "")
            m = re.search(rb'boundary=(?:"([^"]+)"|([^;]+))', ctype.encode())
            if not m:
                return self._send(400, json.dumps({"error": "bad multipart"}).encode())
            boundary = b"--" + (m.group(1) or m.group(2))
            parts = data.split(boundary)
            for part in parts:
                if b'filename="' in part:
                    head, _, content = part.partition(b"\r\n\r\n")
                    content = content.removesuffix(b"\r\n")
                    fn = re.search(rb'filename="([^"]*)"', head)
                    ext = (Path(fn.group(1).decode(errors="replace")).suffix or ".png").lower()
                    if ext not in (".png", ".jpg", ".jpeg", ".webp"):
                        return self._send(400, json.dumps({"error": "unsupported image type"}).encode())
                    dst = UPLOADS / f"{uuid.uuid4().hex}{ext}"
                    dst.write_bytes(content)
                    return self._send(200, json.dumps({"path": str(dst)}).encode())
            return self._send(400, json.dumps({"error": "no file"}).encode())

        if u.path in ("/generate", "/upscale", "/refine", "/edit", "/engine"):
            try:
                body = json.loads(self.rfile.read(length) or b"{}")
                if not isinstance(body, dict):
                    raise ValueError()
            except (ValueError, TypeError):
                return self._send(400, json.dumps({"error": "Invalid request"}).encode())
            if u.path == "/engine":
                try:
                    save_engine_setting(body.get('engine'))
                except StudioError as error:
                    return self._send(error.code, json.dumps({"error": str(error)}).encode())
                return self._send(200, json.dumps(engine_info()).encode())
            try:
                if u.path == "/generate":
                    plan = plan_generation(body)
                elif u.path == "/edit":
                    plan = plan_edit(body)
                elif u.path == "/upscale":
                    plan = plan_quick_upscale(body)
                else:
                    plan = plan_refine(body)
            except StudioError as error:
                return self._send(error.code, json.dumps({"error": str(error)}).encode())
            job_id, error = start_job(plan)
            if error:
                return self._send(200, json.dumps({"error": error}).encode())
            response = {"id": job_id}
            if plan.get('estimate') is not None:
                # Uncalibrated until edit.json is calibrated; the masked crop uses its working size.
                response['estimate_seconds'] = plan['estimate']
                response['estimates_calibrated'] = edit_estimate_settings()['calibrated']
            return self._send(200, json.dumps(response).encode())

        return self._send(404, b"not found")


def plan_generation(body):
    """Validate a text-to-image / photo-edit request and build its engine step."""
    prompt = (body.get("prompt") or "").strip()
    if not prompt:
        raise StudioError("empty prompt", 200)
    model = body.get("model", "q4")
    if model in KLEIN_MODELS:
        return plan_klein_text(body)
    diffusion = MODEL_FILES.get(model)
    if diffusion is None:
        raise StudioError("Choose Q4 or Q8, or FLUX.2 klein")
    try:
        width, height = int(body.get("width", 512)), int(body.get("height", 512))
        steps = int(body.get("steps", 8))
        if not (256 <= width <= 1536 and 256 <= height <= 1536 and width % 64 == height % 64 == 0 and width * height <= 1536 * 1024 and 1 <= steps <= 50):
            raise ValueError()
    except (TypeError, ValueError):
        raise StudioError("Use dimensions 256–1536 in multiples of 64, at most 1536×1024 pixels, and 1–50 steps") from None
    variations = body.get("variations", 1)
    if type(variations) is not int or not 1 <= variations <= MAX_VARIATIONS:
        raise StudioError(f"Variations must be 1–{MAX_VARIATIONS}")
    seed = body.get("seed")
    if seed is not None:
        try:
            if isinstance(seed, bool) or int(seed) != float(seed):
                raise ValueError()
            seed = int(seed)
            if not 0 <= seed <= 2**62:
                raise ValueError()
        except (TypeError, ValueError, OverflowError):
            raise StudioError("Seed must be a whole number of 0 or more") from None
    for f in (diffusion, LLM, VAE):
        if not f.exists():
            raise StudioError(f"missing model {f.name}", 200)

    cpu = bool(body.get('cpu', True))
    tuning = runtime_tuning(model)
    fa = tuning.get('flash_attention', 'off') if cpu else 'on'
    threads = int(tuning.get('threads', 6))
    init = mask = strength = None
    if body.get("init"):
        ip = Path(body["init"])
        if ip.exists() and ip.resolve().is_relative_to(UPLOADS.resolve()):
            init = ip
            try:
                strength = edit_strength(body)
            except ValueError as error:
                raise StudioError(str(error)) from None
            if body.get("mask"):
                mp = Path(body["mask"])
                if not (mp.exists() and mp.resolve().is_relative_to(UPLOADS.resolve())):
                    raise StudioError("Upload the mask again")
                mask = mp
    gpu_profile = None
    environment = None
    if not cpu:
        try:
            gpu_profile = optimized_gpu_profile(model, width, height)
        except ValueError as error:
            raise StudioError(str(error)) from None
        if not gpu_profile:
            raise StudioError('GPU generation is paused; choose CPU.')
        environment = os.environ.copy()
        environment.update(gpu_profile.get('environment', {}))
    cpu_profile = None
    if cpu:
        try:
            # The photo-edit path keeps its original rule: no repack profile for init images.
            cpu_profile = optimized_cpu_profile(model, width, height, steps, init is not None)
        except ValueError as error:
            raise StudioError(str(error)) from None
        if cpu_profile:
            environment = os.environ.copy()
            environment['SD_CPU_REPACK_EXPERIMENT'] = '1'
    binary = cpu_profile['binary'] if cpu_profile else gpu_profile['binary'] if gpu_profile else SDCLI
    stem = f"{time.strftime('%Y%m%d-%H%M%S')}-{uuid.uuid4().hex[:6]}"
    if variations == 1:
        out = OUT / f"{stem}.png"
        outputs = [out]
        seed_arg = seed
    else:
        # sd-cli writes stem-0.png … stem-(n-1).png and uses seed+i for image i.
        out = OUT / f"{stem}-%d.png"
        outputs = [OUT / f"{stem}-{i}.png" for i in range(variations)]
        seed_arg = SDCPP_DEFAULT_SEED if seed is None else seed
    args = build_generation_args(binary, diffusion, width, height, steps, out, threads, fa, cpu,
                                 seed=seed_arg, gpu_profile=gpu_profile, cpu_profile=cpu_profile,
                                 init=init, strength=strength, mask=mask, batch=variations)
    base_seed = SDCPP_DEFAULT_SEED if seed is None else seed
    results = [{'path': str(p), 'prompt': prompt, 'seed': base_seed + i, 'model': model,
                'width': width, 'height': height, 'steps': steps,
                'kind': 'edit' if init else 'image'}
               for i, p in enumerate(outputs)]
    return {'steps': [{'args': args, 'outputs': outputs, 'label': 'generating'}],
            'environment': environment, 'prompt': prompt, 'results': results,
            'model': model, 'device': 'cpu' if cpu else 'gpu', 'scratch': []}


def chosen_image(body):
    with LOCK:
        record = IMAGES.get(body.get('image')) if isinstance(body.get('image'), str) else None
    if record is None or not Path(record['path']).is_file():
        raise StudioError('That image is no longer available here; generate it again')
    return record


def plan_quick_upscale(body):
    """ESRGAN-only enlargement of a chosen image (no diffusion pass)."""
    record = chosen_image(body)
    settings = upscale_settings()
    if settings['esrgan_path'] is None:
        raise StudioError('Quick upscale needs an ESRGAN model; see docs/STUDIO-UPSCALE.md')
    scale = settings['esrgan_scale']
    w, h = record['width'] * scale, record['height'] * scale
    if w > 4096 or h > 4096:
        raise StudioError('Image is too large for a ×%d upscale' % scale)
    source = Path(record['path'])
    out = OUT / f"{source.stem}-x{scale}.png"
    if out.exists():
        out = OUT / f"{source.stem}-x{scale}-{uuid.uuid4().hex[:6]}.png"
    threads = int(runtime_tuning(record['model']).get('threads', 6))
    args = build_upscale_args(SDCLI, settings['esrgan_path'], source, out, threads, settings['esrgan_tile_size'])
    result = dict(record, path=str(out), width=w, height=h, kind='upscale')
    return {'steps': [{'args': args, 'outputs': [out], 'label': 'ESRGAN upscale', 'prompt': False,
                       'expect_size': (w, h)}],
            'environment': None, 'prompt': None, 'results': [result],
            'model': record['model'], 'device': 'cpu', 'scratch': []}


def refine_source(record):
    """Z-Image model and step count used by refine. A klein text-to-image result refines with
    Z-Image Turbo at its 8 steps (klein's 4-step count would leave 2 sampled steps at strength 0.45)."""
    if record.get('engine') == 'klein-t2i':
        return record['model'][len('klein-'):], 8
    return record['model'], record['steps']


def plan_refine(body):
    """Enlarge a chosen image, then img2img it at the target size with its prompt and seed."""
    record = chosen_image(body)
    if record.get('engine') == 'klein':
        raise StudioError('Refine uses the Z-Image model; use Quick upscale on an edited image')
    settings = upscale_settings()
    target = body.get('target', settings['refine_target'])
    if target not in settings['refine_targets']:
        raise StudioError('Choose a refine size of ' + ' or '.join(map(str, settings['refine_targets'])))
    strength = body.get('strength', settings['refine_strength'])
    if type(strength) not in (int, float) or not 0.05 <= strength <= 0.95:
        raise StudioError('Refine strength must be between 0.05 and 0.95')
    strength = float(strength)
    try:
        width, height = refine_size(record['width'], record['height'], target)
    except ValueError as error:
        raise StudioError(str(error)) from None
    post = bool(body.get('post_upscale'))
    if post and settings['esrgan_x2_path'] is None:
        raise StudioError('ESRGAN ×2 needs a configured esrgan_x2_model')
    model, sample_steps = refine_source(record)
    diffusion = MODEL_FILES[model]
    for f in (diffusion, LLM, VAE):
        if not f.exists():
            raise StudioError(f"missing model {f.name}", 200)
    tuning = runtime_tuning(model)
    fa = tuning.get('flash_attention', 'off')
    threads = int(tuning.get('threads', 6))
    source = Path(record['path'])
    stem = f"{source.stem}-refine{target}-{uuid.uuid4().hex[:6]}"
    steps, scratch = [], []
    init = source
    if settings['esrgan_path'] is not None:
        scale = settings['esrgan_scale']
        work = OUT / '_work'
        work.mkdir(parents=True, exist_ok=True)
        init = work / f"{stem}-esrgan.png"
        scratch.append(str(init))
        steps.append({'args': build_upscale_args(SDCLI, settings['esrgan_path'], source, init, threads,
                                                 settings['esrgan_tile_size']),
                      'outputs': [init], 'label': 'ESRGAN upscale', 'prompt': False,
                      'expect_size': (record['width'] * scale, record['height'] * scale)})
    try:
        cpu_profile = optimized_cpu_profile(model, width, height, sample_steps, True)
    except ValueError as error:
        raise StudioError(str(error)) from None
    environment = None
    if cpu_profile:
        environment = os.environ.copy()
        environment['SD_CPU_REPACK_EXPERIMENT'] = '1'
    binary = cpu_profile['binary'] if cpu_profile else SDCLI
    out = OUT / f"{stem}.png"
    # Lanczos covers both cases: the plain-resize fallback (draft -> target)
    # and fitting the ESRGAN output to the target size.
    args = build_generation_args(binary, diffusion, width, height, sample_steps, out, threads, fa, True,
                                 seed=record['seed'], cpu_profile=cpu_profile, init=init,
                                 strength=strength, init_filter='lanczos')
    steps.append({'args': args, 'outputs': [out], 'label': 'refining', 'prompt': True,
                  'environment': environment, 'expect_size': (width, height)})
    final, final_w, final_h = out, width, height
    if post:
        final = OUT / f"{stem}-x2.png"
        final_w, final_h = width * 2, height * 2
        steps.append({'args': build_upscale_args(SDCLI, settings['esrgan_x2_path'], out, final, threads,
                                                 settings['esrgan_tile_size']),
                      'outputs': [final], 'label': 'ESRGAN ×2', 'prompt': False,
                      'expect_size': (final_w, final_h)})
    result = dict(record, path=str(final), width=final_w, height=final_h, kind='refine')
    return {'steps': steps, 'environment': None, 'prompt': record['prompt'], 'results': [result],
            'model': model, 'device': 'cpu', 'scratch': scratch}


