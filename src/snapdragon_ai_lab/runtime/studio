def edit_work_size(width, height, long_edge):
    """Working size: long edge `long_edge`, aspect kept, both sides a multiple of 16 (FLUX.2 latent grid)."""
    scale = long_edge / max(width, height)
    w = max(64, int(round(width * scale / 16)) * 16)
    h = max(64, int(round(height * scale / 16)) * 16)
    return w, h


def jpeg_size(path):
    """(width, height) from a JPEG's SOF marker, or None."""
    try:
        data = Path(path).read_bytes()[:1 << 20]
    except OSError:
        return None
    if data[:2] != b'\xff\xd8':
        return None
    i = 2
    while i + 9 < len(data):
        if data[i] != 0xFF:
            i += 1
            continue
        marker = data[i + 1]
        if marker in (0xD8, 0x01) or 0xD0 <= marker <= 0xD7 or marker == 0xFF:
            i += 1 if marker == 0xFF else 2
            continue
        if 0xC0 <= marker <= 0xCF and marker not in (0xC4, 0xC8, 0xCC):
            h, w = struct.unpack('>HH', data[i + 5:i + 9])
            return (w, h)
        i += 2 + struct.unpack('>H', data[i + 2:i + 4])[0]
    return None


def image_size(path):
    return png_size(path) or jpeg_size(path)


# Minimal PNG codec (8/16-bit, non-interlaced) so the mask composite needs no
# third-party package. Pixels are flat bytearrays: RGB (3 channels) or gray (1).
def read_png(path, gray=False):
    data = Path(path).read_bytes()
    if data[:8] != b'\x89PNG\r\n\x1a\n':
        raise ValueError('The mask composite needs PNG images (convert JPEG to PNG first)')
    pos, idat, palette, header = 8, [], None, None
    while pos + 8 <= len(data):
        length, kind = struct.unpack('>I4s', data[pos:pos + 8])
        body = data[pos + 8:pos + 8 + length]
        pos += 12 + length
        if kind == b'IHDR':
            header = struct.unpack('>IIBBBBB', body)
        elif kind == b'PLTE':
            palette = body
        elif kind == b'IDAT':
            idat.append(body)
        elif kind == b'IEND':
            break
    if header is None or not idat:
        raise ValueError('Unreadable PNG')
    width, height, depth, ctype, _, _, interlace = header
    if interlace or depth not in (8, 16) or ctype not in (0, 2, 3, 4, 6) or (ctype == 3 and (depth != 8 or palette is None)):
        raise ValueError('Unsupported PNG (use 8-bit, non-interlaced)')
    channels = {0: 1, 2: 3, 3: 1, 4: 2, 6: 4}[ctype]
    step = channels * depth // 8
    stride = width * step
    raw = zlib.decompress(b''.join(idat))
    if len(raw) < (stride + 1) * height:
        raise ValueError('Truncated PNG')
    pixels = bytearray()
    previous = bytearray(stride)
    for y in range(height):
        base = y * (stride + 1)
        mode = raw[base]
        row = bytearray(raw[base + 1:base + 1 + stride])
        if mode == 1:
            for i in range(step, stride):
                row[i] = (row[i] + row[i - step]) & 255
        elif mode == 2:
            row = bytearray((a + b) & 255 for a, b in zip(row, previous))
        elif mode == 3:
            for i in range(stride):
                left = row[i - step] if i >= step else 0
                row[i] = (row[i] + ((left + previous[i]) >> 1)) & 255
        elif mode == 4:
            for i in range(stride):
                a = row[i - step] if i >= step else 0
                b, c = previous[i], (previous[i - step] if i >= step else 0)
                p = a + b - c
                pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
                row[i] = (row[i] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
        elif mode != 0:
            raise ValueError('Corrupt PNG filter')
        previous = row
        if depth == 16:
            row = row[0::2]
        out = row
        if ctype == 3:
            out = bytearray()
            for index in row:
                out += palette[index * 3:index * 3 + 3]
            channels_now = 3
        else:
            channels_now = channels
        if channels_now == 1 and not gray:
            out = bytearray(v for v in out for _ in range(3))
        elif channels_now == 2:
            out = bytearray(out[0::2]) if gray else bytearray(v for v in out[0::2] for _ in range(3))
        elif channels_now == 3 and gray:
            out = bytearray((299 * r + 587 * g + 114 * b) // 1000 for r, g, b in zip(out[0::3], out[1::3], out[2::3]))
        elif channels_now == 4:
            rgb = bytearray()
            for i in range(0, len(out), 4):
                rgb += out[i:i + 3]
            out = bytearray((299 * r + 587 * g + 114 * b) // 1000 for r, g, b in zip(rgb[0::3], rgb[1::3], rgb[2::3])) if gray else rgb
        pixels += out
    return width, height, pixels


def write_png(path, width, height, rgb):
    def chunk(kind, body):
        return struct.pack('>I', len(body)) + kind + body + struct.pack('>I', zlib.crc32(kind + body))
    stride = width * 3
    raw = b''.join(b'\x00' + bytes(rgb[y * stride:(y + 1) * stride]) for y in range(height))
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    Path(path).write_bytes(b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', width, height, 8, 2, 0, 0, 0))
                           + chunk(b'IDAT', zlib.compress(raw, 6)) + chunk(b'IEND', b''))


def _taps(source, target):
    scale = source / target
    support = max(scale, 1.0)
    taps = []
    for i in range(target):
        center = (i + 0.5) * scale
        lo, hi = max(int(center - support), 0), min(int(center + support) + 1, source)
        weights = [max(0.0, 1 - abs((j + 0.5 - center) / support)) for j in range(lo, hi)]
        total = sum(weights) or 1.0
        taps.append((lo, [w / total for w in weights]))
    return taps


def resize_pixels(pixels, width, height, new_width, new_height, channels):
    """Separable triangle-filter resize (area-aware when shrinking)."""
    if (width, height) == (new_width, new_height):
        return bytearray(pixels)
    stride = width * channels
    xt = _taps(width, new_width)
    rows = []
    for y in range(height):
        row = pixels[y * stride:(y + 1) * stride]
        out = [0.0] * (new_width * channels)
        for c in range(channels):
            plane = row[c::channels]
            out[c::channels] = [sum(plane[lo + k] * w for k, w in enumerate(ws)) for lo, ws in xt]
        rows.append(out)
    result = bytearray()
    for lo, ws in _taps(height, new_height):
        acc = [0.0] * (new_width * channels)
        for k, w in enumerate(ws):
            acc = [a + w * v for a, v in zip(acc, rows[lo + k])]
        result += bytes(min(255, max(0, int(v + 0.5))) for v in acc)
    return result


def _ceil16(value):
    return int(math.ceil(value / 16)) * 16


def _floor16(value):
    return int(math.floor(value / 16)) * 16


def mask_bounding_box(gray, width, height):
    """(x0, y0, x1, y1) with exclusive ends around the pixels > 0 of a flat gray mask, or None."""
    x0 = y0 = x1 = y1 = None
    for y in range(height):
        row = gray[y * width:(y + 1) * width]
        if not any(row):
            continue
        left = len(row) - len(row.lstrip(b'\x00'))
        right = len(row.rstrip(b'\x00'))
        x0 = left if x0 is None else min(x0, left)
        x1 = right if x1 is None else max(x1, right)
        if y0 is None:
            y0 = y
        y1 = y + 1
    if y0 is None:
        return None
    return x0, y0, x1, y1


def _grow_axis(start, end, image_len):
    """Grow [start, end) to a multiple of 16 inside [0, image_len), centred, shifting to fit.

    If the rounded-up length is longer than the image, round down to the largest multiple
    that fits; if the span itself does not fit, that is refused.
    """
    length = end - start
    target = _ceil16(length)
    if target > image_len:
        target = _floor16(image_len)
        if target < length:
            raise ValueError('The masked area cannot be cropped to a 16-pixel multiple inside this photo')
    new_start = max(0, min(start - (target - length) // 2, image_len - target))
    return new_start, new_start + target


def _fit_short(start, end, image_len, scale):
    """Native span for the short axis so that its scaled length is a multiple of 16.

    Returns (new_start, new_end, work_length). When the image is too short to grow to that
    span, the whole axis is used and its work length rounded down (aspect changes slightly).
    """
    length = end - start
    work = _ceil16(length * scale)
    need = int(math.ceil(work / scale))
    if need > image_len:
        need = image_len
        work = max(16, _floor16(image_len * scale))
    new_start = max(0, min(start - (need - length) // 2, image_len - need))
    return new_start, new_start + need, work


MIN_CROP_SIDE = 256              # smallest crop side handed to klein (a 16x16-token latent)


def _widen_axis(start, end, image_len, minimum):
    """Widen [start, end) to at least `minimum`, centred and shifted to fit inside the image.

    The widened span is capped at the largest multiple of 16 inside the image: a whole axis of
    200 px cannot become a 16-multiple, so it would be refused. A span already longer than the
    cap is left alone so that _grow_axis decides.
    """
    length = end - start
    cap = image_len if image_len % 16 == 0 else _floor16(image_len)
    target = max(length, min(minimum, cap))
    new_start = max(0, min(start - (target - length) // 2, image_len - target))
    return new_start, new_start + target


def crop_box_for_mask(mask_bbox, image_w, image_h, work_size):
    """Crop geometry for crop-edit-paste: returns (x0, y0, x1, y1, work_w, work_h).

    mask_bbox is (x0, y0, x1, y1) with exclusive ends. The box is padded by 25% of its larger
    side (at least 32 px) and clamped to the image. If the padded long edge fits work_size, the
    crop is edited 1:1 with both sides rounded up to multiples of 16 (grown inside the image).
    Otherwise the crop is scaled so its long edge equals work_size, and the short side is chosen
    so its scaled length is a multiple of 16. Raises ValueError when no crop can hold the box.
    """
    bx0, by0, bx1, by1 = mask_bbox
    if not (0 <= bx0 < bx1 <= image_w and 0 <= by0 < by1 <= image_h):
        raise ValueError('The masked area lies outside the photo')
    if work_size <= 0 or work_size % 16:
        raise ValueError('Crop work size must be a multiple of 16')
    pad = max(32, -(-max(bx1 - bx0, by1 - by0) // 4))
    x0, x1 = max(0, bx0 - pad), min(image_w, bx1 + pad)
    y0, y1 = max(0, by0 - pad), min(image_h, by1 + pad)
    # klein needs some picture to work with: never hand it less than MIN_CROP_SIDE per side
    # (or the whole axis when the photo is smaller than that).
    x0, x1 = _widen_axis(x0, x1, image_w, min(MIN_CROP_SIDE, work_size))
    y0, y1 = _widen_axis(y0, y1, image_h, min(MIN_CROP_SIDE, work_size))
    if max(x1 - x0, y1 - y0) <= work_size:
        x0, x1 = _grow_axis(x0, x1, image_w)
        y0, y1 = _grow_axis(y0, y1, image_h)
        return x0, y0, x1, y1, x1 - x0, y1 - y0
    scale = work_size / max(x1 - x0, y1 - y0)
    if x1 - x0 >= y1 - y0:
        y0, y1, short = _fit_short(y0, y1, image_h, scale)
        return x0, y0, x1, y1, work_size, short
    x0, x1, short = _fit_short(x0, x1, image_w, scale)
    return x0, y0, x1, y1, short, work_size


def crop_pixels(buffer, full_width, x0, y0, width, height, channels):
    """Rectangle of a flat buffer (channels per pixel) as a new flat buffer."""
    stride = full_width * channels
    span = width * channels
    out = bytearray()
    for row in range(height):
        base = (y0 + row) * stride + x0 * channels
        out += buffer[base:base + span]
    return out


def box_blur(values, width, height, radius):
    """Separable box blur of a flat gray buffer with clamped edges (radius 0 copies)."""
    if radius <= 0:
        return bytearray(values)
    size = 2 * radius + 1

    def blur_line(line):
        padded = [line[0]] * radius + list(line) + [line[-1]] * radius
        prefix = [0]
        for v in padded:
            prefix.append(prefix[-1] + v)
        return [(prefix[i + size] - prefix[i] + size // 2) // size for i in range(len(line))]

    horizontal = bytearray()
    for y in range(height):
        horizontal += bytes(blur_line(values[y * width:(y + 1) * width]))
    out = bytearray(width * height)
    for x in range(width):
        out[x::width] = bytes(blur_line(horizontal[x::width]))
    return out


def composite_crop(base_rgb, full_width, full_height, box, mask_gray, raw_png, work_size, final_png):
    """Paste the edited crop into the native photo through the feathered native mask.

    Pixels whose feathered alpha is 0 are copied from base_rgb unchanged.
    """
    x0, y0, cw, ch = box
    w, h, edited = read_png(raw_png)
    if (w, h) != tuple(work_size):
        raise ValueError('Edited image has an unexpected size')
    if (w, h) != (cw, ch):
        edited = resize_pixels(edited, w, h, cw, ch, 3)
    crop_mask = crop_pixels(mask_gray, full_width, x0, y0, cw, ch, 1)
    alpha = box_blur(crop_mask, cw, ch, max(2, max(cw, ch) // 128))
    out = bytearray(base_rgb)
    for row in range(ch):
        line = alpha[row * cw:(row + 1) * cw]
        if not any(line):
            continue
        start = ((y0 + row) * full_width + x0) * 3
        out[start:start + cw * 3] = composite_masked(out[start:start + cw * 3],
                                                    edited[row * cw * 3:(row + 1) * cw * 3], line)
    write_png(final_png, full_width, full_height, out)


def composite_masked(base, edited, mask):
    """Blend edited over base by mask (255 = edited, 0 = base). Equal-sized flat buffers."""
    out = bytearray(base)
    for i, a in enumerate(mask):
        if a == 255:
            out[i * 3:i * 3 + 3] = edited[i * 3:i * 3 + 3]
        elif a:
            for c in range(3):
                j = i * 3 + c
                out[j] = (base[j] * (255 - a) + edited[j] * a + 127) // 255
    return out


def prepare_edit_inputs(source, mask, work_size, ref_out):
    """Write the working-size reference PNG the engine and the composite both use."""
    width, height, rgb = read_png(source)
    if width * height > MAX_MASK_PIXELS:
        raise ValueError('Masked edits take images up to about 4 megapixels; downscale it first')
    ref = resize_pixels(rgb, width, height, work_size[0], work_size[1], 3)
    write_png(ref_out, work_size[0], work_size[1], ref)
    mw, mh, mgray = read_png(mask, gray=True)
    return ref, resize_pixels(mgray, mw, mh, work_size[0], work_size[1], 1)


def composite_files(ref, mask_gray, raw_png, final_png, size):
    w, h, edited = read_png(raw_png)
    if (w, h) != tuple(size):
        raise ValueError('Edited image has an unexpected size')
    write_png(final_png, w, h, composite_masked(ref, edited, mask_gray))


def build_edit_args(binary, diffusion, ref, out, width, height, steps, threads, fa='off', seed=None):
    """sd-cli FLUX.2 klein edit command (instruction is supplied separately via memfd).

    Distilled klein: 4 steps, cfg 1.0, euler (pinned docs/flux2.md). The flux2
    ref-image preset is auto-detected from the model weights; the reference is
    VAE-encoded and fed to the DiT, the Qwen3 encoder sees text only.
    """
    args = [str(binary), "--diffusion-model", str(diffusion), "--llm", str(KLEIN_LLM), "--vae", str(KLEIN_VAE),
            "-r", str(ref), "--cfg-scale", "1.0", "--sampling-method", "euler", "--steps", str(steps),
            "-W", str(width), "-H", str(height), "-o", str(out), "--threads", str(threads),
            "--flash-attn", "off,diffusion=" + fa, "--vae-tiling", "--vae-tile-size", "512",
            "--disable-image-metadata", "--backend", "cpu"]
    if seed is not None:
        args += ["--seed", str(int(seed))]
    return args


def build_klein_t2i_args(binary, diffusion, width, height, out, threads, fa='off', seed=None, batch=1):
    """sd-cli FLUX.2 klein text-to-image: build_edit_args without the reference image (-r).

    Same distilled settings (4 steps, cfg 1.0, euler). The prompt is supplied separately via memfd.
    """
    args = [str(binary), "--diffusion-model", str(diffusion), "--llm", str(KLEIN_LLM), "--vae", str(KLEIN_VAE),
            "--cfg-scale", "1.0", "--sampling-method", "euler", "--steps", str(EDIT_STEPS),
            "-W", str(width), "-H", str(height), "-o", str(out), "--threads", str(threads),
            "--flash-attn", "off,diffusion=" + fa, "--vae-tiling", "--vae-tile-size", "512",
            "--disable-image-metadata", "--backend", "cpu"]
    if seed is not None:
        args += ["--seed", str(int(seed))]
    if batch > 1:
        args += ["-b", str(batch)]
    return args


def plan_klein_text(body):
    """FLUX.2 klein 4B text-to-image from the Generate flow (base sd-cli, 4 steps, no photo)."""
    prompt = body.get("prompt")
    prompt = prompt.strip() if isinstance(prompt, str) else ""
    if not prompt:
        raise StudioError("empty prompt", 200)
    model = body.get("model")
    if model not in KLEIN_MODELS:
        raise StudioError("Choose FLUX.2 klein Q8 or Q4")
    variant = model[len('klein-'):]
    width, height = body.get("width", 512), body.get("height", 512)
    if not all(type(v) is int and KLEIN_T2I_SIZE_MIN <= v <= KLEIN_T2I_SIZE_MAX and v % 16 == 0 for v in (width, height)):
        raise StudioError("FLUX.2 klein sizes are multiples of 16 from 256 to 1024")
    # The step count is fixed at 4 for the distilled model; a client-sent value is ignored.
    variations = body.get("variations", 1)
    if type(variations) is not int or not 1 <= variations <= MAX_VARIATIONS:
        raise StudioError(f"Variations must be 1–{MAX_VARIATIONS}")
    seed = body.get("seed")
    if seed is not None:
        try:
            if isinstance(seed, bool) or int(seed) != float(seed):
                raise ValueError()
            seed = int(seed)
            if not 0 <= seed <= 2**62:
                raise ValueError()
        except (TypeError, ValueError, OverflowError):
            raise StudioError("Seed must be a whole number of 0 or more") from None
    if body.get("init"):
        raise StudioError("FLUX.2 klein text-to-image does not take a photo; use the Edit panel for photos")
    if not bool(body.get("cpu", True)):
        raise StudioError("FLUX.2 klein runs on CPU only; keep CPU selected")
    missing = edit_missing_files(variant)
    if missing:
        raise StudioError('Missing klein model files: ' + ', '.join(missing) + ' (see docs/STUDIO-EDIT.md)', 200)
    tuning = runtime_tuning(model)
    threads = int(tuning.get('threads', 6))
    fa = tuning.get('flash_attention', 'off')
    stem = f"{time.strftime('%Y%m%d-%H%M%S')}-{uuid.uuid4().hex[:6]}"
    base_seed = SDCPP_DEFAULT_SEED if seed is None else seed
    if variations == 1:
        out = OUT / f"{stem}.png"
        outputs = [out]
        seed_arg = seed
    else:
        out = OUT / f"{stem}-%d.png"
        outputs = [OUT / f"{stem}-{i}.png" for i in range(variations)]
        seed_arg = base_seed
    args = build_klein_t2i_args(SDCLI, KLEIN_FILES[variant], width, height, out, threads, fa,
                                seed=seed_arg, batch=variations)
    results = [{'path': str(p), 'prompt': prompt, 'seed': base_seed + i, 'model': model,
                'width': width, 'height': height, 'steps': EDIT_STEPS, 'kind': 'image', 'engine': 'klein-t2i',
                'backend': 'sd.cpp'}
               for i, p in enumerate(outputs)]
    plan = {'steps': [{'args': args, 'outputs': outputs, 'label': 'generating', 'prompt': True}],
            'environment': None, 'prompt': prompt, 'results': results,
            'model': model, 'device': 'cpu', 'scratch': []}
    setting = engine_setting()
    engine, reason = choose_t2i_engine(setting, model, width, height, oxi_missing())
    plan['engine'] = {'setting': setting, 'engine': engine, 'reason': reason}
    if engine == 'oxi':
        spec = {'setting': setting, 'width': width, 'height': height, 'outputs': outputs, 'results': results,
                'seeds': [base_seed + i for i in range(variations)], 'sd_args': args, 'threads': threads, 'fa': fa}
        for record in results:
            record['backend'] = 'oxi'
        plan['steps'] = [{'run': lambda job, text: run_oxi_t2i(job, text, spec), 'outputs': outputs,
                          'label': 'generating', 'prompt': True, 'expect_size': (width, height)}]
    return plan


# ---------------------------------------------------------------------------
# IMG-SHIP (O-25): FLUX.2 klein 512 px text-to-image on oxi, the lab's Rust image engine.
# Fast path = int8 linears, chunk 32/32, f32 attention: >= 27.8 dB vs sd.cpp on seeds 42/43/44
# (runq/F-IMG-ATTN-1). oxi has no text encoder: a new prompt is encoded once by a probe sd-cli that
# is stopped right after the first model call's inputs are on disk, and oxi caches that
# conditioning. `--noise sdcpp` draws sd-cli's own initial latent, so a seed gives the same picture
# on either engine. sd-cli stays for every other size, Q4, the edit/refine/upscale flows, and (with
# the "auto" setting) any oxi failure. docs/STUDIO-OXI.md.
# ---------------------------------------------------------------------------
OXI_BIN = Path(os.environ.get('OXI_BIN', str(STACK / 'releases/oxi/oxi')))
SD_PROBE_CLI = Path(os.environ.get('SD_CLI_PROBE', str(STACK / 'releases/sd-probe/sd-cli')))
OXI_COND_CACHE = Path(os.environ.get('OXI_COND_CACHE', str(STACK / 'cache/oxi-cond')))
OXI_WORK = Path(os.environ.get('OXI_WORK', str(STACK / 'cache/oxi-handover')))
OXI_COND_KEEP = 16                       # cached prompt conditionings (~17 MB each at 512 px)
OXI_SIZES = ((512, 512),)                # the size the fast path passed its quality gate at
OXI_MODELS = ('klein-q8',)               # the gate ran on the Q8 GGUF only
OXI_FAST_ARGS = ('--backend', 'fast', '--chunk1', '32', '--chunk2', '32', '--attn-prec', 'f32',
                 '--noise', 'sdcpp', '--sigmas', 'stored')
# VAE arithmetic (`oxi --vae-conv`): f32 is the gated default. winograd / int8 only after their own
# image-gate ticket (runq/VAE-1); set with runtime-settings.json {"oxi": {"vae_conv": ...}}, and
# removing the key is the rollback.
OXI_VAE_CONVS = ('f32', 'winograd', 'int8')
OXI_DEFAULT_VAE_CONV = 'f32'
OXI_NO_CONDITIONING = 3                  # `oxi generate --cond-prompt-file`: nothing cached for this prompt
OXI_DEFAULT_THREADS = 12
HANDOVER_TAGS = ('dump.flux.txt', 'dump.pe', 'dump.flux.img', 'dump.flux.timesteps')
ENGINE_CHOICES = ('auto', 'oxi', 'sdcpp')
ENGINE_LABELS = {'auto': 'auto: oxi at 512 × 512, sd.cpp otherwise or if oxi fails',
                 'oxi': 'oxi: 512 × 512 on oxi, no fallback when oxi fails (other sizes still sd.cpp)',
                 'sdcpp': 'sd.cpp: every size on sd-cli (slower)'}
# UNMEASURED PLACEHOLDERS until runq/IMG-SHIP-1 (sd.cpp 512 px was ~86 s in G6 030; oxi image 42 s
# in F-IMG-ATTN-1 plus a ~7 s prompt hand-over on a new prompt).
OXI_ESTIMATE = {'calibrated': False, 'handover_s': 8.0, 'image_s': 43.0}


class OxiFailure(Exception):
    pass


class OxiNpuFallback(OxiFailure):
    """Worker confirmed native teardown; retry on the qualified CPU path."""


class OxiNpuRecovery(OxiFailure):
    """No further compute until native process/device cleanup is confirmed."""


def engine_setting():
    """The Studio engine choice for klein text-to-image: auto (default), oxi or sdcpp."""
    try:
        value = json.loads((PROJECT / 'engine.json').read_text()).get('engine')
    except (OSError, ValueError, AttributeError):
        value = None
    return value if value in ENGINE_CHOICES else 'auto'


def save_engine_setting(value):
