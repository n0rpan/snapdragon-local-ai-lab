        raise StudioError('Engine must be auto, oxi or sdcpp')
    PROJECT.mkdir(parents=True, exist_ok=True)
    tmp = PROJECT / f'.engine.json.{os.getpid()}.tmp'
    tmp.write_text(json.dumps({'engine': value}) + '\n')
    os.replace(tmp, PROJECT / 'engine.json')
