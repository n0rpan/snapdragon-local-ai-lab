def register_image(record):
    """Remember a finished image server-side; the prompt never leaves this process."""
    image_id = uuid.uuid4().hex
    with LOCK:
        IMAGES[image_id] = record
        while len(IMAGES) > IMAGE_RECORD_LIMIT:
            IMAGES.pop(next(iter(IMAGES)))
    return image_id


def action_estimates(record, settings=None):
    """Per-image action availability and estimated seconds for the UI."""
    settings = settings or upscale_settings()
    w, h = record['width'], record['height']
    result = {'upscale': None, 'refine': {}, 'post_upscale': settings['esrgan_x2_path'] is not None}
    scale = settings['esrgan_scale']
    if settings['esrgan_path'] is not None and w * scale <= 4096 and h * scale <= 4096:
        result['upscale'] = estimate_seconds(settings, 'esrgan', input_size=(w, h), scale=scale)
    for target in ([] if record.get('engine') == 'klein' else settings['refine_targets']):
        try:
            tw, th = refine_size(w, h, target)
        except ValueError:
            continue
        refine_model, refine_steps = refine_source(record)
        try:
            optimized = optimized_cpu_profile(refine_model, tw, th, refine_steps, True) is not None
        except ValueError:
            optimized = False
        seconds = estimate_seconds(settings, 'img2img', refine_model, tw, th, refine_steps,
                                   settings['refine_strength'], optimized=optimized)
        if settings['esrgan_path'] is not None:
            seconds += estimate_seconds(settings, 'esrgan', input_size=(w, h), scale=scale)
        result['refine'][str(target)] = round(seconds, 1)
    return result


