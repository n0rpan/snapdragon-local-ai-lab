# Time-estimate constants for klein edit. UNMEASURED PLACEHOLDERS for Codex to
# calibrate. Derived from the Z-Image q8 fit by parameter ratio (4B/6B), a
# doubled token count (reference + target in one sequence) and 4 steps.
EDIT_ESTIMATE_DEFAULTS = {
    'calibrated': False,
    'fixed_s': 30.0,            # model load + text encode (two GGUFs), a guess
    's_per_mpx_step': 80.0,     # 59.9 * (4/6) * 2
    'pixel_exponent': 1.5,
    'vae_encode_s_per_mpx': 10.0,
    'composite_s_per_mpx': 3.0,
}


def edit_estimate_settings():
    estimate = dict(EDIT_ESTIMATE_DEFAULTS)
    try:
        configured = json.loads((PROJECT / 'edit.json').read_text()).get('estimate', {})
    except (OSError, ValueError, AttributeError):
        configured = {}
    if isinstance(configured, dict):
        for key, value in configured.items():
            if key == 'calibrated' and isinstance(value, bool):
                estimate[key] = value
            elif key in estimate and key != 'calibrated' and type(value) in (int, float) and 0 <= value <= 10000:
                estimate[key] = float(value)
    return estimate


def edit_estimate_seconds(width, height, steps=EDIT_STEPS, masked=False, t2i=False, count=1):
    """Edit (two sequences: reference + target, VAE-encode of the reference) or, with t2i,
    text-to-image (one sequence, no VAE-encode term). Uncalibrated until edit.json says otherwise."""
    e = edit_estimate_settings()
    mpx = width * height / 1e6
    sampling = e['s_per_mpx_step'] * mpx ** e['pixel_exponent'] * steps
    if t2i:
        sampling *= 0.5
        seconds = e['fixed_s'] + count * sampling
    else:
        seconds = e['fixed_s'] + sampling + e['vae_encode_s_per_mpx'] * mpx
    if masked:
        seconds += e['composite_s_per_mpx'] * mpx
    return round(seconds, 1)


def edit_missing_files(model='q8'):
    return [f.name for f in (KLEIN_FILES[model], KLEIN_LLM, KLEIN_VAE) if not f.is_file()]


def klein_info():
    """FLUX.2 klein text-to-image readiness (files present) and estimates for the Generate flow."""
    ready = {f'klein-{key}': not edit_missing_files(key) for key in KLEIN_FILES}
    calibrated = edit_estimate_settings()['calibrated']
    return {'ready': any(ready.values()), 'models': ready, 'steps': EDIT_STEPS,
            'sizes': [KLEIN_T2I_SIZE_MIN, KLEIN_T2I_SIZE_MAX],
            'estimates': {str(size): edit_estimate_seconds(size, size, t2i=True) for size in (512, 768, 1024)},
            'estimate_label': 'estimate' if calibrated else 'uncalibrated estimate',
            'estimates_calibrated': calibrated}


def edit_info():
