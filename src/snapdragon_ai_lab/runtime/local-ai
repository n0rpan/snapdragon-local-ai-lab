def ledger_lines(path):
    """Complete lines from the last 512 KiB of one file; symlinks and non-regular files are refused."""
    if os.path.islink(path): return []
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        return []
    with os.fdopen(fd, 'rb') as handle:
        info = os.fstat(handle.fileno())
        if not stat.S_ISREG(info.st_mode): return []
        start = max(0, info.st_size - LEDGER_TAIL_BYTES)
        handle.seek(start)
        data = handle.read(LEDGER_TAIL_BYTES)
    if start:
        cut = data.find(b'\n')
        data = data[cut + 1:] if cut >= 0 else b''
    return data.decode('utf-8', 'replace').splitlines()


def ledger_row(line):
    """Only completions requests; numbers and allowlisted labels, never prompt or reply text."""
    if not isinstance(line, dict): return None
    path = line.get('path')
    if not isinstance(path, str) or not (path.endswith('/completions') or path == '/completion'): return None
    harness = line.get('harness')
    if not (isinstance(harness, str) and HARNESS_NAME.fullmatch(harness)):
        client = line.get('client')
        harness = client.split('/', 1)[0] if isinstance(client, str) else None
        if not (isinstance(harness, str) and HARNESS_NAME.fullmatch(harness)): harness = None
    model = line.get('model')
    finish = line.get('finish_reason')
    stream = line.get('stream')
    # Cache facts are optional: a row carries them only when the engine or the miss classifier wrote them.
    cache = {}
    for key, allowed in (('cache_src', ENGINE_CACHE_SOURCES), ('resume_src', RESUME_SOURCES), ('preload_src', {'disk'}),
                         ('miss_class', MISS_CLASSES)):
        if isinstance(line.get(key), str) and line[key] in allowed: cache[key] = line[key]
    # v0.1.3: the context mode of the model (lane C) and the request's REAL-1 origin, for the panel
    for key, allowed in (('mode', CONTEXT_MODES), ('origin', ('organic', 'lab', 'remote'))):
        if isinstance(line.get(key), str) and line[key] in allowed: cache[key] = line[key]
    for key in ('echo_tokens', 'miss_tokens', 'resume_ms', 'preload_ms'):
        if number(line.get(key), 0, 1e18) is not None: cache[key] = line[key]
    return dict(cache, t=number(line.get('t'), 0, 1e18), model=ALIAS_KEYS.get(model) if isinstance(model, str) else None,
        harness=harness, status=number(line.get('status'), 0, 1e18), stream=stream if type(stream) is bool else None,
        queue_wait_ms=number(line.get('queue_wait_ms'), 0, 1e18), admit_ms=number(line.get('admit_ms'), 0, 1e18),
        ttfb_ms=number(line.get('ttfb_ms'), 0, 1e18), wall_ms=number(line.get('wall_ms'), 0, 1e18),
        cache_n=number(line.get('cache_n'), 0, 1e18), prompt_n=number(line.get('prompt_n'), 0, 1e18),
        prompt_ms=number(line.get('prompt_ms'), 0, 1e18), predicted_n=number(line.get('predicted_n'), 0, 1e18),
        predicted_ms=number(line.get('predicted_ms'), 0, 1e18),
        finish=finish if finish in ('stop', 'length', 'tool_calls') else None)


def ledger_rows(limit):
    """Newest first. Today's file, then yesterday's only when today's gives fewer rows than the limit."""
    limit = min(200, max(1, limit))
    directory = ledger_directory()
    if not directory.is_dir(): return dict(ledger_available=False, rows=[])
    rows, now = [], time.time()
    for stamp in (time.strftime('%Y%m%d'), time.strftime('%Y%m%d', time.localtime(now - 86400))):
        for line in reversed(ledger_lines(directory / f'requests-{stamp}.jsonl')):
            if len(rows) >= limit: break
            try:
                value = json.loads(line)
            except (ValueError, RecursionError):
                continue
            row = ledger_row(value)
            if row is not None: rows.append(row)
        if len(rows) >= limit: break
    return dict(ledger_available=True, rows=rows)


def storage_status():
    """Storage view rows; no absolute paths reach the panel."""
    status_code, chat = request(CHAT + '/_local/status', timeout=1)
    if status_code != 200 or not supports(chat, 'storage'):
        return dict(storage_available=False, entries=[])
    code, value = request(CHAT + '/_local/storage', timeout=10)
    rows = value.get('data') if code == 200 else None
    if not isinstance(rows, list) or len(rows) > 128:
        return dict(storage_available=False, entries=[])
    entries = []
    for row in rows:
        if not isinstance(row, dict) or row.get('kind') not in STORAGE_KINDS or row.get('state') not in STORAGE_STATES:
            continue
        if not isinstance(row.get('id'), str) or not STORAGE_ID.fullmatch(row['id']):
            continue
        size = row.get('bytes')
        name = row.get('name')
        entries.append(dict(id=row['id'], kind=row['kind'], state=row['state'],
            name=name if isinstance(name, str) and STORAGE_NAME.fullmatch(name) else '',
            model=row.get('model') if row.get('model') in (*MODEL_KEYS, 'other') else '',
            bytes=size if type(size) is int and 0 <= size <= 2**50 else 0,
            deletable=row.get('deletable') is True and row['state'] == 'unreferenced'))
    return dict(storage_available=True, entries=entries)


def status():
    code, chat = request(CHAT + '/_local/status', timeout=1)
    image_code, image = request(IMAGES + '/activity', timeout=1)
    state = chat.get('state') if code == 200 else 'offline'
    if state not in ('unloaded', 'ready', 'loading', 'stopping'):
        state = 'offline'
    active = chat.get('active_requests', 0)
    active = active if type(active) is int and 0 <= active <= 128 else 0
    ttl = chat.get('idle_unload_seconds', 600)
    ttl = ttl if type(ttl) in (int, float) and 1 <= ttl <= 86400 else 120
    available, total = memory_gib()
    image_state = image.get('state') if image_code == 200 else 'offline'
    if image_state not in ('idle', 'generating'):
        image_state = 'offline'
    image_model = image.get('model')
    if image_model not in ('q4', 'q8'):
        image_model = None
    flash_available = qualified_flash_offered()
    ornith_available = qualified_ornith_offered()
    aliases = {'qwen3.6-35b-a3b-local': 'moe'}
    if flash_available: aliases[FLASH_ALIAS] = 'flash'
    if ornith_available: aliases[ORNITH_ALIAS] = 'ornith'
    npu = 'experimental'
    try:
        value = json.loads(NPU_STATUS.read_text()).get('status')
        if value in ('testing', 'experimental', 'ready', 'unavailable'): npu = value
    except (OSError, ValueError): pass
    result = dict(chat_state=state, active_requests=active, idle_seconds=ttl, compute_busy=compute_busy(),
        model=aliases.get(chat.get('model')), selected_model=aliases.get(chat.get('selected_model', chat.get('model'))),
        prefix_cache_enabled=isinstance(chat.get('prefix_cache'), dict) and chat['prefix_cache'].get('enabled') is True,
        backend=chat.get('backend') if chat.get('backend') in ('cpu', 'npu', 'gpu') else 'cpu', npu_status=npu,
        image_state=image_state, image_model=image_model, available_gib=round(available, 1), flash_available=flash_available, ornith_available=ornith_available,
        execution_policy_mode=chat.get('execution_policy_mode', 'stock'))
    if total is not None and total > 0: result['total_gib'] = round(total, 1)
    if code == 200: result.update(optional_status(chat, aliases))
    if supports(chat, 'models'):
        models = model_rows()
        if models is not None: result['models'] = models
    result.update(flash_download_status(chat.get('flash_qualification') if isinstance(chat, dict) else None))
    result.update(flash_trial_status())
    return result


def invalid_flag(value):
    """True for a non-empty list of invalid setting keys or a legacy boolean true."""
    return value is True or (isinstance(value, list) and len(value) > 0)


def cache_status():
    """GET /_local/cache, allowlisted: no model keys, no paths, no session ids or times."""
    code, value = request(CHAT + '/_local/cache', timeout=2)
    if code != 200: return dict(cache_available=False)
    sessions = value.get('sessions') if isinstance(value.get('sessions'), dict) else {}
    oldest = number(sessions.get('oldest_atime'), 0, 1e12)
    return dict(cache_available=True,
        budget_bytes=number(value.get('budget_bytes'), 0, 2**50), used_bytes=number(value.get('used_bytes'), 0, 2**50),
        ttl_secs=number(value.get('ttl_secs'), 1, 10**9), default_budget_bytes=CACHE_DEFAULT_BYTES,
        # the controller sends the list of invalid keys (state_cache.settings); a legacy boolean true too
        invalid_settings=invalid_flag(value.get('invalid_settings')),
        sessions=dict(count=count(sessions, 'count'),
            oldest_age_secs=None if oldest is None else max(0, int(time.time() - oldest))))


def cache_budget_bytes(text):
    """'0' or 'off' (disk tier off), else decimal GB from 4 to 4096. None when refused."""
    if text in ('0', 'off'): return 0
    try:
        gb = float(text)
    except ValueError:
        return None
    if not math.isfinite(gb) or not CACHE_BUDGET_GB[0] <= gb <= CACHE_BUDGET_GB[1]: return None
    return round(gb * 1_000_000_000)


def cache_age(seconds):
    if seconds is None: return ''
    if seconds < 3600: return f'{max(1, seconds // 60)} min'
    if seconds < 172800: return f'{seconds // 3600} h'
    return f'{seconds // 86400} d'


def cache_text(value):
    if not value.get('cache_available'): return 'Conversation cache: the local model service does not answer.'
    budget = value.get('budget_bytes')
    budget_text = 'unknown budget' if budget is None else 'off' if budget == 0 else f'{budget / 1e9:g} GB'
    sessions = value['sessions']
    line = (f"Conversation cache: {(value.get('used_bytes') or 0) / 1e9:.2f} GB used of {budget_text}, "
            f"{sessions['count']} conversation{'' if sessions['count'] == 1 else 's'}")
    if sessions['oldest_age_secs'] is not None: line += f", oldest {cache_age(sessions['oldest_age_secs'])} old"
    if value.get('invalid_settings'): line += ' (saved budget not valid: default in use)'
    return line


def cache_main(words, as_json, session, clear_all):
    """local-ai cache: status, budget and clear over the controller's /_local/cache routes.
    Exit 0 done, 1 refused or unavailable, 2 bad arguments (nothing sent)."""
    def bad_arguments():
        print(CACHE_USAGE, file=sys.stderr)
        return 2

    def finish(code, value, done):
        if code == 200:
            print(json.dumps(value) if as_json else done)
            return 0
        message = {409: 'A request is running or a model is loading. Try again when it finishes.',
                   400: 'The engine refused that value.'}.get(code, 'The local model service is unavailable.')
        if as_json:
            print(json.dumps({'error': message}))
        else:
            print(message, file=sys.stderr)
        return 1

    if session is not None and clear_all: return bad_arguments()
    if not words:
        if session is not None or clear_all: return bad_arguments()
        if as_json:
            print(json.dumps(cache_status()))
        else:
            print(CACHE_USAGE)
        return 0
    command, rest = words[0], words[1:]
    if command == 'status' and not rest and session is None and not clear_all:
        value = cache_status()
        print(json.dumps(value) if as_json else cache_text(value))
        return 0 if value['cache_available'] else 1
    if command == 'budget' and len(rest) == 1 and session is None and not clear_all:
        budget = cache_budget_bytes(rest[0])
        if budget is None: return bad_arguments()
        code, value = request(CHAT + '/_local/cache/budget', post=True, timeout=30, payload={'bytes': budget})
        return finish(code, value, 'Cache budget: off.' if budget == 0 else f'Cache budget: {budget / 1e9:g} GB.')
    if command == 'clear' and not rest:
        if session is None:
            payload = {'scope': 'all'}
        elif CACHE_SESSION.fullmatch(session):
            payload = {'scope': 'session', 'session': session}
        else:
            return bad_arguments()
        code, value = request(CHAT + '/_local/cache/clear', post=True, timeout=30, payload=payload)
        freed = value.get('state_cache', {}).get('freed_bytes') if isinstance(value.get('state_cache'), dict) else None
        done = f'Cleared {freed / 1e9:.2f} GB of saved conversations.' if type(freed) in (int, float) else 'Cache cleared.'
        return finish(code, value, done)
    return bad_arguments()


def reason(body, fallback):
    """The controller's own error text ({'error': str} or the OpenAI shape), bounded, else fallback."""
    error = body.get('error') if isinstance(body, dict) else None
    if isinstance(error, dict):
        error = error.get('message')
    return error.strip()[:300] if isinstance(error, str) and error.strip() else fallback


def notify(message):
    # Audit S7: without a notification daemon (no notify-send) the message goes to stderr
    # instead of ending in a traceback.
    try:
        subprocess.run(['notify-send', 'Local AI', message], stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, check=False)
    except OSError:
        print('local-ai: ' + message, file=sys.stderr)


def launch(command):
    """Start a desktop launcher detached; False (with a notice) when Omarchy's command is missing."""
    try:
        subprocess.Popen(command, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        notify('This action needs the Omarchy desktop (`' + command[0] + '` was not found).')
        return False
    return True


def ensure_service(service):
    return subprocess.run(['systemctl', '--user', 'start', service], stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, check=False).returncode == 0


def action(name, entry=None, harness=None, pref=None):
    if name == 'panel':
        try:
            return subprocess.run(['omarchy-shell', PANEL_ID, 'toggle'], check=False).returncode
        except OSError:
            print('local-ai: the panel needs the Omarchy shell (omarchy-shell was not found). '
                  'Try `local-ai status`.', file=sys.stderr)
            return 1
    if name == 'flash-cache':
        if pref not in ('auto', '20', '18', '16', '14'):
            return 2
        code, _ = request(CHAT + '/_local/flash/cache', post=True, timeout=15, payload={'pref': pref})
        if code == 200: return 0
        notify('Flash cache preference is unavailable while a request runs or this profile has no preference control.')
        return 1
    if name == 'harness-prepare':
        if not isinstance(harness, str) or not HARNESS_NAME.fullmatch(harness):
            return 2
        if not ensure_service('local-ai-chat.service'):
            return 1
        code, _ = request(CHAT + '/_local/harness/prepare', post=True, timeout=300, payload={'harness': harness})
        return 0 if code == 200 else 1
    if name == 'harness-forget':
        payload = {}
        if harness is not None:
            if not isinstance(harness, str) or not HARNESS_NAME.fullmatch(harness):
                return 2
            payload = {'harness': harness}
        code, _ = request(CHAT + '/_local/harness/forget', post=True, timeout=15, payload=payload)
        return 0 if code == 200 else 1
    if name in ('chat', 'code', 'plan', 'load', 'moe', 'ornith', 'flash', 'storage-delete', 'mode') and not ensure_service('local-ai-chat.service'):
        notify('The local chat service could not start.')
        return 1
    if name == 'ornith' and not qualified_ornith_offered():
        notify('Ornith is not available as a qualified local profile.')
        return 1
    if name in ('flash', 'plan') and not qualified_flash_offered():
        notify('Flash-Next is not offered as a qualified local profile.')
        return 1
    if name == 'chat':
        return 0 if launch(['omarchy', 'launch', 'webapp', CHAT]) else 1
    if name in ('code', 'plan'):
        try:
            current=status()
        except (OSError, ValueError):
            current={}
        if name == 'plan':
            command=['omarchy','launch','terminal',sys.executable,str(Path(__file__).resolve().with_name('launch_local_plan.py'))]
        elif (current.get('selected_model') in ('moe', 'ornith')
              or (current.get('selected_model') == 'flash' and current.get('flash_available') is True)):
            command=['omarchy','launch','terminal',sys.executable,str(Path(__file__).resolve().with_name('launch_local_plan.py')),'--model',current['selected_model']]
            # V013: the model's stored context mode sets this OpenCode session's limits
            mode = (current.get('context') or {}).get('mode') if isinstance(current.get('context'), dict) else None
            if current['selected_model'] in ('moe', 'ornith') and mode in CONTEXT_MODES:
                command += ['--mode', mode]
        else:
            # A failed status/invalid selection must never silently launch a remembered
            # legacy client model. The model choice is an explicit launch contract.
            notify('The selected local model is unavailable. Choose a model in Local AI and try again.')
            return 1
        command.append(str(CODE_DIRECTORY))
        return 0 if launch(command) else 1
    if name == 'mode':
        if pref not in CONTEXT_MODES:
            return 2
        try:
            current = status()
        except (OSError, ValueError):
            current = {}
        alias = MODEL_KEYS.get(current.get('selected_model'))
        if current.get('selected_model') not in ('moe', 'ornith') or alias is None:
            notify('Context modes are for Ornith and Qwen 3.6 MoE.')
            return 1
        code, body = request(CHAT + '/_local/mode', post=True, timeout=15, payload={'model': alias, 'mode': pref})
        if code == 200: return 0
        notify(reason(body, 'That context mode is unavailable.'))
        return 1
    if name in ('moe', 'ornith', 'flash'):
        alias = {'moe':'qwen3.6-35b-a3b-local','ornith':ORNITH_ALIAS,'flash':FLASH_ALIAS}[name]
        code, body = request(CHAT + '/_local/select', post=True, timeout=15, payload={'model': alias})
        if code == 200: return 0
        notify(reason(body, 'Model selection is unavailable while a request is running.'))
        return 1
    if name == 'images':
        if not ensure_service('prompt-studio-app.service'):
            notify('The local image service could not start.')
            return 1
        code, _ = request(CHAT + '/_local/unload', post=True, timeout=15)
        if code == 409:
            notify('Chat is still answering. Image generation can start when it finishes.')
        return 0 if launch(['omarchy', 'launch', 'webapp', IMAGES]) else 1
    if name == 'storage-delete':
        if not isinstance(entry, str) or not STORAGE_ID.fullmatch(entry):
            return 2
        code, _ = request(CHAT + '/_local/storage/delete', post=True, timeout=120, payload={'id': entry})
        if code == 200: return 0
        notify('That cache is in use, referenced by a model, or a job is running; nothing was deleted.')
        return 1
    if name == 'clear-cache':
        code, _ = request(CHAT + '/_local/cache/clear', post=True, timeout=30)
        if code == 200: return 0
        notify('Prefix cache is busy or unavailable. Try again when the request finishes.')
        return 1
    if name in ('load', 'unload'):
        code, body = request(CHAT + '/_local/' + name, post=True, timeout=200 if name == 'load' else 15)
        if code == 200:
            return 0
        # S14: a 503 is also RAM, a busy port or a failed start, not only "a model is working".
        notify(reason(body, 'A model is working. Try again when it finishes.' if code in (409, 503)
            else 'The local model service is unavailable.'))
        return 1
    return 1


SHARE_USAGE = """Usage:
  local-ai share [status] [--json]      what is shared, where, and the key fingerprint
  local-ai share on [tailscale|lan]     share the OpenAI API with your devices (default: tailscale)
  local-ai share off                    loopback only again, at once
  local-ai share key [--rotate]         show the API key once; --rotate makes a new one (old stops working)"""
SHARE_MODES = ('tailscale', 'lan')


def share_module():
    """lan_share.py beside this script (source tree) or in the installed runtime directory."""
    import importlib.util
    runtime = Path(os.environ.get('LOCAL_AI_RUNTIME_DIR', str(Path(os.environ.get('XDG_DATA_HOME', str(Path.home() / '.local/share'))) / 'ai-stack/runtime')))
    for directory in (Path(__file__).resolve().parent, runtime):
        candidate = directory / 'lan_share.py'
        if candidate.is_file():
            spec = importlib.util.spec_from_file_location('local_ai_lan_share', candidate)
            module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(module)
            return module
    raise RuntimeError('lan_share.py was not found; reinstall the local AI runtime.')


def runtime_config_path():
    return Path(os.environ.get('LOCAL_LLM_CONFIG', str(
        Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config') / 'local-ai/llm/runtime.json')))


def share_text(value):
    if not value.get('enabled'):
        return 'LAN share: off (loopback only).' + (f"\n  {value['paused']}" if value.get('paused') else '')
    lines = [f"LAN share: {value.get('mode')} " + ('ON' if value.get('active') else 'requested, NOT active')]
    lines += [f"  {url}" for url in value.get('urls') or ()]
    lines.append(f"  key: {value.get('key_fingerprint') or 'none'}" + ('' if value.get('key_shown') else ' (not shown yet: local-ai share key)'))
    for name in ('error', 'warning'):
        if value.get(name): lines.append(f"  {name}: {value[name]}")
    return '\n'.join(lines)


def share_main(words, as_json, rotate):
    """local-ai share: on/off/status over the controller's loopback /_local/share route (the
    setting is saved directly when the service is offline); the key file is read here, never
    sent over HTTP. Exit 0 done, 1 refused or unavailable, 2 bad arguments."""
    command, rest = (words[0], words[1:]) if words else ('status', [])
    if rotate and command != 'key':
        print(SHARE_USAGE, file=sys.stderr); return 2
    module = share_module()
    if command == 'status' and not rest:
        code, value = request(CHAT + '/_local/share', timeout=5)
        if code != 200:
            saved = module.read_config(runtime_config_path())
            value = {**module.off_status(), 'mode': module.mode_of(saved),
                     'error': 'The local model service is offline; the saved setting applies when it starts.'}
            value['enabled'] = value['mode'] != 'off'
            if not value['enabled'] and isinstance(saved.get('lan_share_paused'), dict):
                value['paused'] = module.PAUSED
        print(json.dumps(value) if as_json else share_text(value))
        return 0 if code == 200 else 1
    if command in ('on', 'off') and len(rest) <= (1 if command == 'on' else 0):
        mode = 'off' if command == 'off' else (rest[0] if rest else 'tailscale')
        if mode not in module.MODES:
            print(SHARE_USAGE, file=sys.stderr); return 2
        code, value = request(CHAT + '/_local/share', post=True, timeout=15, payload={'mode': mode})
        if code == 0:
            pin = None
            if mode == 'lan':  # pinned to the network the machine is on now (M1)
                try:
                    network = module.discover_lan()
                except (OSError, ValueError, subprocess.SubprocessError):
                    network = None
                if network is None:
                    print('No private LAN network to share on now (an Ethernet or Wi-Fi default route with a '
                          '10/8, 172.16/12 or 192.168/16 address).', file=sys.stderr)
                    return 1
                pin = module.pin_of(network)
            try:
                module.save_mode(runtime_config_path(), mode, pin=pin)
            except (OSError, ValueError):
                print('The local model service is offline and the setting could not be saved.', file=sys.stderr)
                return 1
            print(f'Saved lan_share={mode}; it applies when the local model service starts.')
            return 0
        if code != 200:
            print(value.get('error') or 'The local model service refused the change.', file=sys.stderr)
            return 1
        print(json.dumps(value) if as_json else share_text(value))
        if mode != 'off' and not value.get('key_shown'):
            print('Run `local-ai share key` to see the API key (shown once).', file=sys.stderr)
        return 0 if mode == 'off' or value.get('active') else 1
    if command == 'key' and not rest:
        path = module.key_path(runtime_config_path())
        try:
            record, show = module.reveal_key(path, rotate=rotate)
        except (OSError, module.KeyFileError) as error:
            print(f'Share key unavailable: {error}', file=sys.stderr)
            return 1
        if not show:
            print(f"The key was already shown (fingerprint {module.fingerprint(record['key'])}). "
                  'Run `local-ai share key --rotate` for a new one; the old one then stops working.', file=sys.stderr)
            return 1
        print(record['key'])
        print(f"Fingerprint {module.fingerprint(record['key'])}. It is shown once: store it in your client now "
              '(Authorization: Bearer <key>).', file=sys.stderr)
        return 0
    print(SHARE_USAGE, file=sys.stderr)
    return 2


def main(argv=None):
    words = sys.argv[1:] if argv is None else list(argv)
    if words and words[0] in RETIRED_KEYS:
        print(RETIRED_KEYS[words[0]], file=sys.stderr)
        return 2
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', nargs='?', default='panel',
        choices=('panel', 'status', 'ledger', 'storage', 'chat', 'code', 'plan', 'images', 'load', 'unload', 'moe', 'ornith', 'flash',
                 'clear-cache', 'storage-delete', 'harness-prepare', 'harness-forget', 'flash-cache', 'cache', 'mode', 'share'))
    parser.add_argument('rest', nargs='*', help='Subcommand words for cache (status, budget GB|off, clear) and share (status, on [tailscale|lan], off, key)')
    parser.add_argument('--rotate', action='store_true', help='share key: make a new key (the old one stops working)')
    parser.add_argument('--json', action='store_true', help='Machine-readable output')
    parser.add_argument('--id', help='Storage entry id for storage-delete')
    parser.add_argument('--pref', choices=('auto', '20', '18', '16', '14'), help='Flash cache preference for flash-cache')
    parser.add_argument('--harness', help='Harness name for harness-prepare or harness-forget')
    parser.add_argument('--mode', choices=CONTEXT_MODES, help='Context mode for mode: fast, deep or max (applies to the next OpenCode session)')
    parser.add_argument('--limit', type=int, default=LEDGER_LIMIT, help='Ledger rows, 1 to 200')
    parser.add_argument('--session', help='cache clear: one conversation id')
    parser.add_argument('--all', dest='clear_all', action='store_true', help='cache clear: every saved conversation (default)')
    args = parser.parse_args(argv)
    if args.rest and args.action not in ('cache', 'share'): parser.error('unexpected arguments')
    if args.action == 'share':
        return share_main(args.rest, args.json, args.rotate)
    if args.action == 'cache':
        return cache_main(args.rest, args.json, args.session, args.clear_all)
    if args.action == 'ledger':
        value = ledger_rows(args.limit)
        print(json.dumps(value) if args.json else
            f"{len(value['rows'])} requests recorded" if value['ledger_available'] else 'No request ledger')
        return 0
    if args.action == 'storage':
        value = storage_status()
        print(json.dumps(value) if args.json else '\n'.join(
            f"{row['kind']}\t{row['state']}\t{row['bytes'] / 1024**3:.2f} GiB\t{row['name']}\t{row['id']}" for row in value['entries']))
        return 0 if value['storage_available'] else 1
    if args.action == 'status':
        value = status()
        flash = value['flash_download_state']
        suffix = '' if flash == 'absent' else f" | Flash-Next: {flash} ({100*value['flash_download_bytes']/value['flash_download_total_bytes']:.1f}%)"
        if value['flash_trial_active']:
            suffix += f" | Flash test: {value['flash_trial_kind']} ({value['flash_trial_elapsed_seconds']//60} min)"
        print(json.dumps(value) if args.json else
            f"Qwen: {value['chat_state']} | Images: {value['image_state']} | Available: {value['available_gib']:.1f} GiB" + suffix)
        # S14: still prints (the panel reads stdout), but an offline controller is not success.
        return 1 if value['chat_state'] == 'offline' else 0
    return action(args.action, args.id, args.harness, args.mode if args.action == 'mode' else args.pref)


if __name__ == '__main__':
    raise SystemExit(main())
