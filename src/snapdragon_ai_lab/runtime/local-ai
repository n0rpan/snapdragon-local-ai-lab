def parse_flash_trials(text, now_us):
    result = dict(flash_trial_active=False, flash_trial_kind='', flash_trial_elapsed_seconds=0)
    if (not isinstance(text, str) or len(text) > 8192 or type(now_us) is not int
            or not 0 < now_us < 2**63):
        return result
    found = {}
    allowed = {'Id', 'ActiveState', 'ActiveEnterTimestampMonotonic'}
    for block in text.strip().split('\n\n'):
        values = {}
        invalid = False
        for line in block.splitlines():
            key, separator, value = line.partition('=')
            if not separator or key not in allowed or key in values:
                invalid = True; break
            values[key] = value
        unit = values.get('Id')
        if invalid or set(values) != allowed or unit not in FLASH_TRIAL_UNITS or values['ActiveState'] != 'active':
            continue
        stamp = values['ActiveEnterTimestampMonotonic']
        if re.fullmatch('[0-9]{1,20}', stamp) is None:
            continue
        start = int(stamp)
        delta = now_us - start
        if not 0 < start <= now_us or not 0 <= delta <= FLASH_TRIAL_MAX_SECONDS * 1_000_000:
            continue
        # Ambiguous duplicate blocks are ignored; never let later text override.
        if unit in found:
            found[unit] = None
        else:
            found[unit] = delta // 1_000_000
    for unit, kind in FLASH_TRIAL_UNITS.items():
        elapsed = found.get(unit)
        if elapsed is not None:
            return dict(flash_trial_active=True, flash_trial_kind=kind, flash_trial_elapsed_seconds=elapsed)
    return result


def flash_trial_status():
    """One read-only fixed query; no command lines, logs, keys or model content."""
    try:
        completed = subprocess.run(['systemctl', '--user', 'show', '--no-pager',
            '--property=Id,ActiveState,ActiveEnterTimestampMonotonic', *FLASH_TRIAL_UNITS],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=1, check=False,
            encoding='ascii', errors='strict')
        if completed.returncode != 0:
            return parse_flash_trials('', 1)
        return parse_flash_trials(completed.stdout, time.monotonic_ns() // 1000)
    except (OSError, UnicodeError, subprocess.TimeoutExpired):
        return parse_flash_trials('', 1)


def metadata_json(path):
    """Bounded regular metadata files only; never open model/part files."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        with os.fdopen(fd, 'rb') as handle:
            if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode): return None
            data = handle.read(65537)
        if len(data) > 65536: return None
        value = json.loads(data)
        return value if isinstance(value, dict) else None
    except (OSError, ValueError):
        return None


def flash_worker_active():
    try:
        return subprocess.run(['systemctl', '--user', 'is-active', '--quiet', FLASH_SERVICE],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1, check=False).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def flash_download_status(qualification=None):
    """Flash weight download phase. Once every shard is verified the phase is 'ready' only when
    the controller reports the installed Flash profile qualified (M3: derived from its validation
    and receipts, model_catalog.qualification); otherwise 'weights-ready-testing'."""
    result = dict(flash_download_state='absent', flash_download_bytes=0, flash_download_total_bytes=0,
        flash_download_shards=0, flash_verified_shards=0, flash_download_active=False,
        flash_waiting_verification=False)
    manifest = metadata_json(FLASH_STATE/'manifest.json')
    if not manifest or manifest.get('repository') != 'unsloth/Qwen3.8-Flash-Next-GGUF': return result
    revision = manifest.get('revision')
    models = manifest.get('models')
    if not isinstance(revision, str) or not re.fullmatch('[0-9a-f]{40}', revision): return result
    if not isinstance(models, list) or not 1 <= len(models) <= 16: return result
    entries, ids, total = [], set(), 0
    for model in models:
        if not isinstance(model, dict): return result
        identity, sha, size = model.get('id'), model.get('sha256'), model.get('bytes')
        if not isinstance(identity, str) or not re.fullmatch('flash-next-[a-z0-9-]{1,48}', identity) or identity in ids: return result
        if not isinstance(sha, str) or not re.fullmatch('[0-9a-f]{64}', sha): return result
        if type(size) is not int or not 1 <= size <= FLASH_MAX_BYTES: return result
        ids.add(identity); total += size
        if total > FLASH_MAX_BYTES: return result
        entries.append((model, identity, sha, size))
    if type(manifest.get('total_bytes')) is not int or manifest['total_bytes'] != total: return result
    active, downloaded, verified, phases = flash_worker_active(), 0, 0, []
    for model, identity, sha, size in entries:
        marker = metadata_json(FLASH_STATE/(identity+'-verified.json')) or {}
        stamp = marker.get('verified_at')
        marker_ok = marker.get('id') == identity and marker.get('sha256') == sha and type(marker.get('bytes')) is int and marker['bytes'] == size
        marker_ok = marker_ok and type(stamp) in (int, float) and 0 < stamp <= time.time()+300 and math.isfinite(stamp)
        if marker_ok:
            try:
                name = model.get('path')
                path = Path(name) if isinstance(name, str) and len(name) <= 1024 else None
                marker_ok = bool(path and path.is_absolute() and re.fullmatch('[A-Za-z0-9_.-]{1,230}\\.gguf', path.name)
                    and path.resolve().is_relative_to(FLASH_MODELS.resolve()) and path.is_file() and path.stat().st_size == size)
            except (OSError, ValueError): marker_ok = False
        if marker_ok:
            verified += 1; downloaded += size
            continue
        state = metadata_json(FLASH_STATE/(identity+'-download.json')) or {}
        phase = state.get('state')
        allowed = ('downloading', 'downloaded; verification pending', 'waiting for verification slot', 'verifying', 'verified')
        if state.get('id') != identity or state.get('sha256') != sha or type(state.get('total_bytes')) is not int or state['total_bytes'] != size: continue
        if phase not in allowed or type(state.get('chunk_bytes')) is not int or state['chunk_bytes'] != FLASH_CHUNK_BYTES: continue
        done = state.get('done')
        if not isinstance(done, list) or len(done) > 16384: continue
        if any(type(offset) is not int or offset < 0 or offset >= size or offset % FLASH_CHUNK_BYTES for offset in done): continue
        if len(set(done)) != len(done): continue
        count = sum(min(FLASH_CHUNK_BYTES, size-offset) for offset in done)
        if type(state.get('downloaded_bytes')) is not int or state['downloaded_bytes'] != count: continue
        downloaded += count; phases.append(phase)
    if verified == len(entries): phase = 'ready' if qualification == 'qualified' else 'weights-ready-testing'
    elif not active: phase = 'paused'
    elif downloaded == total or any(p in ('verifying', 'waiting for verification slot') for p in phases): phase = 'verifying'
    else: phase = 'downloading'
    result.update(flash_download_state=phase, flash_download_bytes=downloaded, flash_download_total_bytes=total,
        flash_download_shards=len(entries), flash_verified_shards=verified, flash_download_active=active,
        flash_waiting_verification=phase == 'verifying' and 'verifying' not in phases)
    return result


def request(url, post=False, timeout=2, payload=None):
    req = urllib.request.Request(url, data=json.dumps(payload or {}).encode() if post else None,
        headers={'Content-Type': 'application/json'} if post else {})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as response:
            payload = response.read(65537)
            if len(payload) > 65536:
                raise ValueError('Oversized response')
            result = json.loads(payload)
            if not isinstance(result, dict):
                raise ValueError('Unexpected response')
            return response.status, result
    except urllib.error.HTTPError as error:
        # S14: keep the controller's reason so the notice can say what happened.
        try:
            body = json.loads(error.read(65537)[:65536])
        except (OSError, ValueError):
            body = {}
        return error.code, body if isinstance(body, dict) else {}
    except (OSError, ValueError):
        return 0, {}


def compute_busy():
    try:
        with LEASE.open('r') as lease:
            try:
                fcntl.flock(lease, fcntl.LOCK_SH | fcntl.LOCK_NB)
            except BlockingIOError:
                return True
        return False
    except FileNotFoundError:
        return False
    except OSError:
        return None


def number(value, low, high):
    return value if type(value) in (int, float) and math.isfinite(value) and low <= value <= high else None


def count(source, key):
    value = source.get(key) if source is not None else None
    return value if type(value) is int and 0 <= value <= 2**31 else 0


def memory_gib():
    """MemAvailable (clamped as before) and MemTotal in GiB from one read; total is None when unknown."""
    available, total = 0, None
    for line in MEMINFO.read_text().splitlines():
        if line.startswith('MemAvailable:'):
            available = min(1024, max(0, int(line.split()[1]) / 1024**2))
        elif line.startswith('MemTotal:'):
            try:
                total = int(line.split()[1]) / 1024**2
            except (ValueError, IndexError):
                total = None
    return available, total


def harness_rows(value):
    """Most recently used first; names and counts only, the 'other' group is dropped."""
    if not isinstance(value, dict): return None
    rows = []
    for name, info in value.items():
        if name == 'other' or not isinstance(name, str) or not HARNESS_NAME.fullmatch(name) or not isinstance(info, dict):
            continue
        raw = info.get('prefixes')
        prefixes = [p for p in raw if isinstance(p, dict)] if isinstance(raw, list) else []
        recent = max(prefixes, key=lambda p: number(p.get('last_used'), 0, 1e18) or 0, default=None)
        rows.append(dict(name=name, warm=recent is not None and recent.get('warm') is True,
            last_used=number(info.get('last_used'), 0, 1e18) or 0, tools=count(recent, 'tools'),
            cache_n=count(recent, 'last_cache_n'), prompt_n=count(recent, 'last_prompt_n'), prefixes=len(prefixes)))
    rows.sort(key=lambda row: row['last_used'], reverse=True)
    return rows[:HARNESS_LIMIT]


def supports(chat, name):
    """True only when the controller's status lists the capability.

    A controller without the route forwards an unknown GET to the loaded engine,
    so a route is never probed on the chance that it exists.
    """
    listed = chat.get('capabilities') if isinstance(chat, dict) else None
    return isinstance(listed, list) and name in listed


def flash_cache_row(value):
    """Bounded native cache facts; this standalone CLI needs no runtime-module imports."""
    if not isinstance(value, dict): return None
    result = {}
    if type(value.get('preference_control')) is bool:
        result['preference_control'] = value['preference_control']
    pref = value.get('pref')
    if pref in ('auto', '20', '18', '16', '14'): result['pref'] = pref
    tier = value.get('tier_gib')
    if type(tier) is int and tier in (20, 18, 16, 14): result['tier_gib'] = tier
    reason = value.get('reason')
    if reason in ('auto', 'preferred', 'preferred-does-not-fit', 'preferred-swap-tolerant', 'refuse'):
        result['reason'] = reason
    for key, low, high in (('margin_gib', -1024, 1024), ('desktop_floor_gib', 0, 16),
                           ('estimated_working_set_gib', 0, 128)):
        parsed = number(value.get(key), low, high)
        if parsed is not None: result[key] = parsed
    return result or None


def model_rows():
    """Chooser rows by panel key; only known keys, enums and bounded numbers."""
    code, value = request(CHAT + '/_local/models', timeout=1)
    rows = value.get('data') if code == 200 else None
    if not isinstance(rows, list): return None
    result, seen = [], set()
    for row in rows:
        if not isinstance(row, dict): continue
        alias = row.get('id')
        key = ALIAS_KEYS.get(alias) if isinstance(alias, str) else None
        if key is None and row.get('key') in tuple(MODEL_KEYS): key = row['key']
        if key is None or key in seen: continue
        seen.add(key)
        cache = flash_cache_row(row.get('flash_cache'))
        result.append(dict(**({'flash_cache': cache} if cache else {}),
            **({'memory_basis': row['memory_basis']} if row.get('memory_basis') in ('qualified_working_set', 'cache_pref_tier') else {}),
            key=key,
            engine=row.get('engine') if row.get('engine') in ENGINES else None,
            engine_status=row.get('engine_status') if row.get('engine_status') in ENGINE_STATES else None,
            memory_gib=number(row.get('memory_gib'), 0, 1024) or None,
            battery_start_percent=number(row.get('battery_start_percent'), 0, 100) or None,
            prefix=row.get('prefix') if row.get('prefix') in PREFIX_STATES else None,
            selected=row.get('selected') is True, default=row.get('default') is True,
            state=row.get('state') if row.get('state') in MODEL_STATES else None))
    return result


def optional_status(chat, aliases):
    """Controller-derived keys, each only when valid (null where null is the documented value)."""
    result = {}
    cache = flash_cache_row(chat.get('flash_cache'))
    if cache: result['flash_cache'] = cache
    queued = chat.get('queued_requests')
    if type(queued) is int and 0 <= queued <= 128: result['queued_requests'] = queued
    context = chat.get('context_size')
    if type(context) is int and 1 <= context <= 4194304: result['context_size'] = context
    if 'loaded_model' in chat:
        loaded = chat['loaded_model']
        result['loaded_model'] = aliases.get(loaded) if isinstance(loaded, str) else None
    if 'resident_bytes' in chat:
        resident = chat['resident_bytes']
        if resident is None: result['resident_gib'] = None
        elif type(resident) is int and resident > 0: result['resident_gib'] = round(resident / 1024**3, 1)
    if 'idle_unload_remaining_seconds' in chat:
        remaining = chat['idle_unload_remaining_seconds']
        if remaining is None: result['idle_remaining_seconds'] = None
        elif number(remaining, 0, 86400) is not None: result['idle_remaining_seconds'] = remaining
    pending = chat.get('stop_pending')  # S1: why an engine is still 'stopping' (controller text, bounded)
    if chat.get('state') == 'stopping' and isinstance(pending, str) and pending.strip():
        result['stop_pending'] = re.sub(r'[\x00-\x1f\x7f]+', ' ', pending).strip()[:200]
    error = chat.get('last_error')
    result['has_error'] = (isinstance(error, str) and error != '') or (isinstance(error, dict) and bool(error))
    harnesses = harness_rows(chat.get('harnesses'))
    if harnesses is not None: result['harnesses'] = harnesses
    context = context_row(chat.get('context'))
    if context is not None: result['context'] = context
    preload = preload_row(chat.get('preload'))
    if preload is not None: result['preload'] = preload
    # V013: the last failure's time and origin ('organic' or 'lab'), so the panel needs no guessing
    if 'error_at' in chat:  # only from a controller that reports them (null is the documented value)
        at = chat['error_at']
        result['error_at'] = at if type(at) is int and 0 < at < 2**40 else None
    if 'error_origin' in chat:
        origin = chat['error_origin']
        result['error_origin'] = origin if origin in ('organic', 'lab') else None
    failure = failure_row(chat.get('last_failure'), aliases)
    if failure is not None: result['last_failure'] = failure
    return result


def failure_row(value, aliases):
    """status.last_failure, allowlisted: {reason (plain text, <= 200), model (panel key), t, origin}."""
    if not isinstance(value, dict):
        return None
    reason = value.get('reason')
    reason = re.sub(r'[\x00-\x1f\x7f]+', ' ', reason).strip()[:200] if isinstance(reason, str) else ''
    t = value.get('t')
    t = t if type(t) in (int, float) and 0 < t < 2**40 else None
    if not reason and t is None:
        return None
    alias = value.get('alias')
    origin = value.get('origin')
    return dict(reason=reason, model=aliases.get(alias) if isinstance(alias, str) else None, t=t,
                origin=origin if origin in ('organic', 'lab', 'remote') else None)


CONTEXT_MODES = ('fast', 'deep', 'max')
PRELOAD_STATES = ('idle', 'running', 'done', 'cancelled', 'unavailable')
PRELOAD_SOURCES = ('disk', 'live')


def context_row(value):
    """status.context, allowlisted: {cap, mode, modes: [{id, compact_at, cap, available, reason}]}."""
    if not isinstance(value, dict):
        return None
    cap = value.get('cap')
    rows = []
    for row in value.get('modes') if isinstance(value.get('modes'), list) else []:
        if (not isinstance(row, dict) or row.get('id') not in CONTEXT_MODES or type(row.get('available')) is not bool
                or number(row.get('compact_at'), 1, 4194304) is None or number(row.get('cap'), 1, 4194304) is None):
            return None
        reason = row.get('reason')
        rows.append(dict(id=row['id'], compact_at=row['compact_at'], cap=row['cap'], available=row['available'],
                         reason=re.sub(r'[\x00-\x1f\x7f]+', ' ', reason).strip()[:80] if isinstance(reason, str) else None))
    mode = value.get('mode')
    return dict(cap=cap if type(cap) is int and 1 <= cap <= 4194304 else None,
                mode=mode if mode in CONTEXT_MODES else None, modes=rows[:len(CONTEXT_MODES)])


def preload_row(value):
    """status.preload, allowlisted: {state, src, ms, age_s}."""
    if not isinstance(value, dict) or value.get('state') not in PRELOAD_STATES:
        return None
    ms, age = value.get('ms'), value.get('age_s')
    return dict(state=value['state'], src=value.get('src') if value.get('src') in PRELOAD_SOURCES else None,
                ms=ms if number(ms, 0, 1e9) is not None else None,
                age_s=age if type(age) is int and 0 <= age <= 10**9 else None)


