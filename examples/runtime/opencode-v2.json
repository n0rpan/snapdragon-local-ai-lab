{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "local-qwen/qwen3.6-35b-a3b-local",
  "warming": false,
  "providers": {
    "local-qwen": {
      "name": "Local Qwen (offline)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8092/v1",
        "apiKey": "local-only",
        "headerTimeout": 1800000,
        "chunkTimeout": 1800000,
        "cache": {
          "warming": false
        }
      },
      "body": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      },
      "models": {
        "qwen-local": {
          "name": "Selected local Qwen (dynamic chat)",
          "type": "chat",
          "family": "qwen",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "temperature": true,
            "reasoning": {
              "supported": false
            }
          },
          "limit": {
            "context": 16384,
            "input": 12288,
            "output": 2048
          },
          "compatibility": {
            "maxTokensField": "max_tokens"
          }
        },
        "qwen3.6-35b-a3b-local": {
          "name": "Qwen3.6-35B-A3B MTP \u00b7 UD-Q4_K_M",
          "type": "chat",
          "family": "qwen",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "temperature": true,
            "reasoning": {
              "supported": false
            }
          },
          "limit": {
            "context": 16384,
            "input": 12288,
            "output": 4096
          },
          "compatibility": {
            "maxTokensField": "max_tokens"
          }
        }
      }
    }
  },
  "share": "disabled",
  "agents": {
    "title": {
      "disabled": true
    }
  }
}
