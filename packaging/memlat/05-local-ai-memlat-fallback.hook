[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = linux-omarchy
Target = linux-omarchy-headers
Target = limine

[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = boot/dtbs/*
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/modules/*/modules.builtin

[Action]
Description = Selecting stock Omarchy before kernel/DTB/bootloader changes...
When = PreTransaction
Exec = /usr/local/libexec/local-ai-memlat-boot prepare-update
AbortOnFail
